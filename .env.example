# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gamegata"

# Twitch / IGDB API (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID="your_twitch_client_id"
TWITCH_CLIENT_SECRET="your_twitch_client_secret"

# RAWG API (https://rawg.io/apidocs)
RAWG_API_KEY="your_rawg_api_key"

# IsThereAnyDeal API (https://isthereanydeal.com/dev/app/)
ITAD_API_KEY="your_itad_api_key"

# Supabase Auth (optional — enables real auth instead of mock mode)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
# SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Resend (https://resend.com) — required for sending approval emails
# RESEND_API_KEY="re_..."

# Site URL — used for magic links in approval emails
# On Vercel this is auto-detected; set explicitly if using custom domain
# NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Dev Portal (scripts/dev-gui.ts)
# DEV_PORTAL_PASSWORD="your_password"

# Next.js On-Demand Cache Revalidation (for instant game metadata updates)
# REVALIDATION_SECRET="a_long_secure_random_string"
