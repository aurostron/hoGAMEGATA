# ==============================================================================
# hoGAMEGATA — Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE FOR LOCAL DEVELOPMENT:
# You do NOT need remote database credentials to run the development server.
# When TURSO_DATABASE_URL is left empty, the application runs against local.db.
# Run `npm run setup:mock` to seed a local database with 10 sample games.
# ==============================================================================

# --- Database Layer (Turso / libSQL) ---
# Leave empty for local development (uses local.db SQLite file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_DATABASE_URL=
AUTH_DATABASE_TOKEN=

# --- Authentication (Better-Auth) ---
# Base URL of the running application
BETTER_AUTH_URL=http://localhost:4321

# Secret string used to sign session tokens (min 32 characters in production)
BETTER_AUTH_SECRET=

# --- Google OAuth (Optional in development) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email Delivery (Resend) ---
RESEND_API_KEY=

# --- Cloudflare Turnstile Bot Defense ---
# Use test sitekeys for local development:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Media & Asset Storage ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CATBOX_USERHASH=

# --- Sanity CMS (Editorial Articles) ---
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
