---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "w-4 h-4 text-white/80 group-hover:text-black transition-colors shrink-0" } = Astro.props;
const n = (name || "").toLowerCase().trim();

// Determine icon type
const isSteam = n.includes("steam") || n.includes("valve");
const isItch = n.includes("itch") || n.includes("itch.io") || n.includes("itchio");
const isGOG = n.includes("gog") || n.includes("good old games");
const isReddit = n.includes("reddit");
const isEpic = n.includes("epic") || n.includes("epicgames");
const isPlayStation = n.includes("playstation") || n.includes("psn") || n.includes("ps4") || n.includes("ps5") || n.includes("sony");
const isXbox = n.includes("xbox") || n.includes("microsoft store");
const isNintendo = n.includes("nintendo") || n.includes("switch") || n.includes("eshop");
const isHumble = n.includes("humble");
const isFanatical = n.includes("fanatical");
const isDiscord = n.includes("discord");
const isYouTube = n.includes("youtube") || n.includes("trailer") || n.includes("video");
const isBluesky = n.includes("bluesky") || n.includes("bsky");
const isWebsite = n.includes("website") || n.includes("site") || n.includes("web") || n.includes("official") || n.includes("link");
