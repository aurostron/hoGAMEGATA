---
import SciFiLogo from './SciFiLogo';
import SettingsButton from './SettingsButton';
import HeaderSearch from './HeaderSearch';
import CartButton from './CartButton';
import RandomDiceButton from './RandomDiceButton';
import { NotificationBell } from './notifications/NotificationBell';
import { EditPageButton } from './editing/EditPageButton';
import { BugReportTrigger } from './bugs/BugReportTrigger';

interface Props {
  withSearch?: boolean;
  withLink?: boolean;
  statsGames?: number;
  statsDevelopers?: number;
  statsDeals?: number;
  statsTags?: number;
  editGameData?: {
    gameId: string;
    gameTitle: string;
    gameData: any;
  };
}

const { withSearch = false, withLink = true, statsGames, statsDevelopers, statsDeals, statsTags, editGameData } = Astro.props;

const hasStats = statsGames || statsDevelopers || statsDeals || statsTags;
---
<header class="border-b border-white/10 bg-[#0d0d0f]/80 backdrop-blur-md sticky top-0 z-50 w-full h-14 sm:h-16 select-none transition-all duration-300">
  <div class="w-full h-full flex items-center justify-between max-w-[1440px] mx-auto">
    <!-- Left Section: Logo & Badge & Edit Page Button -->
    <div class="flex items-center h-full gap-3 sm:gap-4 pl-4 sm:pl-6">
      <div class="flex items-center gap-3 shrink-0">
        <SciFiLogo withLink={withLink} />
        <span class="border border-white/20 text-white px-2 py-0.5 font-mono text-[8.5px] uppercase tracking-widest bg-white/10 select-none shrink-0 rounded-full font-bold">
          Beta
        </span>
      </div>

      {editGameData && (
        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <EditPageButton
            client:load
            gameId={editGameData.gameId}
            gameTitle={editGameData.gameTitle}
            gameData={editGameData.gameData}
          />
          <BugReportTrigger client:load />
        </div>
      )}
    </div>

    <!-- Middle Section: Telemetry Stats (hidden on mobile) -->
    {hasStats && (
      <div class="hidden md:flex items-center h-full px-6 gap-6 font-mono text-[12px] tracking-wider text-white/50 select-none">
        <div class="flex items-center gap-2">
          <strong class="text-white font-extrabold tabular-nums text-[13px]">{statsGames?.toLocaleString() ?? "—"}</strong>
          <span class="text-white/70 lowercase">games</span>
        </div>
        <span class="text-white/15">/</span>
        <div class="flex items-center gap-2">
          <strong class="text-white font-extrabold tabular-nums text-[13px]">{statsDevelopers?.toLocaleString() ?? "—"}</strong>
          <span class="text-white/70 lowercase">developers</span>
        </div>
        <span class="text-white/15">/</span>
        <div class="flex items-center gap-2">
          <strong class="text-white font-extrabold tabular-nums text-[13px]">{statsDeals?.toLocaleString() ?? "—"}</strong>
          <span class="text-white/70 lowercase">deals</span>
        </div>
        <span class="text-white/15">/</span>
        <div class="flex items-center gap-2">
          <strong class="text-white font-extrabold tabular-nums text-[13px]">{statsTags?.toLocaleString() ?? "—"}</strong>
          <span class="text-white/70 lowercase">tags</span>
        </div>
      </div>
    )}

    <!-- Right Section: Actions -->
    <div class="flex items-center h-full gap-1.5 sm:gap-2 pr-2 sm:pr-4">
      <div class="h-full flex items-center justify-center transition-all duration-300">
        <HeaderSearch client:only="react" />
      </div>

      <div class="flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11">
        <RandomDiceButton client:only="react">
          <div slot="fallback" class="flex items-center justify-center text-white/70 hover:text-white transition-all duration-150 w-full h-full rounded-xl cursor-pointer bg-transparent">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 sm:w-5.5 sm:h-5.5 text-white/80"><rect width="12" height="12" x="2" y="10" rx="2" ry="2"/><path d="m17.92 14 3.5-3.5a2.24 2.24 0 0 0 0-3.16l-4.76-4.76a2.24 2.24 0 0 0-3.16 0L10 6.08"/><path d="M6 14h.01"/><path d="M10 18h.01"/><path d="M14 6h.01"/><path d="M18 10h.01"/></svg>
          </div>
        </RandomDiceButton>
      </div>

      <div class="flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11">
        <NotificationBell client:only="react" />
      </div>

      <div class="flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11">
        <CartButton client:only="react">
          <div slot="fallback" class="flex items-center justify-center font-mono text-xs text-white hover:bg-white/10 transition-all duration-150 w-full h-full rounded-xl font-bold cursor-pointer bg-transparent select-none relative shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 sm:w-5.5 sm:h-5.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span id="cart-fallback-badge" class="hidden absolute -top-0.5 -right-0.5 flex items-center justify-center font-mono text-[9px] sm:text-[10px] bg-[#7b3fc4] text-white px-1.5 py-0.5 border border-[#7b3fc4] font-black h-4.5 min-w-[18px] rounded-none"></span>
          </div>
        </CartButton>
      </div>

      <div class="flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11">
        <SettingsButton client:only="react">
          <div slot="fallback" class="flex items-center justify-center font-mono text-xs text-white hover:bg-white/10 transition-all duration-150 w-full h-full rounded-xl font-bold cursor-pointer bg-transparent">
            <svg id="user-fallback-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 sm:w-5.5 sm:h-5.5 text-white/90"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <img id="user-fallback-img" class="hidden w-7 h-7 sm:w-8 sm:h-8 rounded-full object-cover border border-white/20" alt="User Profile" />
          </div>
        </SettingsButton>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  try {
    const cartRaw = localStorage.getItem("gamegata_cart");
    if (cartRaw) {
      const parsed = JSON.parse(cartRaw);
      if (Array.isArray(parsed) && parsed.length > 0) {
        const badge = document.getElementById("cart-fallback-badge");
        if (badge) {
          badge.textContent = parsed.length;
          badge.classList.remove("hidden");
        }
      }
    }
  } catch(e) {}

  try {
    const userRaw = localStorage.getItem("gamegata_user_cache");
    if (userRaw) {
      const parsed = JSON.parse(userRaw);
      if (parsed && parsed.avatarUrl) {
        const img = document.getElementById("user-fallback-img");
        const icon = document.getElementById("user-fallback-icon");
        if (img && icon) {
          img.src = parsed.avatarUrl;
          img.classList.remove("hidden");
          icon.classList.add("hidden");
        }
      }
    }
  } catch(e) {}
</script>
