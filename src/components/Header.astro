---
import SciFiLogo from './SciFiLogo';
import SettingsButton from './SettingsButton';
import HeaderSearch from './HeaderSearch';
import CartButton from './CartButton';
import RandomDiceButton from './RandomDiceButton';
import { NotificationBell } from './notifications/NotificationBell';
import { EditPageButton } from './editing/EditPageButton';
import { BugReportTrigger } from './bugs/BugReportTrigger';

import { getDataVersion } from '../lib/dataVersion';

interface Props {
  withSearch?: boolean;
  withLink?: boolean;
  statsGames?: number;
  statsDevelopers?: number;
  statsDeals?: number;
  statsTags?: number;
  editGameData?: {
    gameId: string;
    gameTitle: string;
    gameData: any;
  };
}

const { withSearch = false, withLink = true, editGameData } = Astro.props;
const dataVersion = await getDataVersion();
---
<header class="border-b border-white/10 bg-[#0d0d0f]/80 backdrop-blur-md sticky top-0 z-50 w-full max-w-full h-14 sm:h-16 select-none transition-all duration-300 overflow-x-clip">
  <div class="w-full h-full flex items-center justify-between max-w-[1440px] mx-auto px-3 sm:px-6">
    <!-- Left Section: Logo & Badge & Edit Page Button -->
    <div class="flex items-center h-full gap-2 sm:gap-3.5 min-w-0">
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <SciFiLogo withLink={withLink} />
        <span class="hidden xs:inline-block border border-white/20 text-white px-2 py-0.5 font-mono text-[8.5px] uppercase tracking-widest bg-white/10 select-none shrink-0 rounded-full font-bold">
          Beta
        </span>
      </div>

      {editGameData && (
        <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
          <EditPageButton
            client:load
            gameId={editGameData.gameId}
            gameTitle={editGameData.gameTitle}
            gameData={editGameData.gameData}
          />
          <BugReportTrigger client:load />
        </div>
      )}
    </div>

    <!-- Middle Section: Data Version, Timestamp & GitHub Link (Clean Sans-Serif) -->
    <div class="hidden md:flex items-center h-full px-6 font-sans text-xs text-white/50 select-none">
      <div class="flex items-center gap-2.5">
        <a
          href="https://github.com/project-hgg/project-hgg.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/60 hover:text-white transition-all hover:scale-110 flex items-center justify-center p-1 rounded-md hover:bg-white/10 shrink-0"
          title="View project-hgg GitHub Repository"
          aria-label="GitHub Repository"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>
        <span class="text-white/40 uppercase text-[10.5px] font-semibold tracking-wider">Data</span>
        <a
          href={dataVersion.commitUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/80 hover:text-white font-medium hover:underline transition-colors"
          title={dataVersion.commitMessage ? `Commit ${dataVersion.commitSha}: ${dataVersion.commitMessage}` : `View data release commit ${dataVersion.commitSha} on GitHub`}
        >
          {dataVersion.commitSha}
        </a>
        <span class="text-white/20">/</span>
        <span class="text-white/40 text-[11.5px]">
          Updated {dataVersion.displayDate}
        </span>
      </div>
    </div>


    <!-- Right Section: Actions -->
    <div class="flex items-center h-full gap-0.5 sm:gap-2 shrink-0">
      <div class="h-full flex items-center justify-center transition-all duration-300">
        <HeaderSearch client:only="react" />
      </div>

      <!-- Random Dice Button: Desktop only (on mobile, it lives in the floating BottomNav) -->
      <div class="hidden md:flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11">
        <RandomDiceButton client:only="react">
          <div slot="fallback" class="flex items-center justify-center text-white/70 hover:text-white transition-all duration-150 w-full h-full rounded-xl cursor-pointer bg-transparent">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 sm:w-5.5 sm:h-5.5 text-white/80"><rect width="12" height="12" x="2" y="10" rx="2" ry="2"/><path d="m17.92 14 3.5-3.5a2.24 2.24 0 0 0 0-3.16l-4.76-4.76a2.24 2.24 0 0 0-3.16 0L10 6.08"/><path d="M6 14h.01"/><path d="M10 18h.01"/><path d="M14 6h.01"/><path d="M18 10h.01"/></svg>
          </div>
        </RandomDiceButton>
      </div>

      <div class="flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10">
        <NotificationBell client:only="react" />
      </div>

      <div class="flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10">
        <CartButton client:only="react">
          <div slot="fallback" class="flex items-center justify-center font-mono text-xs text-white hover:bg-white/10 transition-all duration-150 w-full h-full rounded-xl font-bold cursor-pointer bg-transparent select-none relative shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4.5 h-4.5 sm:w-5 sm:h-5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span id="cart-fallback-badge" class="hidden absolute -top-0.5 -right-0.5 flex items-center justify-center font-mono text-[9px] sm:text-[10px] bg-[#7b3fc4] text-white px-1.5 py-0.5 border border-[#7b3fc4] font-black h-4 min-w-[16px] rounded-none"></span>
          </div>
        </CartButton>
      </div>

      <div class="flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10">
        <SettingsButton client:only="react">
          <div slot="fallback" class="flex items-center justify-center font-mono text-xs text-white hover:bg-white/10 transition-all duration-150 w-full h-full rounded-xl font-bold cursor-pointer bg-transparent">
            <svg id="user-fallback-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4.5 h-4.5 sm:w-5 sm:h-5 text-white/90"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <img id="user-fallback-img" class="hidden w-6 h-6 sm:w-7 sm:h-7 rounded-full object-cover border border-white/20" alt="User Profile" />
          </div>
        </SettingsButton>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  try {
    const cartRaw = localStorage.getItem("gamegata_cart");
    if (cartRaw) {
      const parsed = JSON.parse(cartRaw);
      if (Array.isArray(parsed) && parsed.length > 0) {
        const badge = document.getElementById("cart-fallback-badge");
        if (badge) {
          badge.textContent = parsed.length;
          badge.classList.remove("hidden");
        }
      }
    }
  } catch(e) {}

  try {
    const userRaw = localStorage.getItem("gamegata_user_cache");
    if (userRaw) {
      const parsed = JSON.parse(userRaw);
      if (parsed && parsed.avatarUrl) {
        const img = document.getElementById("user-fallback-img");
        const icon = document.getElementById("user-fallback-icon");
        if (img && icon) {
          img.src = parsed.avatarUrl;
          img.classList.remove("hidden");
          icon.classList.add("hidden");
        }
      }
    }
  } catch(e) {}
</script>
