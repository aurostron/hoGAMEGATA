---
import { BugReportTrigger } from './bugs/BugReportTrigger';
---
<footer class="w-full border-t border-white/10 bg-[#0d0d0f]/80 backdrop-blur-md select-none mt-auto py-3 sm:py-0 min-h-14 sm:h-16 flex items-center px-4 sm:px-6 md:px-12 font-sans text-xs tracking-wide text-white/80">
  <div class="w-full max-w-[1440px] mx-auto flex flex-col lg:flex-row items-center justify-between gap-3 text-center lg:text-left h-full">
    
    <!-- Left / Top: Copyright -->
    <div class="whitespace-nowrap uppercase text-white/70 font-medium text-[11px] sm:text-xs">
      © 2026 HOGAMEGATA PROJECT
    </div>

    <!-- Middle: Navigation Links -->
    <div class="flex flex-wrap items-center justify-center gap-x-3 sm:gap-x-4 gap-y-1 text-white/80 text-xs font-normal">
      <a href="/about" class="hover:text-white transition-colors">About</a>
      <span class="text-white/30">•</span>
      <a href="/contact" class="hover:text-white transition-colors">Contact</a>
      <span class="text-white/30">•</span>
      <a href="/legal" class="hover:text-white transition-colors">Legal</a>
      <span class="text-white/30">•</span>
      <a href="/terms" class="hover:text-white transition-colors">Terms</a>
      <span class="text-white/30">•</span>
      <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
      <span class="text-white/30">•</span>
      <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      <span class="text-white/30">•</span>
      <a href="https://project-hgg.github.io" target="_blank" rel="noopener" class="hover:text-white transition-colors">All Games</a>
      <span class="text-white/30">•</span>
      <a href="/submit-game" class="hover:text-white transition-colors">Submit Game</a>
    </div>

    <!-- Right / Bottom: Report Bug + Made With Credit -->
    <div class="flex flex-col sm:flex-row items-center gap-3 whitespace-nowrap text-white/70 text-[11px] sm:text-xs font-medium">
      <BugReportTrigger client:only="react" />
      <span>Made with <span class="text-red-500">❤️</span> by aurostron.</span>
    </div>

    <!-- Security Honeypot Decoys: Real users cannot see or interact with these; automated scrapers are trapped -->
    <a href="/api/games/dump" rel="nofollow" style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;" aria-hidden="true" tabindex="-1">Export Data</a>
    <a href="/api/v1/export" rel="nofollow" style="display:none;" aria-hidden="true" tabindex="-1">Raw Index Dump</a>

  </div>
</footer>
