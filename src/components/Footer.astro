---
import { BugReportTrigger } from './bugs/BugReportTrigger';
---
<footer class="w-full border-t border-white/10 bg-black select-none mt-auto py-6 lg:py-4 px-4 sm:px-6 md:px-12 font-mono text-[10px] tracking-widest text-white/50">
  <div class="max-w-[1440px] mx-auto flex flex-col lg:flex-row items-center justify-between gap-4 text-center lg:text-left">
    
    <!-- Left / Top: Copyright -->
    <div class="whitespace-nowrap uppercase text-white/40">
      © 2026 HOGAMEGATA PROJECT.
    </div>

    <!-- Middle: Navigation Links -->
    <div class="flex flex-wrap items-center justify-center gap-x-2.5 sm:gap-x-3 gap-y-1.5 uppercase text-white/60 text-[9.5px] sm:text-[10px]">
      <a href="/about" class="hover:text-white transition-colors">About</a>
      <span class="text-white/20">•</span>
      <a href="/contact" class="hover:text-white transition-colors">Contact</a>
      <span class="text-white/20">•</span>
      <a href="/legal" class="hover:text-white transition-colors">Legal</a>
      <span class="text-white/20">•</span>
      <a href="/terms" class="hover:text-white transition-colors">Terms</a>
      <span class="text-white/20">•</span>
      <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
      <span class="text-white/20">•</span>
      <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      <span class="text-white/20">•</span>
      <a href="/directory" class="hover:text-white transition-colors">All Games</a>
      <span class="text-white/20">•</span>
      <a href="/submit-game" class="hover:text-white transition-colors">Submit Game</a>
    </div>

    <!-- Right / Bottom: Report Bug + Made With Credit -->
    <div class="flex flex-col sm:flex-row items-center gap-3 whitespace-nowrap uppercase text-white/40">
      <BugReportTrigger client:only="react" />
      <span>Made with <span class="text-red-500">❤️</span> by aurostron and team.</span>
    </div>

  </div>
</footer>
