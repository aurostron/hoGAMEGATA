---
import SciFiLogo from './SciFiLogo';
import { BugReportTrigger } from './bugs/BugReportTrigger';
import SystemStatusIndicator from './SystemStatusIndicator';
---
<footer class="w-full border-t border-white/10 bg-[#0a0a0c] text-neutral-400 font-sans mt-16 sm:mt-24 lg:mt-32 py-12 lg:py-16 px-4 sm:px-6 md:px-12">
  <div class="w-full max-w-[1440px] mx-auto">

    <!-- Columns Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-10 lg:gap-8">

      <!-- Column 1 & 2: Brand, Outfit Font Logo & Mission (Spans 2 columns on desktop) -->
      <div class="sm:col-span-2 md:col-span-3 lg:col-span-2 flex flex-col gap-4">
        <SciFiLogo withLink={true} as="span" />

        <p class="text-xs text-neutral-400 leading-relaxed max-w-sm">
          A free, open database to search, track, and preserve horror games.
        </p>

        <!-- Action Links: Socials & Report Bug Button in one row -->
        <div class="flex flex-wrap items-center gap-2.5 pt-1 text-neutral-400">
          <a
            href="https://github.com/project-hgg/project-hgg.github.io"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 border border-white/10 bg-white/5 hover:bg-white/10 hover:text-white hover:border-white/20 transition-all rounded cursor-pointer shrink-0"
            aria-label="GitHub Repository"
            title="GitHub Repository"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
          </a>

          <a
            href="https://bsky.app/profile/gamegata.xyz"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 border border-white/10 bg-white/5 hover:bg-white/10 hover:text-white hover:border-white/20 transition-all rounded cursor-pointer shrink-0"
            aria-label="Bluesky Profile"
            title="Bluesky"
          >
            <svg class="w-4 h-4" viewBox="0 0 568 501" fill="currentColor">
              <path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.209C491.866-1.611 568-28.906 568 57.094c0 17.164-9.845 144.354-15.632 165.01-20.25 72.26-94.025 90.72-159.273 79.664 114.077 19.344 143.25 87.89 80.373 152.361-119.555 122.585-177.01-30.73-188.751-68.804-1.229-3.985-1.617-5.244-1.717-5.571-.1.327-.488 1.586-1.717 5.571-11.74 38.074-69.196 191.389-188.751 68.804-62.877-64.471-33.704-133.017 80.373-152.361-65.248 11.056-139.023-7.404-159.273-79.664C9.845 198.548 0 74.258 0 57.094 0-28.906 76.134-1.611 123.121 33.664Z"/>
            </svg>
          </a>

          <a
            href="mailto:hello@gamegata.xyz"
            class="p-2 border border-white/10 bg-white/5 hover:bg-white/10 hover:text-white hover:border-white/20 transition-all rounded cursor-pointer shrink-0"
            aria-label="Send Email"
            title="hello@gamegata.xyz"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </a>

          <BugReportTrigger client:only="react" variant="footer" />
        </div>

        <!-- Live System Status (Zero animation dot) -->
        <div class="pt-0.5">
          <SystemStatusIndicator client:only="react" />
        </div>

        <!-- Author Credit & Copyright (Sans font with distinct weights and balanced breathing room) -->
        <div class="flex flex-col gap-3 pt-2 font-sans text-xs">
          <p class="font-normal text-neutral-400 leading-normal">
            Made with love by <a href="/about" class="text-white hover:underline font-semibold">aurostron</a>.
          </p>
          <p class="font-medium text-neutral-500 leading-normal">
            © 2026 hoGAMEGATA Project
          </p>
        </div>
      </div>

      <!-- Column 3: Games -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs font-semibold text-white/40 uppercase tracking-widest">
          Games
        </span>
        <nav class="flex flex-col gap-2">
          <a href="/games" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">All Games</a>
          <a href="/search" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">Search</a>
          <a href="/upcoming" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">Upcoming Releases</a>
          <a href="https://project-hgg.github.io" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">Public Archive</a>
        </nav>
      </div>

      <!-- Column 4: About & Guides -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs font-semibold text-white/40 uppercase tracking-widest">
          About
        </span>
        <nav class="flex flex-col gap-2">
          <a href="/about" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">About the Project</a>
          <a href="/about#rubric" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">How We Rate Games</a>
          <a href="/about#scare-profile" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">7D Scare Profile</a>
          <a href="/about#sub-feelings" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">21 Feelings of Fear</a>
          <a href="/about#faq-sources" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">FAQ</a>
        </nav>
      </div>

      <!-- Column 5: Community -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs font-semibold text-white/40 uppercase tracking-widest">
          Community
        </span>
        <nav class="flex flex-col gap-2">
          <a href="/submit-game" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">Submit a Game</a>
          <a href="/blog" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">Blog</a>
          <a href="/support" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">Support the Project</a>
          <a href="/status" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">System Status</a>
        </nav>
      </div>

      <!-- Column 6: Legal -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs font-semibold text-white/40 uppercase tracking-widest">
          Legal
        </span>
        <nav class="flex flex-col gap-2">
          <a href="/contact" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">Contact</a>
          <a href="/terms" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">Terms of Service</a>
          <a href="/privacy" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">Privacy Policy</a>
          <a href="/legal" class="text-sm text-neutral-300 hover:text-white transition-colors py-0.5">Legal Notices</a>
        </nav>
      </div>

    </div>

  </div>

  <!-- Security Honeypot Decoys: Real users cannot see or interact with these; automated scrapers are trapped -->
  <a href="/api/games/dump" rel="nofollow" style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;" aria-hidden="true" tabindex="-1">Export Data</a>
  <a href="/api/v1/export" rel="nofollow" style="display:none;" aria-hidden="true" tabindex="-1">Raw Index Dump</a>
</footer>
