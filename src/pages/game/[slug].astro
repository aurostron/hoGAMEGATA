                  initialValue={game.storyline || ''}
                  label="Storyline"
                  isMultiline={true}
                  tag="p"
                  className="storyline-text text-xs text-neutral-300 leading-relaxed font-medium"
                />
              </div>
            )}
          </div>

          <!-- Scare Profile -->
          <div class="pt-6">
            <ScareMeter 
              client:visible
              scareRating={game.scareRating} 
              scareProfile={game.scareProfile as any} 
              reviewCount={game.scareReviewCount}
            />
          </div>
        </>
      ) : (
        <>
          <!-- Description Section -->
          <div class="pt-6 space-y-4">
            <h2 class="text-[11px] uppercase tracking-widest font-bold text-white/50">Description & Overview</h2>
            {game.summary ? (
              <div 
                class="text-sm text-neutral-300 font-medium leading-relaxed prose prose-invert max-w-none"
                set:html={game.summary}
              />
            ) : (
              <p class="text-sm text-neutral-400 font-medium leading-relaxed">
                No overview available for this title.
              </p>
            )}
            {game.storyline && (
              <div class="mt-4 pt-4 border-t border-white/5">
                <span class="text-[10px] text-white/40 uppercase tracking-widest block mb-2 font-semibold">Storyline</span>
                <p class="storyline-text text-xs text-neutral-300 leading-relaxed font-medium">
                  {game.storyline}
                </p>
              </div>
            )}
          </div>

          <!-- Mood Section -->
          {tags && tags.length > 0 && (
            <div class="pt-6 flex flex-wrap gap-4 items-center">
              <h2 class="flex items-center gap-1.5 text-[11px] uppercase tracking-widest font-bold text-white/50">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-neutral-400"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><line x1="7" x2="7.01" y1="7" y2="7"/></svg> Mood & Genres
              </h2>
              <div class="flex flex-wrap gap-2">
                {tags.map((t: any) => (
                  <span class="bg-zinc-900 border border-white/10 text-white/85 hover:border-white/35 text-xs px-3 py-1 font-medium transition-colors rounded-full">
                    {t.name}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Scare Profile -->
          <div class="pt-6">
            <ScareMeter 
              client:visible
              scareRating={game.scareRating} 
              scareProfile={game.scareProfile as any} 
              reviewCount={game.scareReviewCount}
            />
          </div>

          <!-- Price comparison deals -->
          <PriceComparison
            client:visible
            gameId={game.id}
            gameSlug={game.slug}
            gameTitle={game.title}
            purchaseLinks={purchaseLinks}
            initialDeals={priceSnapshots}
          />

          <!-- Official/Creator Links -->
          { (purchaseLinks?.length > 0 || game.websiteUrl || game.redditUrl) && (
            <div class="pt-6 space-y-4">
              <h2 class="text-[11px] uppercase tracking-widest font-bold text-white/50">Official & Creator Links</h2>
              <div class="flex flex-wrap gap-3">
                {purchaseLinks?.map((link: any) => (
                  <a
                    href={`/re/${game.slug}/${link.storeName.toLowerCase().replace(/[^a-z0-9]/g, "")}?gameId=${game.id}&fallbackUrl=${encodeURIComponent(link.url)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-2.5 text-xs bg-white/5 border border-white/10 hover:bg-white hover:text-black hover:border-white text-white/90 transition-all duration-150 px-4 py-2.5 font-semibold rounded-xl cursor-pointer"
                  >
                    <OfficialLinkIcon name={link.storeName} class="w-4 h-4 text-white/80 group-hover:text-black transition-colors shrink-0" />
                    <span>{link.storeName}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 opacity-40 group-hover:opacity-100 group-hover:text-black transition-all ml-0.5 shrink-0"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  </a>
                ))}

                {game.websiteUrl && (
                  <a
                    href={game.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-2.5 text-xs bg-white/5 border border-white/10 hover:bg-white hover:text-black hover:border-white text-white/90 transition-all duration-150 px-4 py-2.5 font-semibold rounded-xl cursor-pointer"
                  >
                    <OfficialLinkIcon name="website" class="w-4 h-4 text-white/80 group-hover:text-black transition-colors shrink-0" />
                    <span>Official Website</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 opacity-40 group-hover:opacity-100 group-hover:text-black transition-all ml-0.5 shrink-0"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  </a>
                )}

                {game.redditUrl && (
                  <a
                    href={game.redditUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-2.5 text-xs bg-white/5 border border-white/10 hover:bg-white hover:text-black hover:border-white text-white/90 transition-all duration-150 px-4 py-2.5 font-semibold rounded-xl cursor-pointer"
                  >
                    <OfficialLinkIcon name="reddit" class="w-4 h-4 text-white/80 group-hover:text-black transition-colors shrink-0" />
                    <span>Reddit Community</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 opacity-40 group-hover:opacity-100 group-hover:text-black transition-all ml-0.5 shrink-0"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  </a>
                )}
              </div>
            </div>
          )}
        </>
      )}
    </div>

    <!-- Screenshots Gallery -->
    {game.screenshots && game.screenshots.length > 0 && (
      <section class="border-t border-white/5 pt-12 space-y-6">
        <div class="flex items-center justify-between">
          <h2 class="text-xs uppercase tracking-widest font-bold text-white/60 flex items-center gap-2.5">
            <span>Screenshots</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-white/5 border border-white/10 text-white/40">
              {game.screenshots.length}
            </span>
          </h2>
        </div>
        <ScreenshotGallery 
          client:visible 
          screenshots={game.screenshots.map((url: string, idx: number) => getCloudinaryFetchUrl(url, game.isTrending, game.slug, `screenshot-${idx + 1}`) || url)} 
          title={game.title} 
        />
      </section>
    )}

    <!-- Trailers and Videos -->
    {(() => {
      const embedUrl = formatEmbedVideoUrl(game.trailerUrl);
      return embedUrl ? (
        <section class="border-t border-white/5 pt-12 space-y-6">
          <h2 class="text-[11px] uppercase tracking-widest font-bold text-white/50">Game Trailers & Videos</h2>
          <div class="border border-white/5 bg-[#131316]/50 p-1 aspect-video w-full max-w-3xl mx-auto rounded-2xl overflow-hidden shadow-2xl">
            <iframe
              src={embedUrl}
              title={`${game.title} trailer`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="w-full h-full border border-white/5 rounded-2xl"
            ></iframe>
          </div>
        </section>
      ) : null;
    })()}

    <!-- System Requirements Specifications -->
    {(requirements.min || requirements.rec) && (
      <section class="border-t border-white/5 pt-12 space-y-6">
        <!-- Section header -->
        <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-white/5 border border-white/30 text-[12px] uppercase tracking-[0.18em] font-bold text-white/100">
          PC System Requirements
        </span>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {requirements.min && (() => {
            const lines = cleanRequirementsText(requirements.min).split("\n");
            const rows = lines.map(line => { const parts = line.split(/:(.*)/); return parts.length >= 2 ? { key: parts[0].trim(), val: parts[1].trim() } : { key: null, val: line }; });
            return (
              <div class="group relative">
                <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-[1px]">
                  <div class="rounded-[calc(1rem-1px)] bg-[#0e0e11] overflow-hidden">
                    <!-- Card header -->
                    <div class="px-6 py-4 border-b border-white/[0.06] flex items-center justify-between">
                      <span class="text-sm font-bold uppercase tracking-[0.14em] text-white/60">Minimum</span>
                      <span class="text-[10px] px-2.5 py-0.5 rounded-full border border-white/10 text-white/30 font-medium tracking-wide">It just runs</span>
                    </div>
                    <!-- Rows -->
                    <div class="divide-y divide-white/[0.04]">
                      {rows.map(row => row.key ? (
                        <div class="flex items-start justify-between gap-4 px-6 py-3.5 hover:bg-white/[0.02] transition-colors duration-200">
                          <span class="text-xs font-semibold uppercase tracking-[0.1em] text-neutral-500 whitespace-nowrap pt-[1px] min-w-[72px]">{row.key}</span>
                          <span class="text-sm text-neutral-200 font-medium text-right leading-snug max-w-[58%]">{row.val}</span>
                        </div>
                      ) : (
                        <div class="px-6 py-3">
                          <p class="text-xs text-neutral-500 italic leading-relaxed">{row.val}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            );
          })()}

          {requirements.rec && (() => {
            const lines = cleanRequirementsText(requirements.rec).split("\n");
            const rows = lines.map(line => { const parts = line.split(/:(.*)/); return parts.length >= 2 ? { key: parts[0].trim(), val: parts[1].trim() } : { key: null, val: line }; });
            return (
              <div class="group relative">
                <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-[1px]">
                  <div class="rounded-[calc(1rem-1px)] bg-[#0e0e11] overflow-hidden">
                    <!-- Card header -->
                    <div class="px-6 py-4 border-b border-white/[0.06] flex items-center justify-between">
                      <span class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-400/70">Recommended</span>
                      <span class="text-[10px] px-2.5 py-0.5 rounded-full border border-emerald-500/20 bg-emerald-500/5 text-emerald-400/60 font-medium tracking-wide">Optimal</span>
                    </div>
                    <!-- Rows -->
                    <div class="divide-y divide-white/[0.04]">
                      {rows.map(row => row.key ? (
                        <div class="flex items-start justify-between gap-4 px-6 py-3.5 hover:bg-white/[0.02] transition-colors duration-200">
                          <span class="text-xs font-semibold uppercase tracking-[0.1em] text-neutral-500 whitespace-nowrap pt-[1px] min-w-[72px]">{row.key}</span>
                          <span class="text-sm text-neutral-200 font-medium text-right leading-snug max-w-[58%]">{row.val}</span>
                        </div>
                      ) : (
                        <div class="px-6 py-3">
                          <p class="text-xs text-neutral-500 italic leading-relaxed">{row.val}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            );
          })()}
        </div>
      </section>
    )}

    <!-- Creator games recommendations section -->
    {developers.length > 0 ? (
      <CreatorGames 
        client:visible
        creatorIds={developers.map((d: any) => d.id)}
        creatorNames={developers.map((d: any) => d.name)}
        excludeGameId={game.id}
      />
    ) : publishers.length > 0 ? (
      <CreatorGames 
        client:visible
        creatorIds={publishers.map((p: any) => p.id)}
        creatorNames={publishers.map((p: any) => p.name)}
        excludeGameId={game.id}
      />
    ) : null}
    </main>

</Layout>
