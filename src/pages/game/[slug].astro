---
import Layout from '../../layouts/Layout.astro';
import { turso } from '../../lib/turso';
import {
  games as gamesTable,
  developers as developersTable,
  gamesToDevelopers,
  publishers as publishersTable,
  gamesToPublishers,
  genres as genresTable,
  gamesToGenres,
  tags as tagsTable,
  gamesToTags,
  platforms as platformsTable,
  gamesToPlatforms,
  purchaseLinks as purchaseLinksTable,
  priceSnapshots as priceSnapshotsTable
} from '../../db/schema';
import { eq } from 'drizzle-orm';
import { getHighResCoverUrl, getCloudinaryFetchUrl, getCategoryBadge, cleanTitle, formatPrice, formatEmbedVideoUrl } from '../../lib/utils';

// Import React components
import PlatformLogos from '../../components/PlatformLogos';
import ShareButton from '../../components/ShareButton';
import ScareMeter from '../../components/ScareMeter';
import PriceComparison from '../../components/PriceComparison';
import ScreenshotGallery from '../../components/ScreenshotGallery';
import CreatorGames from '../../components/CreatorGames';
import TrackControls from '../../components/TrackControls';
import VibeTracker from '../../components/VibeTracker';
import RatingDistributionBar from '../../components/RatingDistributionBar';
import ReadMoreScrollButton from '../../components/ReadMoreScrollButton';
import CinematicCreditsRoll from '../../components/CinematicCreditsRoll';
import { EditPencilButton } from '../../components/editing/EditPencilButton';
import { EditPageButton } from '../../components/editing/EditPageButton';
import EditStoreInit from '../../components/editing/EditStoreInit';
import { EditableText } from '../../components/editing/EditableText';
import { HistoryButton } from '../../components/editing/HistoryButton';
import { HelpMenuDropdown } from '../../components/editing/HelpMenuDropdown';
import { BugReportTrigger } from '../../components/bugs/BugReportTrigger';
import CoverFavoriteButton from '../../components/CoverFavoriteButton';
import { trackGameView } from '../../lib/analytics';

// SSR: render every game on-demand instead of pre-building a limited static set.
export const prerender = false;

const { slug } = Astro.params;

// 1. Fetch raw game from Turso
const [rawGame] = await turso
  .select()
  .from(gamesTable)
  .where(eq(gamesTable.slug, slug!))
  .limit(1);

if (!rawGame) {
  return Astro.redirect('/404');
}

// Track game view in background without blocking SSR page rendering
const cfCtx = (Astro.locals as any).cfContext;
if (cfCtx?.waitUntil) {
  cfCtx.waitUntil(trackGameView(rawGame.id, rawGame.title));
} else {
  trackGameView(rawGame.id, rawGame.title).catch(() => {});
}

if (rawGame.status === "hidden") {
  const { getServerUser, isAdminUser } = await import('../../lib/serverAuth');
  const user = await getServerUser(Astro.request, Astro.cookies);
  const isAdmin = user && isAdminUser(user.email);
  if (!isAdmin) {
    return Astro.redirect('/404');
  }
}

// 2. Fetch game relations from Turso in parallel
const [
  devsData,
  pubsData,
  genresData,
  tagsData,
  platsData,
  linksData,
  priceSnapshotsData
] = await Promise.all([
  turso
    .select({ id: developersTable.id, name: developersTable.name, slug: developersTable.slug })
    .from(gamesToDevelopers)
    .innerJoin(developersTable, eq(gamesToDevelopers.developerId, developersTable.id))
    .where(eq(gamesToDevelopers.gameId, rawGame.id)),
  turso
    .select({ id: publishersTable.id, name: publishersTable.name, slug: publishersTable.slug })
    .from(gamesToPublishers)
    .innerJoin(publishersTable, eq(gamesToPublishers.publisherId, publishersTable.id))
    .where(eq(gamesToPublishers.gameId, rawGame.id)),
  turso
    .select({ id: genresTable.id, name: genresTable.name, slug: genresTable.slug })
    .from(gamesToGenres)
    .innerJoin(genresTable, eq(gamesToGenres.genreId, genresTable.id))
    .where(eq(gamesToGenres.gameId, rawGame.id)),
  turso
    .select({ id: tagsTable.id, name: tagsTable.name, slug: tagsTable.slug })
    .from(gamesToTags)
    .innerJoin(tagsTable, eq(gamesToTags.tagId, tagsTable.id))
    .where(eq(gamesToTags.gameId, rawGame.id)),
  turso
    .select({ id: platformsTable.id, name: platformsTable.name, slug: platformsTable.slug })
    .from(gamesToPlatforms)
    .innerJoin(platformsTable, eq(gamesToPlatforms.platformId, platformsTable.id))
    .where(eq(gamesToPlatforms.gameId, rawGame.id)),
  turso
    .select()
    .from(purchaseLinksTable)
    .where(eq(purchaseLinksTable.gameId, rawGame.id)),
  turso
    .select()
    .from(priceSnapshotsTable)
    .where(eq(priceSnapshotsTable.gameId, rawGame.id))
]);

// 3. Assemble full game object with parsed json structures matching previous schema
const game = {
  ...rawGame,
  screenshots: rawGame.screenshots ? JSON.parse(rawGame.screenshots) : [],
  scareProfile: rawGame.scareProfile ? JSON.parse(rawGame.scareProfile) : null,
  taxonomyScores: rawGame.taxonomyScores ? JSON.parse(rawGame.taxonomyScores) : null,
  developers: devsData,
  publishers: pubsData,
  genres: genresData,
  tags: tagsData,
  platforms: platsData,
  purchaseLinks: linksData
};

const priceSnapshots = priceSnapshotsData || [];

// Cache this rendered page at the Cloudflare edge for 30 days, with 1-year background revalidation.
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=2592000, stale-while-revalidate=31536000'
);

const purchaseLinks = (game.purchaseLinks as any[]) || [];

// Redirect dry/unenriched itch.io games directly to their itch page (with purchase popup open)
if (game.slug.startsWith("itch-") && !game.rawgEnriched) {
  const itchLink = purchaseLinks.find((link: any) => link.storeName.toLowerCase() === "itch.io");
  if (itchLink && itchLink.url) {
    const directPurchaseUrl = itchLink.url.endsWith("/purchase")
      ? itchLink.url
      : `${itchLink.url.replace(/\/$/, "")}/purchase`;
    return Astro.redirect(directPurchaseUrl);
  }
}

const steamLink = purchaseLinks?.find((link: any) => 
  link.storeName.toLowerCase() === "steam" || link.url.includes("steampowered.com")
);
const steamAppId = steamLink?.url.match(/\/app\/(\d+)/)?.[1] || null;

const ratingDisplay = game.rating ? `${(game.rating / 10).toFixed(1)} / 10` : "No rating yet";
const isItchGame = game.slug.startsWith("itch-") || (game as any).source === "itch" || (game as any).source === "itchio";
const hasGogBadge = purchaseLinks?.some((link: any) => link.storeName.toLowerCase().includes("gog")) || game.slug.startsWith("gog-");

const tags = (game.tags as any[]) || [];

const STOREFRONT_NAMES = new Set([
  "gog.com", "gog", "steam", "itch.io", "itch", "epic games", "epic games store", "nintendo eshop", "playstation store", "xbox store", "humble bundle", "playstation", "xbox", "nintendo"
]);

const cleanEntityList = (entities: any[]) => {
  const seenNames = new Set<string>();
  return entities.filter((e: any) => {
    if (!e || !e.name) return false;
    const nameLower = e.name.toLowerCase().trim();
    if (STOREFRONT_NAMES.has(nameLower)) return false;
    if (seenNames.has(nameLower)) return false;
    seenNames.add(nameLower);
    return true;
  });
};

const developers = cleanEntityList((game.developers as any[]) || []);
const publishers = cleanEntityList((game.publishers as any[]) || []);
const genres = (game.genres as any[]) || [];
const platforms = (game.platforms as any[]) || [];

const requirements = { min: game.minRequirements, rec: game.recRequirements };

function cleanRequirementsText(text: string): string {
  let cleaned = text
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<\/li>/gi, "\n")
    .replace(/<\/p>/gi, "\n")
    .replace(/<\/div>/gi, "\n");
  
  cleaned = cleaned.replace(/<[^>]*>/g, "");
  
  cleaned = cleaned
    .replace(/^(Minimum|Recommended|Minimum Requirements|Recommended Requirements):\s*/gi, "")
    .replace(/\n(Minimum|Recommended|Minimum Requirements|Recommended Requirements):\s*/gi, "\n");
  
  cleaned = cleaned
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");

  return cleaned
    .split("\n")
    .map(line => line.trim())
    .filter(Boolean)
    .join("\n");
}

// Technical SEO & Structured Data (JSON-LD)
const developerNames = developers.map((d: any) => d.name).join(", ");
const genreNames = genres.map((g: any) => g.name).join(", ");
const cleanTitleName = cleanTitle(game.title);

let seoDescription = `Discover ${cleanTitleName} on hoGAMEGATA. `;
if (developerNames) {
  seoDescription += `Developed by ${developerNames}. `;
}
if (genreNames) {
  seoDescription += `Genre: ${genreNames}. `;
}
if (game.summary) {
  const cleanSummary = game.summary.replace(/<[^>]*>/g, "").substring(0, 120).trim();
  seoDescription += `${cleanSummary}...`;
} else {
  seoDescription += `Check out screenshots, ratings, system requirements, and cheapest store prices/purchase links.`;
}
if (seoDescription.length > 160) {
  seoDescription = seoDescription.substring(0, 157) + "...";
}

let ogImage = game.coverUrl ? getHighResCoverUrl(game.coverUrl) : null;
if (ogImage && ogImage.startsWith("//")) {
  ogImage = "https:" + ogImage;
}
const ogUrl = `https://gamegata.xyz/game/${game.slug}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  "name": cleanTitleName,
  "description": game.summary ? game.summary.replace(/<[^>]*>/g, "").substring(0, 300).trim() + "..." : undefined,
  "image": ogImage,
  "genre": genres.map((g: any) => g.name),
  "gamePlatform": platforms.map((p: any) => p.name),
  "author": developerNames ? {
    "@type": "Organization",
    "name": developerNames
  } : undefined,
  "publisher": publishers.map((pub: any) => ({
    "@type": "Organization",
    "name": pub.name
  })),
  "datePublished": game.releaseDate ? new Date(game.releaseDate).toISOString().split('T')[0] : undefined,
  "aggregateRating": game.rating ? {
    "@type": "AggregateRating",
    "ratingValue": (game.rating / 10).toFixed(1),
    "bestRating": "10",
    "worstRating": "1",
    "ratingCount": 1
  } : undefined,
  "offers": priceSnapshots.map((snap: any) => ({
    "@type": "Offer",
    "price": snap.dealPrice,
    "priceCurrency": snap.currency || "USD",
    "url": snap.dealUrl,
    "category": "retail",
    "seller": {
      "@type": "Organization",
      "name": snap.storeName
    }
  }))
};
const schemaJson = JSON.stringify(schema);
const editGameData = {
  gameId: game.id,
  gameTitle: game.title,
  gameData: {
    developerNames: developers.map((d: any) => d.name).join(", "),
    summary: game.summary || "",
    storyline: game.storyline || "",
    trailerUrl: game.trailerUrl || "",
    websiteUrl: game.websiteUrl || "",
    redditUrl: game.redditUrl || "",
    esrbRating: game.esrbRating || "",
    pegiRating: game.pegiRating || "",
    rating: game.rating,
    metacritic: game.metacritic,
    playtime: game.playtime,
    platformNames: platforms.map((p: any) => p.name).join(", "),
    protonDbTier: game.protonDbTier || "",
    steamAppId: steamAppId || null,
  }
};
---

<Layout 
  title={`${cleanTitleName} | hoGAMEGATA`} 
  description={seoDescription}
  ogImage={ogImage}
  ogUrl={ogUrl}
  ogType="video.other"
  withSearch={true}
  editGameData={editGameData}
>
  <script type="application/ld+json" is:inline set:html={schemaJson} />
  <VibeTracker client:load tags={tags} genres={genres} />

  <style is:global>
    /* Let default case rendering apply on the game detail pages */
    .game-page-override, 
    .game-page-override * {
      text-transform: none;
    }
  </style>
 
  <EditStoreInit client:load initialData={editGameData.gameData} />
    <main class="game-page-override max-w-6xl mx-auto px-4 sm:px-6 mt-6 sm:mt-12 space-y-8 sm:space-y-16">
    <!-- Top Section: RAWG.io-Inspired Minimalist 2-Column Hero Grid (Swapped: Cover Left, Details Right) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 lg:gap-10 items-start">
      
      <!-- Left Media Column (5 cols): High-Res Uncropped Cover Poster ONLY -->
      <div class="md:col-span-5 flex flex-col justify-start max-w-[280px] sm:max-w-sm md:max-w-none mx-auto w-full">
        
        <!-- High-Res Uncropped Cover Poster Card (Full Original Aspect Ratio 3:4 / 5:4) -->
        <div class={`border border-white/10 bg-[#131316]/60 rounded-2xl overflow-hidden shrink-0 relative w-full shadow-2xl ${
          isItchGame ? "aspect-[5/4]" : "aspect-[3/4]"
        }`}>
          {game.coverUrl ? (
            <div class="relative w-full h-full">
              <img 
                src={getCloudinaryFetchUrl(getHighResCoverUrl(game.coverUrl), game.isTrending) || ""} 
                alt={game.title} 
                class="object-cover w-full h-full border border-white/5 rounded-2xl shadow-2xl"
              />
            </div>
          ) : (
            <div class="w-full h-full bg-gradient-to-b from-white/5 to-black flex items-center justify-center border border-white/5 rounded-2xl">
              <span class="text-xs tracking-wider text-neutral-400">No Cover Art</span>
            </div>
          )}
        </div>

        {(() => {
          const itchLink = purchaseLinks?.find((link: any) => link.storeName.toLowerCase() === "itch.io");
          if (itchLink && itchLink.url) {
            const directPurchaseUrl = itchLink.url.endsWith("/purchase")
              ? itchLink.url
              : `${itchLink.url.replace(/\/$/, "")}/purchase`;
            return (
              <a
                href={`/re/${game.slug}/itchio?gameId=${game.id}&fallbackUrl=${encodeURIComponent(directPurchaseUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 px-4 py-3 mt-4 bg-[#fa5c5c] text-black text-xs uppercase tracking-widest font-black transition-all duration-150 hover:bg-[#ff7676] select-none rounded-xl border border-[#fa5c5c] shadow-lg"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-black"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                <span>Buy / Download on itch.io</span>
              </a>
            );
          }
          return null;
        })()}

      </div>

      <!-- Right Main Column (7 cols): Hero Title, Badges, RAWG Deck, Metric Pills, Quick Specs & Available On... Stores -->
      <div class="md:col-span-7 space-y-3.5">
        
        <!-- 1. Metadata Sub-Header: Status Badges + Action Tools -->
        <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex flex-wrap items-center gap-2">
            {game.status && game.status.trim() !== "" && (
              <span class="text-[9px] text-black uppercase tracking-wider font-extrabold bg-white border border-white px-2 py-0.5 rounded shadow">
                {game.status}
              </span>
            )}
            {(() => {
              const badge = getCategoryBadge(game.category, game.title);
              if (!badge) return null;
              const isVN = badge === "Visual Novel";
              const borderClass = isVN ? "border-[#581c87]" : "border-[#7f1d1d]";
              const bgClass = isVN ? "bg-[#581c87] text-[#f5d0fe]" : "bg-[#7f1d1d] text-[#fca5a5]";
              return (
                <span class={`text-[9px] uppercase tracking-wider border px-2 py-0.5 font-extrabold rounded shadow ${borderClass} ${bgClass}`}>
                  {badge}
                </span>
              );
            })()}
            {game.slug.startsWith("itch-") && (
              <span class="text-[9px] text-black uppercase tracking-wider border border-[#fa5c5c] px-2 py-0.5 font-extrabold bg-[#fa5c5c] rounded shadow">
                itch.io
              </span>
            )}
            {hasGogBadge && (
              <span class="text-[9px] text-white uppercase tracking-wider border border-[#7b3fc4] px-2 py-0.5 font-extrabold bg-[#7b3fc4] rounded shadow">
                DRM-Free
              </span>
            )}
          </div>

          <!-- Tools: Share + Help Menu -->
          <div class="flex items-center gap-2">
            <ShareButton client:only="react" />
            <HelpMenuDropdown
              client:only="react"
              gameId={game.id}
              gameTitle={game.title}
              gameData={{
                developerNames: developers.map((d: any) => d.name).join(", "),
                summary: game.summary,
                storyline: game.storyline,
                trailerUrl: game.trailerUrl,
                websiteUrl: game.websiteUrl,
                redditUrl: game.redditUrl,
                esrbRating: game.esrbRating,
              }}
            />
          </div>
        </div>

        <!-- 2. Massive Display Title -->
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-display font-black text-white tracking-tighter leading-tight py-0.5">
          {cleanTitleName}
        </h1>

        <!-- 3. Developer Credits Subheader -->
        <div class="flex flex-wrap items-center gap-2 font-light group pb-0.5">
          <span class="text-white/50">by</span>
          <span class="text-white/90 font-medium">
            {developers.map((d: any, idx: number) => (
              <>
                {idx > 0 && ", "}
                <a href={`/developer/${d.slug}`} class="hover:text-white transition-colors">{d.name}</a>
              </>
            ))}
          </span>
          {/* CinematicCreditsRoll (temporarily hidden, code preserved)
          <CinematicCreditsRoll
            client:only="react"
            title={game.title}
            rawgSlug={game.rawgSlug}
            developerName={developers.map((d: any) => d.name).join(", ")}
            releaseYear={game.releaseDate ? new Date(game.releaseDate).getFullYear() : null}
          />
          */}
        </div>

        <!-- 1. Release Date -->
        <div class="pt-1">
          <span class="text-[10px] uppercase tracking-widest text-neutral-500 font-bold block mb-0.5">released</span>
          <span class="text-xl sm:text-2xl font-light font-mono text-white leading-none tabular-nums">
            {game.releaseDate ? new Date(game.releaseDate).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : "RELEASE DATE TBD"}
          </span>
        </div>

        <!-- 2. Ratings Row -->
        <div class="grid grid-cols-2 gap-4 sm:flex sm:items-end sm:gap-8 pt-1">
          <div class="flex flex-col">
            <span class="text-[10px] uppercase tracking-widest text-neutral-500 font-bold mb-0.5">avg. rating</span>
            <span class="text-3xl font-light font-mono text-white leading-none tabular-nums">{ratingDisplay}</span>
          </div>
          {game.steamRating !== null && (
            <div class="flex flex-col">
              <span class="text-[10px] uppercase tracking-widest text-neutral-500 font-bold mb-0.5">steam</span>
              <span class="text-3xl font-light font-mono text-white leading-none tabular-nums">{game.steamRating.toFixed(1)}<span class="text-neutral-500 text-lg">/10</span></span>
            </div>
          )}
          {game.scareRating !== null && (
            <div class="flex flex-col">
              <span class="text-[10px] uppercase tracking-widest text-red-500/70 font-bold mb-0.5">scare score</span>
              <span class="text-3xl font-light font-mono text-red-500 leading-none tabular-nums">{game.scareRating}<span class="text-red-400/50 text-lg">/100</span></span>
            </div>
          )}
          {game.metacritic !== null && (
            <div class="flex flex-col">
              {game.metacriticUrl ? (
                <a href={game.metacriticUrl} target="_blank" rel="noopener noreferrer" class="group flex flex-col hover:opacity-80 transition-opacity">
                  <span class="text-[10px] uppercase tracking-widest text-neutral-500 font-bold mb-0.5 flex items-center gap-1">metacritic <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2.5 h-2.5 opacity-0 group-hover:opacity-60 transition-opacity"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></span>
                  <span class="text-3xl font-light font-mono text-white leading-none tabular-nums">{game.metacritic}<span class="text-neutral-500 text-lg">/100</span></span>
                </a>
              ) : (
                <>
                  <span class="text-[10px] uppercase tracking-widest text-neutral-500 font-bold mb-0.5">metacritic</span>
                  <span class="text-3xl font-light font-mono text-white leading-none tabular-nums">{game.metacritic}<span class="text-neutral-500 text-lg">/100</span></span>
                </>
              )}
            </div>
          )}
        </div>

        <!-- 3. Platforms Row (Stacked) -->
        {platforms && platforms.length > 0 && (
          <div class="pt-1">
            <span class="text-[10px] uppercase tracking-widest text-neutral-500 font-bold block mb-1">platforms</span>
            <PlatformLogos platforms={platforms} class="flex items-center gap-2 opacity-90 h-6" solid={true} />
          </div>
        )}

        <!-- 4. Linux Row -->
        {steamAppId && (
          <div class="pt-1">
            <span class="text-[10px] uppercase tracking-widest text-neutral-500 font-bold block mb-0.5">linux?</span>
            {game.protonDbTier ? (
              <a
                href={`https://www.protondb.com/app/${steamAppId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-1.5 hover:opacity-75 transition-opacity"
                title={game.protonDbConfidence && game.protonDbTotalReports ? `${game.protonDbConfidence} confidence · ${game.protonDbTotalReports} reports` : "ProtonDB"}
              >
                <span class={`text-2xl font-black font-mono leading-none capitalize tabular-nums ${
                  game.protonDbTier === "native" || game.protonDbTier === "platinum"
                    ? "text-emerald-400"
                    : game.protonDbTier === "gold"
                    ? "text-white"
                    : game.protonDbTier === "silver"
                    ? "text-white/50"
                    : "text-red-400/60 line-through"
                }`}>
                  {game.protonDbTier}
                </span>
                {game.protonDbTotalReports !== null && game.protonDbTotalReports > 0 && (
                  <span class="text-neutral-600 text-xs font-mono"> · {game.protonDbTotalReports} reports</span>
                )}
              </a>
            ) : (
              <span class="text-2xl font-black font-mono text-white/25 leading-none">—</span>
            )}
          </div>
        )}

        <!-- 5. Avg Playtime Row -->
        {game.playtime !== null && game.playtime > 0 && (
          <div class="pt-1">
            <span class="text-[10px] uppercase tracking-widest text-neutral-500 font-bold block mb-0.5">avg. playtime</span>
            <span class="text-2xl font-light font-mono text-white leading-none tabular-nums">
              {game.playtime}<span class="text-neutral-500 text-base"> hrs</span>
            </span>
          </div>
        )}

        <!-- 6. User Interaction Buttons -->
        <div class="pt-2">
          <TrackControls
            client:load
            compactOnly={true}
            gameId={game.id}
            gameSlug={game.slug}
            gameTitle={game.title}
            genres={genres.map((g: any) => g.name)}
            siteRating={game.rating ? game.rating / 10 : null}
            steamRating={game.steamRating}
            coverUrl={game.coverUrl}
            initialPriceSnapshots={priceSnapshots}
            initialLikesCount={game.likesCount || 0}
          />
        </div>

        {/* Community Rating Bar (kept for future reference)
        <RatingDistributionBar
          client:load
          gameId={game.id}
          gameTitle={game.title}
          baseRating={game.rating ? Math.round((game.rating / 10) * 10) : 80}
        />
        */}

        <!-- 7. Data Attribution -->
        {isItchGame ? (
          <div class="pt-1 flex items-center text-xs select-none">
            <a
              href={`https://itch.io/search?q=${encodeURIComponent(cleanTitleName)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="italic text-white/40 hover:text-white/80 transition-colors font-sans text-xs inline-flex items-center gap-1 underline decoration-dotted"
            >
              <span>Data by itch.io</span>
            </a>
          </div>
        ) : game.igdbId ? (
          <div class="pt-1 flex items-center text-xs select-none">
            <a
              href={`https://www.igdb.com/games/${game.slug.replace(/^(steam|itch|gog)-/, "")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="italic text-white/40 hover:text-white/80 transition-colors font-sans text-xs inline-flex items-center gap-1 underline decoration-dotted"
            >
              <span>Data by IGDB</span>
            </a>
          </div>
        ) : null}

      </div>

    </div>

    <!-- Details Section -->
    <div id="details-overview-section" class="space-y-12 mt-12 scroll-mt-20">
      {isItchGame ? (
        <>
          <!-- Mood Section -->
          {tags && tags.length > 0 && (
            <div class="pt-6 flex flex-wrap gap-4 items-center">
              <h2 class="flex items-center gap-1.5 text-lg text-white font-bold">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><line x1="7" x2="7.01" y1="7" y2="7"/></svg> Mood & Genres
              </h2>
              <div class="flex flex-wrap gap-2">
                {tags.map((t: any) => (
                  <span class="bg-white text-black text-[9px] uppercase tracking-wider px-2.5 py-1 font-extrabold border border-white rounded">
                    {t.name}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Price comparison deals -->
          <PriceComparison
            client:load
            gameId={game.id}
            gameSlug={game.slug}
            gameTitle={game.title}
            purchaseLinks={purchaseLinks}
            initialDeals={priceSnapshots}
          />

          <!-- Official/Creator Links -->
          { (purchaseLinks?.length > 0 || game.websiteUrl || game.redditUrl) && (
            <div class="pt-6 space-y-4">
              <h2 class="text-[11px] uppercase tracking-widest font-bold text-white/50">Official & Creator Links</h2>
              <div class="flex flex-wrap gap-3">
                {purchaseLinks?.map((link: any) => (
                  <a
                    href={`/re/${game.slug}/${link.storeName.toLowerCase().replace(/[^a-z0-9]/g, "")}?gameId=${game.id}&fallbackUrl=${encodeURIComponent(link.url)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 text-xs bg-white/5 border border-white/5 hover:bg-white hover:text-black text-white transition-all duration-150 px-4 py-2.5 font-semibold rounded-xl"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-white/70 group-hover:text-black"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    <span>Support Creator ({link.storeName})</span>
                  </a>
                ))}

                {game.websiteUrl && (
                  <a
                    href={game.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 text-xs bg-white/5 border border-white/5 hover:bg-white hover:text-black text-white transition-all duration-150 px-4 py-2.5 font-semibold rounded-xl"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-white/70 group-hover:text-black"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    <span>Official Website</span>
                  </a>
                )}

                {game.redditUrl && (
                  <a
                    href={game.redditUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 text-xs bg-white/5 border border-white/5 hover:bg-white hover:text-black text-white transition-all duration-150 px-4 py-2.5 font-semibold rounded-xl"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-white/70 group-hover:text-black"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    <span>Reddit Community</span>
                  </a>
                )}
              </div>
            </div>
          )}

          <!-- Description Section -->
          <div class="pt-6 space-y-4">
            <h2 class="text-[11px] uppercase tracking-widest font-bold text-white/50">Description & Overview</h2>
            <EditableText
              client:load
              fieldKey="summary"
              initialValue={game.summary || ''}
              label="Summary"
              isMultiline={true}
              tag="div"
              className="text-sm text-neutral-300 font-medium leading-relaxed prose prose-invert max-w-none"
            />
            {game.storyline && (
              <div class="mt-4 pt-4 border-t border-white/5">
                <span class="text-[10px] text-white/40 uppercase tracking-widest block mb-2 font-semibold">Storyline</span>
                <EditableText
                  client:load
                  fieldKey="storyline"
                  initialValue={game.storyline || ''}
                  label="Storyline"
                  isMultiline={true}
                  tag="p"
                  className="storyline-text text-xs text-neutral-300 leading-relaxed font-medium"
                />
              </div>
            )}
          </div>

          <!-- Scare Profile -->
          {game.scareRating !== null && game.scareProfile && (
            <div class="pt-6">
              <ScareMeter 
                client:load
                scareRating={game.scareRating} 
                scareProfile={game.scareProfile as any} 
                reviewCount={game.scareReviewCount}
              />
            </div>
          )}
        </>
      ) : (
        <>
          <!-- Description Section -->
          <div class="pt-6 space-y-4">
            <h2 class="text-[11px] uppercase tracking-widest font-bold text-white/50">Description & Overview</h2>
            {game.summary ? (
              <div 
                class="text-sm text-neutral-300 font-medium leading-relaxed prose prose-invert max-w-none"
                set:html={game.summary}
              />
            ) : (
              <p class="text-sm text-neutral-400 font-medium leading-relaxed">
                No overview available for this title.
              </p>
            )}
            {game.storyline && (
              <div class="mt-4 pt-4 border-t border-white/5">
                <span class="text-[10px] text-white/40 uppercase tracking-widest block mb-2 font-semibold">Storyline</span>
                <p class="storyline-text text-xs text-neutral-300 leading-relaxed font-medium">
                  {game.storyline}
                </p>
              </div>
            )}
          </div>

          <!-- Mood Section -->
          {tags && tags.length > 0 && (
            <div class="pt-6 flex flex-wrap gap-4 items-center">
              <h2 class="flex items-center gap-1.5 text-[11px] uppercase tracking-widest font-bold text-white/50">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-neutral-400"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><line x1="7" x2="7.01" y1="7" y2="7"/></svg> Mood & Genres
              </h2>
              <div class="flex flex-wrap gap-2">
                {tags.map((t: any) => (
                  <span class="bg-zinc-900 border border-white/10 text-white/85 hover:border-white/35 text-xs px-3 py-1 font-medium transition-colors rounded-full">
                    {t.name}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Scare Profile -->
          {game.scareRating !== null && game.scareProfile && (
            <div class="pt-6">
              <ScareMeter 
                client:load
                scareRating={game.scareRating} 
                scareProfile={game.scareProfile as any} 
                reviewCount={game.scareReviewCount}
              />
            </div>
          )}

          <!-- Price comparison deals -->
          <PriceComparison
            client:load
            gameId={game.id}
            gameSlug={game.slug}
            gameTitle={game.title}
            purchaseLinks={purchaseLinks}
            initialDeals={priceSnapshots}
          />

          <!-- Official/Creator Links -->
          { (purchaseLinks?.length > 0 || game.websiteUrl || game.redditUrl) && (
            <div class="pt-6 space-y-4">
              <h2 class="text-[11px] uppercase tracking-widest font-bold text-white/50">Official & Creator Links</h2>
              <div class="flex flex-wrap gap-3">
                {purchaseLinks?.map((link: any) => (
                  <a
                    href={`/re/${game.slug}/${link.storeName.toLowerCase().replace(/[^a-z0-9]/g, "")}?gameId=${game.id}&fallbackUrl=${encodeURIComponent(link.url)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 text-xs bg-white/5 border border-white/5 hover:bg-white hover:text-black text-white transition-all duration-150 px-4 py-2.5 font-semibold rounded-xl"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-white/70 group-hover:text-black"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    <span>Support Creator ({link.storeName})</span>
                  </a>
                ))}

                {game.websiteUrl && (
                  <a
                    href={game.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 text-xs bg-white/5 border border-white/5 hover:bg-white hover:text-black text-white transition-all duration-150 px-4 py-2.5 font-semibold rounded-xl"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-white/70 group-hover:text-black"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    <span>Official Website</span>
                  </a>
                )}

                {game.redditUrl && (
                  <a
                    href={game.redditUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 text-xs bg-white/5 border border-white/5 hover:bg-white hover:text-black text-white transition-all duration-150 px-4 py-2.5 font-semibold rounded-xl"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-white/70 group-hover:text-black"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    <span>Reddit Community</span>
                  </a>
                )}
              </div>
            </div>
          )}
        </>
      )}
    </div>

    <!-- Screenshots Gallery -->
    {game.screenshots && game.screenshots.length > 0 && (
      <section class="border-t border-white/5 pt-12 space-y-6">
        <h2 class="text-[11px] uppercase tracking-widest font-bold text-white/50">Screenshots</h2>
        <ScreenshotGallery 
          client:load 
          screenshots={game.screenshots.map((url: string) => getCloudinaryFetchUrl(url, game.isTrending) || url)} 
          title={game.title} 
        />
      </section>
    )}

    <!-- Trailers and Videos -->
    {(() => {
      const embedUrl = formatEmbedVideoUrl(game.trailerUrl);
      return embedUrl ? (
        <section class="border-t border-white/5 pt-12 space-y-6">
          <h2 class="text-[11px] uppercase tracking-widest font-bold text-white/50">Game Trailers & Videos</h2>
          <div class="border border-white/5 bg-[#131316]/50 p-1 aspect-video w-full max-w-3xl mx-auto rounded-2xl overflow-hidden shadow-2xl">
            <iframe
              src={embedUrl}
              title={`${game.title} trailer`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="w-full h-full border border-white/5 rounded-2xl"
            ></iframe>
          </div>
        </section>
      ) : null;
    })()}

    <!-- System Requirements Specifications -->
    {(requirements.min || requirements.rec) && (
      <section class="border-t border-white/5 pt-12 space-y-6">
        <!-- Section header -->
        <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-white/5 border border-white/30 text-[12px] uppercase tracking-[0.18em] font-bold text-white/100">
          PC System Requirements
        </span>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {requirements.min && (() => {
            const lines = cleanRequirementsText(requirements.min).split("\n");
            const rows = lines.map(line => { const parts = line.split(/:(.*)/); return parts.length >= 2 ? { key: parts[0].trim(), val: parts[1].trim() } : { key: null, val: line }; });
            return (
              <div class="group relative">
                <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-[1px]">
                  <div class="rounded-[calc(1rem-1px)] bg-[#0e0e11] overflow-hidden">
                    <!-- Card header -->
                    <div class="px-6 py-4 border-b border-white/[0.06] flex items-center justify-between">
                      <span class="text-sm font-bold uppercase tracking-[0.14em] text-white/60">Minimum</span>
                      <span class="text-[10px] px-2.5 py-0.5 rounded-full border border-white/10 text-white/30 font-medium tracking-wide">It just runs</span>
                    </div>
                    <!-- Rows -->
                    <div class="divide-y divide-white/[0.04]">
                      {rows.map(row => row.key ? (
                        <div class="flex items-start justify-between gap-4 px-6 py-3.5 hover:bg-white/[0.02] transition-colors duration-200">
                          <span class="text-xs font-semibold uppercase tracking-[0.1em] text-neutral-500 whitespace-nowrap pt-[1px] min-w-[72px]">{row.key}</span>
                          <span class="text-sm text-neutral-200 font-medium text-right leading-snug max-w-[58%]">{row.val}</span>
                        </div>
                      ) : (
                        <div class="px-6 py-3">
                          <p class="text-xs text-neutral-500 italic leading-relaxed">{row.val}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            );
          })()}

          {requirements.rec && (() => {
            const lines = cleanRequirementsText(requirements.rec).split("\n");
            const rows = lines.map(line => { const parts = line.split(/:(.*)/); return parts.length >= 2 ? { key: parts[0].trim(), val: parts[1].trim() } : { key: null, val: line }; });
            return (
              <div class="group relative">
                <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-[1px]">
                  <div class="rounded-[calc(1rem-1px)] bg-[#0e0e11] overflow-hidden">
                    <!-- Card header -->
                    <div class="px-6 py-4 border-b border-white/[0.06] flex items-center justify-between">
                      <span class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-400/70">Recommended</span>
                      <span class="text-[10px] px-2.5 py-0.5 rounded-full border border-emerald-500/20 bg-emerald-500/5 text-emerald-400/60 font-medium tracking-wide">Optimal</span>
                    </div>
                    <!-- Rows -->
                    <div class="divide-y divide-white/[0.04]">
                      {rows.map(row => row.key ? (
                        <div class="flex items-start justify-between gap-4 px-6 py-3.5 hover:bg-white/[0.02] transition-colors duration-200">
                          <span class="text-xs font-semibold uppercase tracking-[0.1em] text-neutral-500 whitespace-nowrap pt-[1px] min-w-[72px]">{row.key}</span>
                          <span class="text-sm text-neutral-200 font-medium text-right leading-snug max-w-[58%]">{row.val}</span>
                        </div>
                      ) : (
                        <div class="px-6 py-3">
                          <p class="text-xs text-neutral-500 italic leading-relaxed">{row.val}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            );
          })()}
        </div>
      </section>
    )}

    <!-- Creator games recommendations section -->
    {developers.length > 0 ? (
      <CreatorGames 
        client:load
        creatorIds={developers.map((d: any) => d.id)}
        creatorNames={developers.map((d: any) => d.name)}
        excludeGameId={game.id}
      />
    ) : publishers.length > 0 ? (
      <CreatorGames 
        client:load
        creatorIds={publishers.map((p: any) => p.id)}
        creatorNames={publishers.map((p: any) => p.name)}
        excludeGameId={game.id}
      />
    ) : null}
    </main>

</Layout>
