---
import Layout from '../../layouts/Layout.astro';
import { getSupabaseServer } from '../../lib/supabaseServer';
import { Calendar, Star, Monitor, Clock, Shield, Flame, Tag, ExternalLink } from "lucide-react";
import { getHighResCoverUrl, getCloudinaryFetchUrl, getCategoryBadge, cleanTitle } from '../../lib/utils';

// Import React components
import PlatformLogos from '../../components/PlatformLogos';
import ShareButton from '../../components/ShareButton';
import ScareMeter from '../../components/ScareMeter';
import PriceComparison from '../../components/PriceComparison';
import ScreenshotGallery from '../../components/ScreenshotGallery';
import CreatorGames from '../../components/CreatorGames';
import TrackControls from '../../components/TrackControls';
import VibeTracker from '../../components/VibeTracker';

// SSR: render every game on-demand instead of pre-building a limited static set.
// Cloudflare will cache rendered pages at the edge via Cache-Control headers below,
// so Supabase is only hit once per game per CDN node per 24 hours.
export const prerender = false;

const { slug } = Astro.params;

const supabase = getSupabaseServer();
const { data: game, error } = await supabase
  .from("Game")
  .select(`
    *,
    developers:Developer(id, name, slug),
    publishers:Publisher(id, name, slug),
    genres:Genre(id, name, slug),
    tags:Tag(id, name, slug),
    platforms:Platform(id, name, slug),
    purchaseLinks:PurchaseLink(id, storeName, url)
  `)
  .eq("slug", slug!)
  .maybeSingle();

if (error) {
  console.error(`❌ Error fetching game "${slug}":`, error);
}

if (!game) {
  return Astro.redirect('/404');
}

// Fetch cached prices from PriceSnapshot for instant server rendering
const { data: priceSnapshotsData } = await supabase
  .from("PriceSnapshot")
  .select("*")
  .eq("gameId", game.id);
const priceSnapshots = priceSnapshotsData || [];

// Cache this rendered page at the Cloudflare edge for 24 hours.
// Stale pages are served for up to 7 days while Cloudflare revalidates in the background.
// This means Supabase is only queried once per game per CDN PoP per day.
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=86400, stale-while-revalidate=604800'
);

const purchaseLinks = (game.purchaseLinks as any[]) || [];

// Redirect dry/unenriched itch.io games directly to their itch page (with purchase popup open)
if (game.slug.startsWith("itch-") && !game.rawgEnriched) {
  const itchLink = purchaseLinks.find((link: any) => link.storeName.toLowerCase() === "itch.io");
  if (itchLink && itchLink.url) {
    const directPurchaseUrl = itchLink.url.endsWith("/purchase")
      ? itchLink.url
      : `${itchLink.url.replace(/\/$/, "")}/purchase`;
    return Astro.redirect(directPurchaseUrl);
  }
}

const steamLink = purchaseLinks?.find((link: any) => 
  link.storeName.toLowerCase() === "steam" || link.url.includes("steampowered.com")
);
const steamAppId = steamLink?.url.match(/\/app\/(\d+)/)?.[1] || null;

const ratingDisplay = game.rating ? `${(game.rating / 10).toFixed(1)} / 10` : "No rating yet";
const isItchGame = game.slug.startsWith("itch-");
const hasGogBadge = purchaseLinks?.some((link: any) => link.storeName.toLowerCase() === "gog") || game.slug.startsWith("gog-");

const tags = (game.tags as any[]) || [];
const developers = (game.developers as any[]) || [];
const publishers = (game.publishers as any[]) || [];
const genres = (game.genres as any[]) || [];
const platforms = (game.platforms as any[]) || [];

const requirements = { min: game.minRequirements, rec: game.recRequirements };

function cleanRequirementsText(text: string): string {
  return text
    .replace(/^(Minimum|Recommended|Minimum Requirements|Recommended Requirements):\s*/i, "")
    .trim();
}

// Technical SEO & Structured Data (JSON-LD)
const developerNames = developers.map((d: any) => d.name).join(", ");
const genreNames = genres.map((g: any) => g.name).join(", ");
const cleanTitleName = cleanTitle(game.title);

let seoDescription = `Discover ${cleanTitleName} on hoGAMEGATA. `;
if (developerNames) {
  seoDescription += `Developed by ${developerNames}. `;
}
if (genreNames) {
  seoDescription += `Genre: ${genreNames}. `;
}
if (game.summary) {
  const cleanSummary = game.summary.replace(/<[^>]*>/g, "").substring(0, 120).trim();
  seoDescription += `${cleanSummary}...`;
} else {
  seoDescription += `Check out screenshots, ratings, system requirements, and cheapest store prices/purchase links.`;
}
if (seoDescription.length > 160) {
  seoDescription = seoDescription.substring(0, 157) + "...";
}

let ogImage = game.coverUrl ? getHighResCoverUrl(game.coverUrl) : null;
if (ogImage && ogImage.startsWith("//")) {
  ogImage = "https:" + ogImage;
}
const ogUrl = `https://gamegata.xyz/game/${game.slug}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  "name": cleanTitleName,
  "description": game.summary ? game.summary.replace(/<[^>]*>/g, "").substring(0, 300).trim() + "..." : undefined,
  "image": ogImage,
  "genre": genres.map((g: any) => g.name),
  "gamePlatform": platforms.map((p: any) => p.name),
  "author": developerNames ? {
    "@type": "Organization",
    "name": developerNames
  } : undefined,
  "publisher": publishers.map((pub: any) => ({
    "@type": "Organization",
    "name": pub.name
  })),
  "datePublished": game.releaseDate ? new Date(game.releaseDate).toISOString().split('T')[0] : undefined,
  "aggregateRating": game.rating ? {
    "@type": "AggregateRating",
    "ratingValue": (game.rating / 10).toFixed(1),
    "bestRating": "10",
    "worstRating": "1",
    "ratingCount": 1
  } : undefined,
  "offers": priceSnapshots.map((snap: any) => ({
    "@type": "Offer",
    "price": snap.dealPrice,
    "priceCurrency": snap.currency || "USD",
    "url": snap.dealUrl,
    "category": "retail",
    "seller": {
      "@type": "Organization",
      "name": snap.storeName
    }
  }))
};
const schemaJson = JSON.stringify(schema);
---

<Layout 
  title={`${cleanTitleName} | hoGAMEGATA`} 
  description={seoDescription}
  ogImage={ogImage}
  ogUrl={ogUrl}
  ogType="video.other"
  withSearch={true}
>
  <script type="application/ld+json" is:inline set:html={schemaJson} />
  <VibeTracker client:load tags={tags} genres={genres} />

  <main class="max-w-5xl mx-auto px-6 mt-12 space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Left Column: Cover Art and Quick Specs -->
      <div class="md:col-span-1 space-y-6">
        <div class={`border border-white bg-black p-1 rounded-none overflow-hidden shrink-0 relative w-full ${
          isItchGame ? "aspect-[5/4]" : "aspect-[3/4]"
        }`}>
          {game.coverUrl ? (
            <div class="relative w-full h-full">
              <img 
                src={getCloudinaryFetchUrl(getHighResCoverUrl(game.coverUrl), game.isTrending) || ""} 
                alt={game.title} 
                class="object-cover w-full h-full border border-white"
              />
            </div>
          ) : (
            <div class="w-full h-full bg-gradient-to-b from-white/10 to-black flex items-center justify-center border border-white">
              <span class="font-mono text-xs uppercase tracking-widest text-white">No Cover Art</span>
            </div>
          )}
          {(() => {
            const badge = getCategoryBadge(game.category, game.title);
            if (!badge || badge === "Visual Novel") return null;
            return (
              <span class="absolute top-3 left-3 font-mono text-[8px] uppercase tracking-widest border font-black px-1.5 py-0.5 z-10 bg-[#7f1d1d] text-[#fca5a5] border-[#fca5a5]">
                {badge}
              </span>
            );
          })()}
        </div>

        <div class="border border-white bg-black p-5 space-y-4 font-mono text-xs font-bold uppercase">
          <span class="font-mono text-[9px] text-white/50 tracking-widest block border-b border-white/20 pb-1">Quick Specs</span>
          
          <div class="flex justify-between items-center">
            <span class="text-white flex items-center gap-1.5"><Calendar class="w-3.5 h-3.5" /> Release:</span>
            <span class="text-white font-black">
              {game.releaseDate ? new Date(game.releaseDate).toLocaleDateString("en-US", { year: "numeric", month: "short" }) : "N/A"}
            </span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-white flex items-center gap-1.5"><Star class="w-3.5 h-3.5" /> Avg. Rating:</span>
            <span class="text-white font-black">{ratingDisplay}</span>
          </div>

          {game.steamRating !== null && (
            <div class="flex justify-between items-center">
              <span class="text-white flex items-center gap-1.5"><Star class="w-3.5 h-3.5" /> [STEAM]</span>
              <span class="text-white font-black text-right">
                {game.steamRating.toFixed(1)}/10 <span class="text-white/50 text-[10px] font-bold">[{game.steamRatingDesc}]</span>
              </span>
            </div>
          )}

          {game.scareRating !== null && (
            <div class="flex justify-between items-center border-t border-white/20 pt-3 mt-1">
              <span class="text-white flex items-center gap-1.5"><Flame class="w-3.5 h-3.5" /> SCARE SCORE:</span>
              <span class="text-white font-black text-right">
                {game.scareRating} / 100
              </span>
            </div>
          )}

          <div class="flex justify-between items-center gap-4">
            <span class="text-white flex items-center gap-1.5 shrink-0"><Monitor class="w-3.5 h-3.5" /> Platforms:</span>
            <PlatformLogos platforms={platforms} class="flex flex-wrap justify-end gap-2" solid={true} />
          </div>

          {steamAppId && (
            <div class="flex justify-between items-baseline gap-2">
              <span class="text-white flex items-center gap-1.5 shrink-0">
                <Monitor class="w-3.5 h-3.5" /> Linux compatibility:
              </span>
              <div class="text-right">
                {game.protonDbTier ? (
                  <a
                    href={`https://www.protondb.com/app/${steamAppId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex flex-col items-end gap-1"
                    title={
                      game.protonDbConfidence && game.protonDbTotalReports
                        ? `${game.protonDbConfidence} confidence rating based on ${game.protonDbTotalReports} report(s)`
                        : "View detailed Linux compatibility reports on ProtonDB"
                    }
                  >
                    <span class={`font-mono text-[9px] uppercase tracking-wider px-1.5 py-0.5 ${
                      game.protonDbTier === "native" || game.protonDbTier === "platinum"
                        ? "bg-emerald-500 text-black font-black"
                        : game.protonDbTier === "gold"
                        ? "bg-white text-black font-black"
                        : game.protonDbTier === "silver"
                        ? "border border-white text-white font-bold"
                        : game.protonDbTier === "bronze" || game.protonDbTier === "borked"
                        ? "border border-red-500 text-red-500 line-through font-bold"
                        : "border border-white/20 text-white/40 font-bold"
                    }`}>
                      {game.protonDbTier}
                    </span>
                    {game.protonDbTotalReports !== null && game.protonDbTotalReports > 0 && (
                      <span class="text-[9px] text-white/50 font-bold tracking-tight lowercase">
                        ({game.protonDbTotalReports} reports)
                      </span>
                    )}
                  </a>
                ) : (
                  <span class="text-white/30 font-mono italic">[ Syncing ]</span>
                )}
              </div>
            </div>
          )}

          {game.playtime !== null && game.playtime > 0 && (
            <div class="flex justify-between items-center">
              <span class="text-white flex items-center gap-1.5"><Clock class="w-3.5 h-3.5" /> Playtime:</span>
              <span class="text-white font-black">{game.playtime} hrs</span>
            </div>
          )}

          {game.esrbRating && (
            <div class="flex justify-between items-center">
              <span class="text-white flex items-center gap-1.5"><Shield class="w-3.5 h-3.5" /> ESRB:</span>
              <span class="text-white font-black">{game.esrbRating}</span>
            </div>
          )}

          {game.metacritic !== null && (
            <div class="flex justify-between items-center">
              <span class="text-white flex items-center gap-1.5"><Star class="w-3.5 h-3.5" /> Metacritic:</span>
              {game.metacriticUrl ? (
                <a 
                  href={game.metacriticUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white hover:underline font-black flex items-center gap-1 group/meta"
                >
                  <span>{game.metacritic} / 100</span>
                  <ExternalLink class="w-2.5 h-2.5 opacity-65 group-hover/meta:opacity-100" />
                </a>
              ) : (
                <span class="text-white font-black">{game.metacritic} / 100</span>
              )}
            </div>
          )}
        </div>
      </div>

      <!-- Right Column: Game Header details, controls, description -->
      <div class="md:col-span-2 flex flex-col justify-between md:h-full">
        <div class="space-y-4 mb-6">
          <div class="flex flex-wrap items-center gap-2">
            {game.status && game.status.trim() !== "" && (
              <span class="font-mono text-[9px] text-white uppercase tracking-widest border border-white px-2 py-0.5 font-bold bg-white text-black w-fit block">
                {game.status}
              </span>
            )}
            {(() => {
              const badge = getCategoryBadge(game.category, game.title);
              if (!badge) return null;
              const isVN = badge === "Visual Novel";
              const borderClass = isVN ? "border-[#581c87]" : "border-[#7f1d1d]";
              const bgClass = isVN ? "bg-[#581c87] text-[#f5d0fe]" : "bg-[#7f1d1d] text-[#fca5a5]";
              return (
                <span class={`font-mono text-[9px] uppercase tracking-widest border px-2 py-0.5 font-bold w-fit block ${borderClass} ${bgClass}`}>
                  {badge}
                </span>
              );
            })()}
            {game.slug.startsWith("itch-") && (
              <span class="font-mono text-[9px] text-black uppercase tracking-widest border border-[#fa5c5c] px-2 py-0.5 font-bold bg-[#fa5c5c] w-fit block">
                itch.io
              </span>
            )}
            {hasGogBadge && (
              <span class="font-mono text-[9px] text-white uppercase tracking-widest border border-[#7b3fc4] px-2 py-0.5 font-bold bg-[#7b3fc4] w-fit block">
                DRM-Free
              </span>
            )}
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight uppercase leading-tight">
              {cleanTitle(game.title)}
            </h1>
            <ShareButton client:load />
          </div>
          <div class="flex flex-wrap gap-2 text-xs font-mono font-bold uppercase">
            <span class="text-white/60">Developed by:</span>
            <span class="text-white font-black">{developers.map((d: any) => d.name).join(", ")}</span>
            {publishers.length > 0 && (
              <>
                <span class="text-white/60 ml-2">Published by:</span>
                <span class="text-white font-black">{publishers.map((p: any) => p.name).join(", ")}</span>
              </>
            )}
          </div>
        </div>

        <div class="flex-grow flex flex-col justify-end gap-4">
          {(() => {
            const itchLink = purchaseLinks?.find((link: any) => link.storeName.toLowerCase() === "itch.io");
            if (itchLink && itchLink.url) {
              const directPurchaseUrl = itchLink.url.endsWith("/purchase")
                ? itchLink.url
                : `${itchLink.url.replace(/\/$/, "")}/purchase`;
              return (
                <a
                  href={`/re/${game.slug}/itchio?gameId=${game.id}&fallbackUrl=${encodeURIComponent(directPurchaseUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-2 px-4 py-3 bg-[#fa5c5c] text-black font-mono text-xs uppercase tracking-widest font-black transition-all duration-150 hover:bg-[#ff7676] select-none rounded-none border border-[#fa5c5c]"
                >
                  <ExternalLink class="w-3.5 h-3.5 text-black" />
                  <span>Buy / Download on itch.io</span>
                </a>
              );
            }
            return null;
          })()}
          
          <TrackControls
            client:load
            gameId={game.id}
            gameSlug={game.slug}
            gameTitle={game.title}
            genres={genres.map((g: any) => g.name)}
            siteRating={game.rating ? game.rating / 10 : null}
            steamRating={game.steamRating}
          />
        </div>
      </div>
    </div>

    <!-- Details Section -->
    <div class="space-y-12 mt-12">
      {/* Dynamic contents dependent on itch vs regular */}
      {isItchGame ? (
        <>
          <!-- Mood Section -->
          {tags && tags.length > 0 && (
            <div class="pt-6 flex flex-wrap gap-4 items-center">
              <h2 class="flex items-center gap-1.5 font-mono text-[10px] text-white uppercase tracking-widest font-black">
                <Tag class="w-3.5 h-3.5" /> Mood/Genre
              </h2>
              <div class="flex flex-wrap gap-2">
                {tags.map((t: any) => (
                  <span class="bg-white text-black font-mono text-[9px] uppercase tracking-wider px-2.5 py-0.5 font-bold border border-white">
                    {t.name}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Price comparison deals -->
          <PriceComparison
            client:load
            gameId={game.id}
            gameSlug={game.slug}
            gameTitle={game.title}
            purchaseLinks={purchaseLinks}
            initialDeals={priceSnapshots}
          />

          <!-- Official/Creator Links -->
          { (purchaseLinks?.length > 0 || game.websiteUrl || game.redditUrl || game.rawgSlug) && (
            <div class="pt-6 space-y-4">
              <h2 class="font-mono text-xs text-white uppercase tracking-widest font-black block">Official & Creator Links</h2>
              <div class="flex flex-wrap gap-3">
                {purchaseLinks?.map((link: any) => (
                  <a
                    href={`/re/${game.slug}/${link.storeName.toLowerCase().replace(/[^a-z0-9]/g, "")}?gameId=${game.id}&fallbackUrl=${encodeURIComponent(link.url)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 font-mono text-[10px] text-white hover:bg-white hover:text-black uppercase tracking-wider transition-all duration-150 border border-white px-3 py-2 font-bold"
                  >
                    <ExternalLink class="w-3.5 h-3.5 text-white group-hover:text-black" />
                    <span>Support Creator ({link.storeName})</span>
                  </a>
                ))}

                {game.websiteUrl && (
                  <a
                    href={game.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 font-mono text-[10px] text-white hover:bg-white hover:text-black uppercase tracking-wider transition-all duration-150 border border-white px-3 py-2 font-bold"
                  >
                    <ExternalLink class="w-3.5 h-3.5 text-white group-hover:text-black" />
                    <span>Official Website</span>
                  </a>
                )}

                {game.redditUrl && (
                  <a
                    href={game.redditUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 font-mono text-[10px] text-white hover:bg-white hover:text-black uppercase tracking-wider transition-all duration-150 border border-white px-3 py-2 font-bold"
                  >
                    <ExternalLink class="w-3.5 h-3.5 text-white group-hover:text-black" />
                    <span>Reddit Community</span>
                  </a>
                )}

                {game.rawgSlug && (
                  <a
                    href={`https://rawg.io/games/${game.rawgSlug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 font-mono text-[10px] text-white/70 hover:bg-white hover:text-black uppercase tracking-wider transition-all duration-150 border border-white/50 hover:border-white px-3 py-2 font-bold"
                  >
                    <ExternalLink class="w-3.5 h-3.5 text-white/70 group-hover:text-black" />
                    <span>RAWG Profile</span>
                  </a>
                )}
              </div>
            </div>
          )}

          <!-- Description Section -->
          <div class="pt-6 space-y-4 select-none">
            <h2 class="font-mono text-xs text-white uppercase tracking-widest font-black block">Description & Overview</h2>
            {game.summary ? (
              <div 
                class="text-sm text-white font-medium leading-relaxed font-sans prose prose-invert max-w-none"
                set:html={game.summary}
              />
            ) : (
              <p class="text-sm text-white font-medium leading-relaxed font-sans">
                No overview available for this title.
              </p>
            )}
            {game.storyline && (
              <div class="mt-4 pt-4 border-t border-white/20">
                <span class="font-mono text-[9px] text-white/50 uppercase tracking-widest block mb-2 font-bold">Storyline</span>
                <p class="text-xs text-white leading-relaxed font-sans font-medium">
                  {game.storyline}
                </p>
              </div>
            )}
          </div>

          <!-- Scare Profile -->
          {game.scareRating !== null && game.scareProfile && (
            <div class="pt-6">
              <ScareMeter 
                client:load
                scareRating={game.scareRating} 
                scareProfile={game.scareProfile as any} 
                reviewCount={game.scareReviewCount}
              />
            </div>
          )}
        </>
      ) : (
        <>
          <!-- Description Section -->
          <div class="pt-6 space-y-4 select-none">
            <h2 class="font-mono text-xs text-white uppercase tracking-widest font-black block">Description & Overview</h2>
            {game.summary ? (
              <div 
                class="text-sm text-white font-medium leading-relaxed font-sans prose prose-invert max-w-none"
                set:html={game.summary}
              />
            ) : (
              <p class="text-sm text-white font-medium leading-relaxed font-sans">
                No overview available for this title.
              </p>
            )}
            {game.storyline && (
              <div class="mt-4 pt-4 border-t border-white/20">
                <span class="font-mono text-[9px] text-white/50 uppercase tracking-widest block mb-2 font-bold">Storyline</span>
                <p class="text-xs text-white leading-relaxed font-sans font-medium">
                  {game.storyline}
                </p>
              </div>
            )}
          </div>

          <!-- Mood Section -->
          {tags && tags.length > 0 && (
            <div class="pt-6 flex flex-wrap gap-4 items-center">
              <h2 class="flex items-center gap-1.5 font-mono text-[10px] text-white uppercase tracking-widest font-black">
                <Tag class="w-3.5 h-3.5" /> Mood/Genre
              </h2>
              <div class="flex flex-wrap gap-2">
                {tags.map((t: any) => (
                  <span class="bg-white text-black font-mono text-[9px] uppercase tracking-wider px-2.5 py-0.5 font-bold border border-white">
                    {t.name}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Scare Profile -->
          {game.scareRating !== null && game.scareProfile && (
            <div class="pt-6">
              <ScareMeter 
                client:load
                scareRating={game.scareRating} 
                scareProfile={game.scareProfile as any} 
                reviewCount={game.scareReviewCount}
              />
            </div>
          )}

          <!-- Price comparison deals -->
          <PriceComparison
            client:load
            gameId={game.id}
            gameSlug={game.slug}
            gameTitle={game.title}
            purchaseLinks={purchaseLinks}
            initialDeals={priceSnapshots}
          />

          <!-- Official/Creator Links -->
          { (purchaseLinks?.length > 0 || game.websiteUrl || game.redditUrl || game.rawgSlug) && (
            <div class="pt-6 space-y-4">
              <h2 class="font-mono text-xs text-white uppercase tracking-widest font-black block">Official & Creator Links</h2>
              <div class="flex flex-wrap gap-3">
                {purchaseLinks?.map((link: any) => (
                  <a
                    href={`/re/${game.slug}/${link.storeName.toLowerCase().replace(/[^a-z0-9]/g, "")}?gameId=${game.id}&fallbackUrl=${encodeURIComponent(link.url)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 font-mono text-[10px] text-white hover:bg-white hover:text-black uppercase tracking-wider transition-all duration-150 border border-white px-3 py-2 font-bold"
                  >
                    <ExternalLink class="w-3.5 h-3.5 text-white group-hover:text-black" />
                    <span>Support Creator ({link.storeName})</span>
                  </a>
                ))}

                {game.websiteUrl && (
                  <a
                    href={game.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 font-mono text-[10px] text-white hover:bg-white hover:text-black uppercase tracking-wider transition-all duration-150 border border-white px-3 py-2 font-bold"
                  >
                    <ExternalLink class="w-3.5 h-3.5 text-white group-hover:text-black" />
                    <span>Official Website</span>
                  </a>
                )}

                {game.redditUrl && (
                  <a
                    href={game.redditUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 font-mono text-[10px] text-white hover:bg-white hover:text-black uppercase tracking-wider transition-all duration-150 border border-white px-3 py-2 font-bold"
                  >
                    <ExternalLink class="w-3.5 h-3.5 text-white group-hover:text-black" />
                    <span>Reddit Community</span>
                  </a>
                )}

                {game.rawgSlug && (
                  <a
                    href={`https://rawg.io/games/${game.rawgSlug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 font-mono text-[10px] text-white/70 hover:bg-white hover:text-black uppercase tracking-wider transition-all duration-150 border border-white/50 hover:border-white px-3 py-2 font-bold"
                  >
                    <ExternalLink class="w-3.5 h-3.5 text-white/70 group-hover:text-black" />
                    <span>RAWG Profile</span>
                  </a>
                )}
              </div>
            </div>
          )}
        </>
      )}
    </div>

    <!-- Screenshots Gallery -->
    {game.screenshots && game.screenshots.length > 0 && (
      <section class="border-t border-white pt-12 space-y-6">
        <h2 class="font-mono text-xs text-white uppercase tracking-widest font-black">Screenshots</h2>
        <ScreenshotGallery 
          client:load 
          screenshots={game.screenshots.map((url: string) => getCloudinaryFetchUrl(url, game.isTrending) || url)} 
          title={game.title} 
        />
      </section>
    )}

    <!-- Trailers and Videos -->
    {game.trailerUrl && (
      <section class="border-t border-white pt-12 space-y-6">
        <h2 class="font-mono text-xs text-white uppercase tracking-widest font-black">Game trailers and videos</h2>
        <div class="border border-white bg-black p-1 aspect-video w-full max-w-3xl mx-auto">
          <iframe
            src={game.trailerUrl}
            title={`${game.title} trailer`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="w-full h-full border border-white"
          ></iframe>
        </div>
      </section>
    )}

    <!-- System Requirements Specifications -->
    {(requirements.min || requirements.rec) && (
      <section class="border-t border-white pt-12 space-y-6">
        <h2 class="font-mono text-[10px] text-white uppercase tracking-widest font-black font-bold">PC System Specifications</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {requirements.min && (
            <div class="border border-white bg-black p-6 space-y-4 rounded-none">
              <span class="font-mono text-[9px] bg-white text-black px-2 py-0.5 uppercase tracking-widest inline-block font-black">Minimum Requirements</span>
              <div class="text-xs text-white leading-relaxed font-mono space-y-2.5 pt-2">
                {cleanRequirementsText(requirements.min).split("\n").map((line) => {
                  const parts = line.split(/:(.*)/);
                  if (parts.length >= 2) {
                    return (
                      <div class="flex flex-col sm:flex-row sm:justify-between border-b border-white/10 pb-1.5 gap-1">
                        <span class="text-white/60 font-bold tracking-wider uppercase text-[10px]">{parts[0].trim()}</span>
                        <span class="text-white font-black text-right">{parts[1].trim()}</span>
                      </div>
                    );
                  }
                  return <p class="text-white font-medium pl-1">{line}</p>;
                })}
              </div>
            </div>
          )}
          {requirements.rec && (
            <div class="border border-white bg-black p-6 space-y-4 rounded-none">
              <span class="font-mono text-[9px] bg-white text-black px-2 py-0.5 uppercase tracking-widest inline-block font-black">Recommended Requirements</span>
              <div class="text-xs text-white leading-relaxed font-mono space-y-2.5 pt-2">
                {cleanRequirementsText(requirements.rec).split("\n").map((line) => {
                  const parts = line.split(/:(.*)/);
                  if (parts.length >= 2) {
                    return (
                      <div class="flex flex-col sm:flex-row sm:justify-between border-b border-white/10 pb-1.5 gap-1">
                        <span class="text-white/60 font-bold tracking-wider uppercase text-[10px]">{parts[0].trim()}</span>
                        <span class="text-white font-black text-right">{parts[1].trim()}</span>
                      </div>
                    );
                  }
                  return <p class="text-white font-medium pl-1">{line}</p>;
                })}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Creator games recommendations section -->
    {developers.length > 0 ? (
      <CreatorGames 
        client:load
        creatorIds={developers.map((d: any) => d.id)}
        creatorNames={developers.map((d: any) => d.name)}
        excludeGameId={game.id}
      />
    ) : publishers.length > 0 ? (
      <CreatorGames 
        client:load
        creatorIds={publishers.map((p: any) => p.id)}
        creatorNames={publishers.map((p: any) => p.name)}
        excludeGameId={game.id}
      />
    ) : null}
  </main>
</Layout>
