---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import GameCatalogClient from '../components/GameCatalogClient';
import { getDefaultContentMap } from '../lib/siteContent';
import { getCatalogStats } from '../lib/catalogMeta';
import defaultFeed from '../data/homepage-feed.json';
import fallbackGames from '../data/homepageFallback.json';

let feed = defaultFeed as any;

// Optional build-time revalidation via jsDelivr CDN
try {
  const JSDELIVR_FEED_URL = "https://cdn.jsdelivr.net/gh/project-hgg/project-hgg.github.io@main/docs/public/homepage-feed.json";
  const cdnRes = await fetch(JSDELIVR_FEED_URL, {
    headers: { 'Accept': 'application/json' },
    signal: AbortSignal.timeout(1200)
  });
  if (cdnRes.ok) {
    const liveFeed = await cdnRes.json();
    if (liveFeed && liveFeed.heroGames && liveFeed.heroGames.length > 0) {
      feed = liveFeed;
    }
  }
} catch {
  // Silent fallback to bundled feed
}

const content = getDefaultContentMap();
const catalogStats = getCatalogStats();
const stats = {
  games: feed.stats?.games || catalogStats.totalVisibleGames || 109420,
  developers: feed.stats?.developers || catalogStats.totalDevelopers || 68034,
  tags: feed.stats?.tags || catalogStats.totalTags || 15825,
  deals: feed.stats?.deals || catalogStats.totalDeals || 111168,
};

const heroGames = (feed.heroGames && feed.heroGames.length > 0)
  ? feed.heroGames
  : (fallbackGames as any[]).filter((g: any) => g.screenshots && g.screenshots.length > 0).slice(0, 10);
const latestGames = feed.latestGames || [];
const trendingGames = feed.trendingGames || [];
const upcomingGames = feed.upcomingGames || [];
const topRatedGames = feed.topRatedGames || [];

// Extract dedicated itch horror games from feed arrays (100% static, no DB calls)
const allFeedGames = [
  ...(feed.heroGames || []),
  ...(feed.trendingGames || []),
  ...(feed.latestGames || []),
  ...(feed.topRatedGames || []),
  ...(feed.upcomingGames || []),
  ...(fallbackGames as any[] || [])
];
const itchSeen = new Set<string>();
const itchGames = allFeedGames.filter((g: any) => {
  if (!g || !g.id || itchSeen.has(g.id)) return false;
  const isItch = g.slug?.startsWith("itch-");
  if (isItch) {
    itchSeen.add(g.id);
    return true;
  }
  return false;
}).slice(0, 8);

// Set up cursor for client-side pagination fallback (Latest tab initial set)
let nextCursor: string | null = null;
if (latestGames.length > 0) {
  const lastGame = latestGames[latestGames.length - 1];
  nextCursor = lastGame ? `${lastGame.releaseDate ? new Date(lastGame.releaseDate).getTime() : "null"}_${lastGame.id}` : null;
}
---

<Layout
  title={content.hero_title ? `${content.hero_title} | Horror Game Database (107,000+ Titles)` : "hoGAMEGATA | The Horror Game Database (107,000+ Titles)"}
  description={content.hero_subtitle || "Discover 107,000+ horror games, 68,000+ developers, and 430,000+ screenshots. hoGAMEGATA is the definitive open, ad-free metadata registry for survival horror, psychological terror, and indie nightmare games."}
  withSearch={false}
  statsGames={stats?.games}
  statsDevelopers={stats?.developers}
  statsDeals={stats?.deals}
  statsTags={stats?.tags}
>
  <main class="max-w-5xl mx-auto px-6 mt-6 flex-1 pb-16 sm:pb-20 w-full">
    <GameCatalogClient
      client:only="react"
      initialGames={latestGames}
      initialTotalGames={stats?.games || null}
      initialNextCursor={nextCursor}
      heroGames={heroGames}
      latestGames={latestGames}
      trendingGames={trendingGames}
      upcomingGames={upcomingGames}
      topRatedGames={topRatedGames}
      itchGames={itchGames}
      catalogueTitle={content.catalogue_title}
      catalogueDesc={content.catalogue_desc}
      supportTitle={content.support_title}
      supportDesc={content.support_desc}
    >
      <div slot="fallback" class="w-full space-y-8 animate-pulse py-4">
        <div class="h-64 sm:h-72 bg-white/5 rounded-3xl border border-white/10 w-full flex items-center justify-center">
          <div class="w-8 h-8 border-2 border-white/20 border-t-white rounded-full animate-spin"></div>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="h-52 bg-white/5 rounded-2xl border border-white/10"></div>
          <div class="h-52 bg-white/5 rounded-2xl border border-white/10"></div>
          <div class="h-52 bg-white/5 rounded-2xl border border-white/10"></div>
          <div class="h-52 bg-white/5 rounded-2xl border border-white/10"></div>
        </div>
      </div>
    </GameCatalogClient>
  </main>
</Layout>

