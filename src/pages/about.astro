---
import Layout from '../layouts/Layout.astro';
import ReturnButton from '../components/ReturnButton';

const faqList = [
  {
    q: "What is hoGAMEGATA?",
    a: "hoGAMEGATA (also known as hGG) is an ad-free database and discovery tool for horror games. It tracks over 18,000 titles, including survival horror, psychological terror, and indie releases."
  },
  {
    q: "Why focus only on horror games?",
    a: "Horror is a unique genre that relies heavily on mood, sound design, and tension. General game sites often lump horror games under broad action or indie categories. hoGAMEGATA organizes games specifically around horror sub-genres, platforms, and features."
  },
  {
    q: "Is hoGAMEGATA free to use?",
    a: "Yes. hoGAMEGATA is completely free and non-commercial. There are no ads, paywalls, or tracking scripts. You can search and explore the entire catalog without creating an account."
  },
  {
    q: "How are ratings calculated?",
    a: "Ratings combine review scores from IGDB, Steam, Metacritic, and RAWG. We use a weighted average so that niche games with a single positive review don't skew the top-rated lists."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title="About | hoGAMEGATA" 
  description="Learn about hoGAMEGATA (hGG), an ad-free, minimalist horror game database and discovery catalog." 
  withSearch={false} 
  withLink={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <main class="flex-1 max-w-4xl w-full mx-auto px-6 py-12 pb-24 flex flex-col gap-12 font-sans text-neutral-300">
    
    <!-- Top Bar -->
    <div class="flex justify-between items-center border-b border-white/10 pb-6">
      <div class="flex flex-col">
        <span class="font-mono text-xs uppercase tracking-widest text-white/50">by aurostron</span>
        <span class="font-mono text-[9px] text-white/30 uppercase tracking-widest">on 21st June, 2026</span>
      </div>
      <ReturnButton client:only="react" />
    </div>

    <!-- Page Header -->
    <div class="space-y-4">
      <h1 class="font-sans font-black text-4xl sm:text-6xl uppercase tracking-tight text-white">
        About hoGAMEGATA
      </h1>
      <p class="text-base sm:text-lg text-neutral-300 leading-relaxed font-normal">
        hoGAMEGATA (also known as hGG) is a minimalist, fast database built specifically for horror games. It catalogs over 18,000 titles with detailed metadata, release dates, and store pricing.
      </p>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm leading-relaxed">
      
      <!-- Philosophy -->
      <div class="border border-white/10 bg-[#0a0a0c] p-6 space-y-4">
        <h2 class="text-white font-bold text-base uppercase tracking-wide border-b border-white/10 pb-2">
          The Philosophy
        </h2>
        <p>
          Horror is a genre built around tension, atmosphere, and sound design. Standard game databases treat horror as just another filter tag, mixing terrifying games with casual titles.
        </p>
        <p>
          hoGAMEGATA focuses entirely on horror. Our catalog organizes games by sub-genres, platforms, scare factors, and developer histories to make finding your next game straightforward.
        </p>
      </div>

      <!-- Preservation -->
      <div class="border border-white/10 bg-[#0a0a0c] p-6 space-y-4">
        <h2 class="text-white font-bold text-base uppercase tracking-wide border-b border-white/10 pb-2">
          Preservation & Privacy
        </h2>
        <p>
          hoGAMEGATA is completely non-commercial. We don't display ads, sell user data, or hide features behind subscriptions.
        </p>
        <p>
          We preserve horror gaming history—from classic DOS titles and PlayStation games to modern indie releases and upcoming AAA titles. No account is required to browse or search.
        </p>
      </div>

    </div>

    <!-- Rating System Section -->
    <div class="border border-white/10 bg-[#0a0a0c] p-6 sm:p-8 space-y-4 text-sm leading-relaxed">
      <h2 class="text-white font-bold text-base uppercase tracking-wide border-b border-white/10 pb-2">
        Rating System
      </h2>
      <p>
        We combine ratings from multiple platforms (IGDB, Steam, Metacritic, and RAWG) into a single score. To keep smaller, less popular games with a single high review from dominating the top lists, we use a weighted Bayesian rating model that accounts for the total number of reviews.
      </p>
    </div>

    <!-- FAQ Section -->
    <div class="space-y-6">
      <h2 class="text-white font-bold text-xl uppercase tracking-tight border-b border-white/10 pb-3">
        Frequently Asked Questions
      </h2>

      <div class="space-y-4">
        {faqList.map((item) => (
          <div class="border border-white/10 bg-[#0a0a0c] p-5 space-y-2 text-sm">
            <h3 class="text-white font-bold">
              {item.q}
            </h3>
            <p class="text-neutral-300 leading-relaxed">
              {item.a}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Data Provider & Third-Party Credits (Exact Original) -->
    <div class="space-y-6 font-sans text-sm text-gray-300 leading-relaxed">
      <div class="border-b border-white/10 pb-3">
        <h2 class="font-sans font-black text-xl uppercase tracking-tight text-white">Data Sources & Attribution</h2>
      </div>
      <p>
        Data provided by  <a href="https://www.igdb.com" target="_blank" rel="noopener noreferrer" class="text-white hover:underline font-bold">IGDB</a>.
      </p>
      <p>
        Reviews taken from <a href="https://store.steampowered.com" target="_blank" rel="noopener noreferrer" class="text-white hover:underline font-bold">Steam</a>. 
       </p>
      <p>
         Linux compatibility data by <a href="https://www.protondb.com" target="_blank" rel="noopener noreferrer" class="text-white hover:underline font-bold">ProtonDB</a>.
      </p>
      <p>
        This platform is built using <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-white hover:underline font-bold font-bold">Astro</a>, <a href="https://react.dev" target="_blank" rel="noopener noreferrer" class="text-white hover:underline font-bold font-bold">React</a>, and <a href="https://orm.drizzle.team" target="_blank" rel="noopener noreferrer" class="text-white hover:underline font-bold font-bold">Drizzle ORM</a>.
      </p>
    </div>

  </main>
</Layout>
