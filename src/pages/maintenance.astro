---
// Isolated maintenance page - no layout dependency to avoid hitting the DB if it is down!
layout: null;

Astro.response.status = 503;
Astro.response.headers.set('Retry-After', '3600'); // Suggest retry in 1 hour
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>hoGAMEGATA | Maintenance</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
  
  <style>
    :root {
      --background: #030303;
      --foreground: #f3f4f6;
      --accent: #ff2a2a;
      --accent-muted: #800f0f;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--background);
      color: var(--foreground);
      font-family: 'Montserrat', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    /* Cyberpunk Grid Background */
    .grid-bg {
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background-image: 
        linear-gradient(rgba(255, 42, 42, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 42, 42, 0.05) 1px, transparent 1px);
      background-size: 50px 50px;
      background-position: center;
      transform-origin: top center;
      animation: grid-scroll 20s linear infinite;
      opacity: 0.4;
      pointer-events: none;
      z-index: 1;
      will-change: transform;
    }

    @keyframes grid-scroll {
      0% {
        transform: perspective(500px) rotateX(60deg) translateY(-10%) translate3d(0, 0, 0);
      }
      100% {
        transform: perspective(500px) rotateX(60deg) translateY(-10%) translate3d(0, 50px, 0);
      }
    }

    /* Glow Overlay */
    .glow-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, transparent 20%, rgba(3, 3, 3, 0.9) 80%);
      z-index: 2;
      pointer-events: none;
    }

    /* Central card */
    .content {
      position: relative;
      z-index: 10;
      text-align: center;
      max-width: 500px;
      padding: 2.5rem;
      border: 1px solid rgba(255, 42, 42, 0.2);
      background-color: rgba(6, 6, 6, 0.85);
      backdrop-filter: blur(10px);
      box-shadow: 0 0 40px rgba(255, 42, 42, 0.08);
      margin: 20px;
    }

    /* CRT Scanlines removed for clear text */

    /* Logo Styling */
    .logo {
      font-weight: 900;
      font-size: 2.25rem;
      letter-spacing: -0.05em;
      margin-bottom: 1.5rem;
      text-transform: uppercase;
      color: #ffffff;
      display: inline-block;
    }

    .logo span {
      font-style: italic;
      color: #ffffff;
      opacity: 0.9;
    }

    /* Red glitch line */
    .status-badge {
      font-family: 'Share Tech Mono', monospace;
      color: var(--accent);
      border: 1px solid var(--accent);
      background-color: rgba(255, 42, 42, 0.05);
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      display: inline-block;
      margin-bottom: 2rem;
      animation: pulse 2s infinite ease-in-out;
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 0.7;
        box-shadow: 0 0 5px rgba(255, 42, 42, 0.1);
      }
      50% {
        opacity: 1;
        box-shadow: 0 0 15px rgba(255, 42, 42, 0.3);
      }
    }

    /* Description */
    h2 {
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    p {
      color: rgba(255, 255, 255, 0.5);
      font-size: 0.85rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      font-weight: 500;
    }

    /* Progress Dot Pulse */
    .loader {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-bottom: 1rem;
    }

    .dot {
      width: 6px;
      height: 6px;
      background-color: var(--accent);
      animation: loader-dot 1.4s infinite ease-in-out both;
    }

    .dot:nth-child(1) { animation-delay: -0.32s; }
    .dot:nth-child(2) { animation-delay: -0.16s; }

    @keyframes loader-dot {
      0%, 80%, 100% { 
        transform: scale(0);
        opacity: 0.3;
      } 
      40% { 
        transform: scale(1);
        opacity: 1;
        box-shadow: 0 0 8px var(--accent);
      }
    }

    /* Footer Meta info */
    .footer-note {
      font-family: 'Share Tech Mono', monospace;
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.25);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-top: 1rem;
    }
  </style>
</head>
<body>

  <!-- Cyber Grid Background -->
  <div class="grid-bg"></div>
  <div class="glow-overlay"></div>

  <!-- Main Card -->
  <div class="content">
    <h1 class="logo"><span>ho</span>GAMEGATA.</h1>
    
    <div>
      <div class="status-badge">UNDER MAINTENANCE</div>
    </div>
    
    <h2>Scheduled Maintenance</h2>
    <p>
     The website will be back online shortly. Thank you for your patience.
    </p>

    <!-- Animated Loader dots -->
    <div class="loader">
      <div class="dot"></div>
      <div class="dot"></div>
      <div class="dot"></div>
    </div>

    <div class="footer-note">CODE: 503_SERVICE_TEMPORARILY_UNAVAILABLE</div>
  </div>

</body>
</html>
