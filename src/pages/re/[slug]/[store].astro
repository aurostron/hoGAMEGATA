---
import { turso } from "../../../lib/turso";
import { games as gamesTable } from "../../../db/schema";
import { eq } from "drizzle-orm";

export const prerender = false;

const { slug = "", store = "" } = Astro.params;
const { searchParams } = Astro.url;
const gameId = searchParams.get("gameId") || "";

let gameTitle = "Game";
let gameExists = false;

try {
  let gameRow = null;
  if (gameId) {
    const [row] = await turso
      .select({ title: gamesTable.title })
      .from(gamesTable)
      .where(eq(gamesTable.id, gameId))
      .limit(1);
    gameRow = row;
  }
  if (!gameRow && slug) {
    const [row] = await turso
      .select({ title: gamesTable.title })
      .from(gamesTable)
      .where(eq(gamesTable.slug, slug))
      .limit(1);
    gameRow = row;
  }
  if (gameRow) {
    gameTitle = gameRow.title;
    gameExists = true;
  }
} catch (e) {
  console.error("[Gateway Server Error] Failed to look up game:", e);
}

const storeMap: Record<string, string> = {
  steam: "Steam",
  gog: "GOG",
  humble: "Humble Store",
  fanatical: "Fanatical",
  epic: "Epic Games Store",
  greenman: "GreenManGaming",
  gamersgate: "GamersGate",
  gamebillet: "GameBillet",
  voidu: "Voidu"
};
const matchedStore = storeMap[store.toLowerCase()] || store;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "1x00000000000000000000AA";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Redirecting to {matchedStore} - hoGAMEGATA</title>
  <!-- Outfit / Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
  <!-- Turnstile Captcha Script -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <style>
    :root {
      --bg-color: #0b0c10;
      --card-bg: rgba(18, 19, 26, 0.65);
      --card-border: rgba(229, 9, 20, 0.15);
      --accent-color: #e50914; /* Crimson Red */
      --text-main: #f5f5f7;
      --text-muted: #8e8e93;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      font-family: 'Outfit', sans-serif;
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
      position: relative;
    }

    /* Ambient glow background */
    body::before {
      content: '';
      position: absolute;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(229, 9, 20, 0.08) 0%, rgba(0,0,0,0) 70%);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 1;
      pointer-events: none;
    }

    .container {
      width: 100%;
      max-width: 450px;
      padding: 24px;
      position: relative;
      z-index: 10;
    }

    .card {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 40px 32px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .logo {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 0.05em;
      color: var(--text-main);
      margin-bottom: 24px;
      display: inline-block;
      border-bottom: 2px solid var(--accent-color);
      padding-bottom: 4px;
    }

    .logo i {
      font-style: italic;
      font-weight: 400;
      text-transform: lowercase;
    }

    .title {
      font-size: 20px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    .game-name {
      color: var(--accent-color);
      font-weight: 600;
    }

    .description {
      font-size: 14px;
      color: var(--text-muted);
      margin-bottom: 32px;
      line-height: 1.5;
    }

    .captcha-container {
      display: flex;
      justify-content: center;
      margin-bottom: 24px;
      min-height: 65px; /* Prevent layout shift */
    }

    .status-text {
      font-size: 13px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    /* Small spinner for redirecting state */
    .spinner {
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.1);
      border-top-color: var(--accent-color);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      display: none;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="card">
      <div class="logo"><i>ho</i>GAMEGATA</div>
      <div class="title">Redirecting to <span class="game-name">{matchedStore}</span></div>
      <div class="description">
        Thank you for supporting <i>ho</i>GAMEGATA!<br />
        Please verify to secure your redirect to <strong>{gameTitle}</strong>.
      </div>

      <div class="captcha-container">
        <!-- Turnstile Widget -->
        <div class="cf-turnstile" 
             data-sitekey={siteKey} 
             data-callback="onCaptchaVerified" 
             data-theme="dark">
        </div>
      </div>

      <div id="status" class="status-text">
        <span>Awaiting human verification...</span>
        <div class="spinner" id="spinner"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    function onCaptchaVerified(token) {
      const statusEl = document.getElementById("status");
      const spinnerEl = document.getElementById("spinner");

      statusEl.querySelector("span").textContent = "Redirecting you shortly...";
      spinnerEl.style.display = "inline-block";

      const queryParams = window.location.search;

      fetch(window.location.pathname + "/verify" + queryParams, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token })
      })
      .then(res => {
        if (!res.ok) throw new Error("Captcha verification failed.");
        return res.json();
      })
      .then(data => {
        if (data.redirectUrl) {
          window.location.href = data.redirectUrl;
        } else {
          statusEl.querySelector("span").textContent = "Verification error. Please refresh.";
          spinnerEl.style.display = "none";
        }
      })
      .catch(err => {
        console.error(err);
        statusEl.querySelector("span").textContent = "Verification failed. Try again.";
        spinnerEl.style.display = "none";
      });
    }
  </script>

</body>
</html>
