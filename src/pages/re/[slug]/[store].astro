---
import { turso, initTursoForRequest } from "../../../lib/turso";
import { games as gamesTable } from "../../../db/schema";
import { eq } from "drizzle-orm";
import { env as cfWorkerEnv } from "cloudflare:workers";

export const prerender = false;

const isDev = import.meta.env?.DEV || (typeof process !== 'undefined' && process.env && process.env.NODE_ENV === 'development');
const runtimeEnv = isDev
  ? (typeof process !== "undefined" && process.env ? process.env : cfWorkerEnv)
  : (cfWorkerEnv || (typeof process !== "undefined" ? process.env : {}));

initTursoForRequest(runtimeEnv);

const { slug = "", store = "" } = Astro.params;
const { searchParams } = Astro.url;
const gameId = searchParams.get("gameId") || "";

let gameTitle = "Game";
let gameExists = false;

try {
  let gameRow = null;
  if (gameId) {
    const [row] = await turso
      .select({ title: gamesTable.title })
      .from(gamesTable)
      .where(eq(gamesTable.id, gameId))
      .limit(1);
    gameRow = row;
  }
  if (!gameRow && slug) {
    const [row] = await turso
      .select({ title: gamesTable.title })
      .from(gamesTable)
      .where(eq(gamesTable.slug, slug))
      .limit(1);
    gameRow = row;
  }
  if (gameRow) {
    gameTitle = gameRow.title;
    gameExists = true;
  }
} catch (e) {
  console.error("[Gateway Server Error] Failed to look up game:", e);
}

const storeMap: Record<string, string> = {
  steam: "Steam",
  gog: "GOG",
  humble: "Humble Store",
  humblestore: "Humble Store",
  humblebundle: "Humble Store",
  fanatical: "Fanatical",
  epic: "Epic Games Store",
  epicgames: "Epic Games Store",
  epicgamesstore: "Epic Games Store",
  greenman: "Green Man Gaming",
  greenmangaming: "Green Man Gaming",
  gmg: "Green Man Gaming",
  microsoft: "Microsoft Store",
  microsoftstore: "Microsoft Store",
  xbox: "Microsoft Store",
  gamersgate: "GamersGate",
  gamebillet: "GameBillet",
  voidu: "Voidu",
  itchio: "itch.io",
  itch: "itch.io"
};
const matchedStore = storeMap[store.toLowerCase().replace(/[^a-z0-9]/g, "")] || store;
const siteKey = (runtimeEnv as any)?.PUBLIC_TURNSTILE_SITE_KEY 
  || (typeof process !== "undefined" && process.env?.PUBLIC_TURNSTILE_SITE_KEY)
  || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY 
  || "0x4AAAAAADxZWPj99fIewEFh";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Redirecting to {matchedStore} - hoGAMEGATA</title>
  <!-- Outfit / Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
  <!-- Turnstile Captcha Script -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <style>
    :root {
      --bg-color: #0b0c10;
      --card-bg: rgba(18, 19, 26, 0.65);
      --card-border: rgba(229, 9, 20, 0.15);
      --accent-color: #e50914; /* Crimson Red */
      --text-main: #f5f5f7;
      --text-muted: #8e8e93;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      font-family: 'Outfit', sans-serif;
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
      position: relative;
    }

    /* Ambient glow background */
    body::before {
      content: '';
      position: absolute;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(229, 9, 20, 0.08) 0%, rgba(0,0,0,0) 70%);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 1;
      pointer-events: none;
    }

    .container {
      width: 100%;
      max-width: 450px;
      padding: 24px;
      position: relative;
      z-index: 10;
    }

    .card {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 40px 32px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .logo {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 0.05em;
      color: var(--text-main);
      margin-bottom: 24px;
      display: inline-block;
      border-bottom: 2px solid var(--accent-color);
      padding-bottom: 4px;
    }

    .logo i {
      font-style: italic;
      font-weight: 400;
      text-transform: lowercase;
    }

    .title {
      font-size: 20px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    .game-name {
      color: var(--accent-color);
      font-weight: 600;
    }

    .description {
      font-size: 14px;
      color: var(--text-muted);
      margin-bottom: 32px;
      line-height: 1.5;
    }

    .captcha-container {
      display: flex;
      justify-content: center;
      margin-bottom: 24px;
      min-height: 65px; /* Prevent layout shift */
    }

    .status-text {
      font-size: 13px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    /* Small spinner for redirecting state */
    .spinner {
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.1);
      border-top-color: var(--accent-color);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      display: none;
    }

    .manual-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 22px;
      background: var(--text-main);
      color: #0b0c10;
      font-weight: 700;
      font-size: 13px;
      border-radius: 12px;
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    }

    .manual-btn:hover {
      background: #ffffff;
      transform: scale(1.02);
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="card">
      <div class="logo"><i>ho</i>GAMEGATA</div>
      <div class="title">Redirecting to <span class="game-name">{matchedStore}</span></div>
      <div class="description">
        Thank you for supporting <i>ho</i>GAMEGATA!<br />
        Please verify to secure your redirect to <strong>{gameTitle}</strong>.
      </div>

      <div class="captcha-container">
        <!-- Turnstile Widget -->
        <div class="cf-turnstile" 
             data-sitekey={siteKey} 
             data-callback="onCaptchaVerified"
             data-error-callback="onCaptchaError"
             data-expired-callback="onCaptchaExpired"
             data-theme="dark">
        </div>
      </div>

      <div id="status" class="status-text">
        <span>Awaiting human verification...</span>
        <div class="spinner" id="spinner"></div>
      </div>

      <div id="manual-action" style="display: none; margin-top: 18px;">
        <a id="manual-btn" href="#" class="manual-btn">
          Proceed to {matchedStore} &rarr;
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    let isVerifying = false;

    function showManualFallback(customUrl) {
      const statusEl = document.getElementById("status");
      const spinnerEl = document.getElementById("spinner");
      const manualActionEl = document.getElementById("manual-action");
      const manualBtn = document.getElementById("manual-btn");
      
      const searchParams = new URLSearchParams(window.location.search);
      const targetUrl = customUrl || searchParams.get("fallbackUrl") || "/";

      if (statusEl) {
        const textSpan = statusEl.querySelector("span");
        if (textSpan) textSpan.textContent = "Ready! Click below to continue:";
      }
      if (spinnerEl) spinnerEl.style.display = "none";
      if (manualBtn) manualBtn.href = targetUrl;
      if (manualActionEl) manualActionEl.style.display = "block";
    }

    function onCaptchaVerified(token) {
      if (isVerifying) return;
      isVerifying = true;

      const statusEl = document.getElementById("status");
      const spinnerEl = document.getElementById("spinner");

      if (statusEl) {
        const textSpan = statusEl.querySelector("span");
        if (textSpan) textSpan.textContent = "Redirecting you shortly...";
      }
      if (spinnerEl) spinnerEl.style.display = "inline-block";

      const cleanPath = window.location.pathname.replace(/\/+$/, "");
      const search = window.location.search || "";
      const verifyEndpoint = cleanPath + "/verify" + search;

      fetch(verifyEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token })
      })
      .then(async res => {
        const data = await res.json().catch(() => ({}));
        if (!res.ok && !data.redirectUrl) {
          throw new Error(data.error || "Captcha verification failed.");
        }
        return data;
      })
      .then(data => {
        if (data.redirectUrl) {
          window.location.replace(data.redirectUrl);
        } else {
          showManualFallback();
        }
      })
      .catch(err => {
        console.warn("Gateway verification note:", err);
        showManualFallback();
      });
    }

    function onCaptchaError() {
      showManualFallback();
    }

    function onCaptchaExpired() {
      const statusEl = document.getElementById("status");
      const spinnerEl = document.getElementById("spinner");
      if (statusEl) {
        const textSpan = statusEl.querySelector("span");
        if (textSpan) textSpan.textContent = "Verification expired. Please re-verify.";
      }
      if (spinnerEl) spinnerEl.style.display = "none";
      isVerifying = false;
    }
  </script>

</body>
</html>
