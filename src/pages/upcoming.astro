---
import Layout from '../layouts/Layout.astro';
import { turso } from '../lib/turso';
import { games as gamesTable } from '../db/schema';
import { eq, or, gt } from 'drizzle-orm';
import { enrichGamesWithRelations } from '../lib/gameQueries';
import { Calendar, ArrowLeft, ExternalLink } from "lucide-react";
import { getHighResCoverUrl, getCloudinaryFetchUrl, getCategoryBadge } from '../lib/utils';

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=10, s-maxage=30, stale-while-revalidate=60'
);

const rawGames = await turso
  .select()
  .from(gamesTable)
  .where(or(eq(gamesTable.status, "upcoming"), gt(gamesTable.releaseDate, new Date())))
  .orderBy(gamesTable.releaseDate);

const games = await enrichGamesWithRelations(rawGames);

// Group games by month/year
const groupedGames: { [key: string]: typeof games } = {};
const tbaGames: typeof games = [];

for (const game of games) {
  if (game.releaseDate) {
    const date = new Date(game.releaseDate);
    const monthYear = date.toLocaleDateString("en-US", { year: "numeric", month: "long" });
    if (!groupedGames[monthYear]) {
      groupedGames[monthYear] = [];
    }
    groupedGames[monthYear].push(game);
  } else {
    tbaGames.push(game);
  }
}

const sortedMonths = Object.keys(groupedGames).sort((a, b) => {
  return new Date(a).getTime() - new Date(b).getTime();
});
---

<Layout 
  title="Upcoming Horror Release Calendar | hoGAMEGATA" 
  description="Browse the upcoming horror game release calendar on hoGAMEGATA. Stay updated on the latest indie and AAA nightmares." 
  withSearch={false} 
  withLink={true}
>
  <!-- Main Container -->
  <main class="max-w-5xl mx-auto px-6 mt-12 space-y-16 flex-1 pb-24">
    <!-- Intro -->
    <section class="pb-8 border-b border-white space-y-2">
      <span class="font-mono text-[9px] text-white uppercase tracking-widest border border-white px-2 py-0.5 font-bold bg-white text-black w-fit block">
        Calendar Active
      </span>
      <h2 class="text-3xl font-extrabold uppercase tracking-tight">
        Upcoming Horror Mappings
      </h2>
      <p class="text-sm text-white/60 font-medium max-w-xl leading-relaxed">
        Track emerging horror developments, release windows, and official storefront links without marketing noise.
      </p>
    </section>

    <!-- Timeline Grid -->
    {games.length === 0 ? (
      <div class="text-center py-16 border border-white font-mono text-xs text-white uppercase tracking-widest font-bold">
        [ No upcoming horror titles currently indexed ]
      </div>
    ) : (
      <div class="space-y-16">
        {sortedMonths.map((month) => (
          <section class="space-y-6">
            <h3 class="font-mono text-xs text-white border-b border-white pb-2 tracking-widest uppercase font-black">
              // {month}
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {groupedGames[month].map((game) => (
                <div 
                  class="border border-white bg-black p-5 flex gap-5 hover:bg-neutral-950/40 transition-all duration-150"
                >
                  <div class="w-24 h-32 relative bg-neutral-900 border border-white shrink-0 flex items-center justify-center overflow-hidden">
                    {game.coverUrl ? (
                      <img
                        src={getCloudinaryFetchUrl(getHighResCoverUrl(game.coverUrl), game.isTrending) || ""}
                        alt={game.title}
                        class="object-cover w-full h-full"
                        loading="lazy"
                      />
                    ) : (
                      <span class="font-mono text-[8px] uppercase tracking-widest text-white/40">No Cover</span>
                    )}
                    {getCategoryBadge(game.category, game.title) && (
                      <span class="absolute top-1 left-1 font-mono text-[7px] uppercase tracking-widest bg-[#7f1d1d] text-[#fca5a5] border border-[#fca5a5] font-black px-1.5 py-0.2 z-10">
                        {getCategoryBadge(game.category, game.title)}
                      </span>
                    )}
                    {game.slug.startsWith("itch-") && (
                      <span class="absolute top-1 right-1 font-mono text-[7px] uppercase tracking-widest bg-[#fa5c5c] text-black border border-[#fa5c5c] font-black px-1.5 py-0.5 z-10">
                        itch.io
                      </span>
                    )}
                  </div>

                  <div class="flex-1 flex flex-col justify-between min-w-0">
                    <div class="space-y-2">
                      <div class="flex items-start justify-between gap-2">
                        <a href={`/game/${game.slug}`} class="hover:underline">
                          <h4 class="text-sm font-bold uppercase text-white truncate max-w-[240px]">
                            {game.title}
                          </h4>
                        </a>
                      </div>
                      
                      <span class="font-mono text-[9px] text-white/60 block font-bold">
                        by {game.developerNames ? game.developerNames.split(", ")[0] : "Unknown Developer"}
                      </span>

                      <div class="flex flex-wrap gap-1.5 pt-1">
                        {(game.tags as any[])?.slice(0, 2).map((t: any) => (
                          <span class="font-mono text-[8px] border border-white/30 text-white/80 px-1.5 py-0.2 uppercase font-medium">
                            {t.name}
                          </span>
                        ))}
                      </div>
                    </div>

                    <div class="border-t border-white/20 pt-3 mt-3 flex items-center justify-between font-mono text-[9px]">
                      <span class="flex items-center gap-1 font-bold text-white uppercase">
                        <Calendar class="w-3 h-3 text-white" />
                        {game.releaseDate ? new Date(game.releaseDate).toLocaleDateString("en-US", { day: "numeric", month: "short" }) : "TBA"}
                      </span>
                      
                      {(game.purchaseLinks as any[])?.length > 0 ? (
                        <a
                          href={(game.purchaseLinks as any[])[0].url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-1 hover:underline text-white font-black uppercase"
                        >
                          <span>{(game.purchaseLinks as any[])[0].storeName}</span>
                          <ExternalLink class="w-2.5 h-2.5" />
                        </a>
                      ) : (
                        <span class="text-white/40 uppercase">[ TBA link ]</span>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}

        {tbaGames.length > 0 && (
          <section class="space-y-6">
            <h3 class="font-mono text-xs text-white border-b border-white pb-2 tracking-widest uppercase font-black">
              // Date TBA
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {tbaGames.map((game) => (
                <div 
                  class="border border-white bg-black p-5 flex gap-5 hover:bg-neutral-950/40 transition-all duration-150"
                >
                  <div class="w-24 h-32 relative bg-neutral-900 border border-white shrink-0 flex items-center justify-center overflow-hidden">
                    {game.coverUrl ? (
                      <img
                        src={getCloudinaryFetchUrl(getHighResCoverUrl(game.coverUrl), game.isTrending) || ""}
                        alt={game.title}
                        class="object-cover w-full h-full"
                        loading="lazy"
                      />
                    ) : (
                      <span class="font-mono text-[8px] uppercase tracking-widest text-white/40">No Cover</span>
                    )}
                    {getCategoryBadge(game.category, game.title) && (
                      <span class="absolute top-1 left-1 font-mono text-[7px] uppercase tracking-widest bg-[#7f1d1d] text-[#fca5a5] border border-[#fca5a5] font-black px-1.5 py-0.2 z-10">
                        {getCategoryBadge(game.category, game.title)}
                      </span>
                    )}
                    {game.slug.startsWith("itch-") && (
                      <span class="absolute top-1 right-1 font-mono text-[7px] uppercase tracking-widest bg-[#fa5c5c] text-black border border-[#fa5c5c] font-black px-1.5 py-0.5 z-10">
                        itch.io
                      </span>
                    )}
                  </div>

                  <div class="flex-1 flex flex-col justify-between min-w-0">
                    <div class="space-y-2">
                      <a href={`/game/${game.slug}`} class="hover:underline">
                        <h4 class="text-sm font-bold uppercase text-white truncate max-w-[240px]">
                          {game.title}
                        </h4>
                      </a>
                      <span class="font-mono text-[9px] text-white/60 block font-bold">
                        by {game.developerNames ? game.developerNames.split(", ")[0] : "Unknown Developer"}
                      </span>
                      <div class="flex flex-wrap gap-1.5 pt-1">
                        {(game.tags as any[])?.slice(0, 2).map((t: any) => (
                          <span class="font-mono text-[8px] border border-white/30 text-white/80 px-1.5 py-0.2 uppercase font-medium">
                            {t.name}
                          </span>
                        ))}
                      </div>
                    </div>

                    <div class="border-t border-white/20 pt-3 mt-3 flex items-center justify-between font-mono text-[9px]">
                      <span class="flex items-center gap-1 font-bold text-white uppercase">
                        <Calendar class="w-3 h-3 text-white" />
                        TBA
                      </span>
                      
                      {(game.purchaseLinks as any[])?.length > 0 ? (
                        <a
                          href={(game.purchaseLinks as any[])[0].url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-1 hover:underline text-white font-black uppercase"
                        >
                          <span>{(game.purchaseLinks as any[])[0].storeName}</span>
                          <ExternalLink class="w-2.5 h-2.5" />
                        </a>
                      ) : (
                        <span class="text-white/40 uppercase">[ TBA link ]</span>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    )}
  </main>
</Layout>
