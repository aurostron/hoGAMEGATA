---
import Layout from '../layouts/Layout.astro';
import { turso } from '../lib/turso';
import { games as gamesTable } from '../db/schema';
import { eq, or, gt } from 'drizzle-orm';
import { enrichGamesWithRelations } from '../lib/gameQueries';
import { getHighResCoverUrl, getCloudinaryFetchUrl, getCategoryBadge } from '../lib/utils';

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400'
);

const rawGames = await turso
  .select({
    id: gamesTable.id,
    title: gamesTable.title,
    slug: gamesTable.slug,
    status: gamesTable.status,
    coverUrl: gamesTable.coverUrl,
    isTrending: gamesTable.isTrending,
    category: gamesTable.category,
    developerNames: gamesTable.developerNames,
    releaseDate: gamesTable.releaseDate,
  })
  .from(gamesTable)
  .where(or(eq(gamesTable.status, "upcoming"), gt(gamesTable.releaseDate, new Date())))
  .orderBy(gamesTable.releaseDate);

const games = await enrichGamesWithRelations(rawGames);

// Group games by month/year
const groupedGames: { [key: string]: typeof games } = {};
const tbaGames: typeof games = [];

for (const game of games) {
  if (game.releaseDate) {
    const date = new Date(game.releaseDate);
    if (!isNaN(date.getTime())) {
      const monthYear = date.toLocaleDateString("en-US", { year: "numeric", month: "long" });
      if (!groupedGames[monthYear]) {
        groupedGames[monthYear] = [];
      }
      groupedGames[monthYear].push(game);
    } else {
      tbaGames.push(game);
    }
  } else {
    tbaGames.push(game);
  }
}

const sortedMonths = Object.keys(groupedGames).sort((a, b) => {
  return new Date(a).getTime() - new Date(b).getTime();
});

// Current date math
const now = new Date();
const currentMonthYear = now.toLocaleDateString("en-US", { year: "numeric", month: "long" });
const getMonthSlug = (str: string) => str.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const currentMonthSlug = getMonthSlug(currentMonthYear);

// Find best month to focus (exact current month or first future month)
let targetMonthSlug = sortedMonths.find(m => getMonthSlug(m) === currentMonthSlug) ? currentMonthSlug : null;
if (!targetMonthSlug && sortedMonths.length > 0) {
  // Find first month that is >= current date
  const firstFutureMonth = sortedMonths.find(m => new Date(m).getTime() >= new Date(now.getFullYear(), now.getMonth(), 1).getTime());
  if (firstFutureMonth) {
    targetMonthSlug = getMonthSlug(firstFutureMonth);
  } else {
    targetMonthSlug = getMonthSlug(sortedMonths[0]);
  }
}
---

<Layout 
  title="Upcoming Horror Release Calendar | hoGAMEGATA" 
  description="Browse the upcoming horror game release calendar on hoGAMEGATA. Stay updated on the latest indie and AAA nightmares." 
  withSearch={false} 
  withLink={true}
>
  <!-- Main Container -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 mt-8 sm:mt-12 space-y-10 flex-1 pb-24 font-sans">
    
    <!-- Header Section — Modern Sans UI Glass Banner -->
    <section class="bg-[#121217]/95 border border-white/12 rounded-3xl p-6 sm:p-8 shadow-2xl backdrop-blur-md relative overflow-hidden">
      <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
            Upcoming Horror Releases
          </h1>
          <p class="text-sm text-white/60 font-medium leading-relaxed">
            Track upcoming horror game release dates and storefront links. Released titles remain dimmed for timeline reference.
          </p>
        </div>

        <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-2xl p-4 shrink-0">
          <div class="text-center px-2">
            <span class="block text-xl font-bold text-white leading-none">{games.length}</span>
            <span class="text-[11px] text-white/40 font-medium uppercase tracking-wider">Total Games</span>
          </div>
          <div class="h-8 w-px bg-white/10"></div>
          <div class="text-center px-2">
            <span class="block text-xl font-bold text-white leading-none">{sortedMonths.length}</span>
            <span class="text-[11px] text-white/40 font-medium uppercase tracking-wider">Months Ahead</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Month Navigation Pill Tabs -->
    {sortedMonths.length > 0 && (
      <div class="sticky top-20 z-30 bg-[#0c0c0e]/90 backdrop-blur-md py-3 border-y border-white/10 -mx-4 px-4 sm:-mx-6 sm:px-6 flex items-center gap-2 overflow-x-auto custom-scrollbar">
        <span class="text-xs font-semibold text-white/40 shrink-0 uppercase tracking-wider pl-1">Jump to:</span>
        {sortedMonths.map((month) => {
          const slug = getMonthSlug(month);
          const isCurrent = slug === currentMonthSlug;
          return (
            <a
              href={`#month-${slug}`}
              class={`px-3.5 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-all duration-200 flex items-center gap-1.5 ${
                isCurrent 
                  ? "bg-white text-black font-bold shadow-md" 
                  : "bg-white/5 border border-white/10 text-white/70 hover:text-white hover:bg-white/15 hover:border-white/30"
              }`}
            >
              {isCurrent && <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>}
              <span>{month}</span>
            </a>
          );
        })}
        {tbaGames.length > 0 && (
          <a
            href="#month-tba"
            class="px-3.5 py-1.5 rounded-full text-xs font-medium whitespace-nowrap bg-white/5 border border-white/10 text-white/70 hover:text-white hover:bg-white/15 hover:border-white/30 transition-all"
          >
            TBA ({tbaGames.length})
          </a>
        )}
      </div>
    )}

    <!-- Timeline Grid -->
    {games.length === 0 ? (
      <div class="text-center py-20 bg-[#121217] border border-white/10 rounded-3xl text-sm font-medium text-white/50 shadow-xl">
        No upcoming horror titles currently indexed in database.
      </div>
    ) : (
      <div class="space-y-16">
        {sortedMonths.map((month) => {
          const monthSlug = getMonthSlug(month);
          const isCurrentMonth = monthSlug === currentMonthSlug;
          const isTargetMonth = monthSlug === targetMonthSlug;

          return (
            <section 
              id={`month-${monthSlug}`} 
              data-current-target={isTargetMonth ? "true" : "false"}
              class="space-y-6 scroll-mt-36"
            >
              {/* Section Header */}
              <div class="flex items-center justify-between pb-3 border-b border-white/12">
                <h3 class="text-base sm:text-xl font-bold text-white tracking-wide flex items-center gap-2.5">
                  <span>{month}</span>
                  {isCurrentMonth && (
                    <span class="text-[10px] font-bold bg-white text-black rounded-full px-2.5 py-0.5 uppercase tracking-wider flex items-center gap-1.5 shadow-sm">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
                      Current Month
                    </span>
                  )}
                </h3>
                <span class="text-xs text-white/40 font-medium">
                  {groupedGames[month].length} {groupedGames[month].length === 1 ? "Title" : "Titles"}
                </span>
              </div>

              {/* Cards Grid */}
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                {groupedGames[month].map((game, gameIdx) => {
                  const relDate = game.releaseDate ? new Date(game.releaseDate) : null;
                  const isPast = relDate && !isNaN(relDate.getTime()) ? relDate < new Date(now.getFullYear(), now.getMonth(), now.getDate()) : false;

                  return (
                    <div 
                      class={`group bg-[#121217] border border-white/12 rounded-2xl p-4 sm:p-5 flex gap-4 sm:gap-5 hover:border-white/35 hover:bg-[#16161d] transition-all duration-300 shadow-lg hover:shadow-2xl hover:-translate-y-0.5 relative overflow-hidden ${
                        isPast ? "opacity-45 grayscale-[40%] hover:opacity-100 hover:grayscale-0" : ""
                      }`}
                    >
                      {/* Cover Thumbnail */}
                      <div class="w-24 sm:w-28 h-32 sm:h-36 relative bg-[#181820] border border-white/10 rounded-xl shrink-0 flex items-center justify-center overflow-hidden shadow-md group-hover:border-white/30 transition-colors">
                        {game.coverUrl ? (
                          <img
                            src={getCloudinaryFetchUrl(getHighResCoverUrl(game.coverUrl), game.isTrending) || ""}
                            alt={game.title}
                            class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-300"
                            loading={gameIdx < 6 ? "eager" : "lazy"}
                            decoding="async"
                          />
                        ) : (
                          <span class="text-[10px] font-medium text-white/40">No Cover</span>
                        )}

                        {getCategoryBadge(game.category, game.title) && (
                          <span class="absolute top-1.5 left-1.5 text-[9px] font-bold bg-red-950/90 text-red-200 border border-red-500/40 rounded-full px-2 py-0.5 z-10 backdrop-blur-xs shadow-sm">
                            {getCategoryBadge(game.category, game.title)}
                          </span>
                        )}
                        {game.slug.startsWith("itch-") && (
                          <span class="absolute top-1.5 right-1.5 text-[9px] font-bold bg-[#fa5c5c] text-black rounded-full px-2 py-0.5 z-10 shadow-sm">
                            itch.io
                          </span>
                        )}
                      </div>

                      {/* Content Info */}
                      <div class="flex-1 flex flex-col justify-between min-w-0">
                        <div class="space-y-1.5">
                          <div class="flex items-start justify-between gap-2">
                            <a href={`/game/${game.slug}`} class="group-hover:text-white transition-colors">
                              <h4 class="text-sm sm:text-base font-bold text-white truncate max-w-[220px] tracking-tight">
                                {game.title}
                              </h4>
                            </a>
                          </div>
                          
                          <span class="text-xs text-white/50 block font-medium truncate">
                            by <strong class="text-white/80">{game.developerNames ? game.developerNames.split(", ")[0] : "Unknown Developer"}</strong>
                          </span>

                          <div class="flex flex-wrap gap-1.5 pt-1">
                            {isPast && (
                              <span class="text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-full px-2.5 py-0.5">
                                Released / Past
                              </span>
                            )}
                            {(game.tags as any[])?.slice(0, 2).map((t: any) => (
                              <span class="text-[10px] border border-white/10 bg-white/5 text-white/70 rounded-full px-2.5 py-0.5 font-medium">
                                {t.name}
                              </span>
                            ))}
                          </div>
                        </div>

                        {/* Card Footer Bar */}
                        <div class="border-t border-white/10 pt-3 mt-3 flex items-center justify-between text-xs">
                          <span class="flex items-center gap-1.5 font-semibold text-white/80">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-white/50"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                            {game.releaseDate ? new Date(game.releaseDate).toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric" }) : "TBA"}
                          </span>
                          
                          {(game.purchaseLinks as any[])?.length > 0 ? (
                            <a
                              href={(game.purchaseLinks as any[])[0].url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="flex items-center gap-1 px-3 py-1 rounded-full bg-white/10 hover:bg-white hover:text-black border border-white/15 text-white font-semibold text-xs transition-all duration-200 cursor-pointer shadow-xs"
                            >
                              <span>{(game.purchaseLinks as any[])[0].storeName}</span>
                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                            </a>
                          ) : (
                            <span class="text-white/35 text-[11px] font-medium">[ TBA Link ]</span>
                          )}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          );
        })}

        {/* TBA Section */}
        {tbaGames.length > 0 && (
          <section id="month-tba" class="space-y-6 scroll-mt-36">
            <div class="flex items-center justify-between pb-3 border-b border-white/12">
              <h3 class="text-base sm:text-xl font-bold text-white tracking-wide flex items-center gap-2">
                <span>Date TBA (To Be Announced)</span>
              </h3>
              <span class="text-xs text-white/40 font-medium">
                {tbaGames.length} Titles
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              {tbaGames.map((game) => (
                <div 
                  class="group bg-[#121217] border border-white/12 rounded-2xl p-4 sm:p-5 flex gap-4 sm:gap-5 hover:border-white/35 hover:bg-[#16161d] transition-all duration-300 shadow-lg hover:shadow-2xl hover:-translate-y-0.5 relative overflow-hidden"
                >
                  <div class="w-24 sm:w-28 h-32 sm:h-36 relative bg-[#181820] border border-white/10 rounded-xl shrink-0 flex items-center justify-center overflow-hidden shadow-md group-hover:border-white/30 transition-colors">
                    {game.coverUrl ? (
                      <img
                        src={getCloudinaryFetchUrl(getHighResCoverUrl(game.coverUrl), game.isTrending) || ""}
                        alt={game.title}
                        class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    ) : (
                      <span class="text-[10px] font-medium text-white/40">No Cover</span>
                    )}
                    {getCategoryBadge(game.category, game.title) && (
                      <span class="absolute top-1.5 left-1.5 text-[9px] font-bold bg-red-950/90 text-red-200 border border-red-500/40 rounded-full px-2 py-0.5 z-10 backdrop-blur-xs">
                        {getCategoryBadge(game.category, game.title)}
                      </span>
                    )}
                    {game.slug.startsWith("itch-") && (
                      <span class="absolute top-1.5 right-1.5 text-[9px] font-bold bg-[#fa5c5c] text-black rounded-full px-2 py-0.5 z-10 shadow-sm">
                        itch.io
                      </span>
                    )}
                  </div>

                  <div class="flex-1 flex flex-col justify-between min-w-0">
                    <div class="space-y-1.5">
                      <a href={`/game/${game.slug}`} class="group-hover:text-white transition-colors">
                        <h4 class="text-sm sm:text-base font-bold text-white truncate max-w-[220px] tracking-tight">
                          {game.title}
                        </h4>
                      </a>
                      <span class="text-xs text-white/50 block font-medium truncate">
                        by <strong class="text-white/80">{game.developerNames ? game.developerNames.split(", ")[0] : "Unknown Developer"}</strong>
                      </span>
                      <div class="flex flex-wrap gap-1.5 pt-1">
                        {(game.tags as any[])?.slice(0, 2).map((t: any) => (
                          <span class="text-[10px] border border-white/10 bg-white/5 text-white/70 rounded-full px-2.5 py-0.5 font-medium">
                            {t.name}
                          </span>
                        ))}
                      </div>
                    </div>

                    <div class="border-t border-white/10 pt-3 mt-3 flex items-center justify-between text-xs">
                      <span class="flex items-center gap-1.5 font-semibold text-white/80">
                        <Calendar class="w-3.5 h-3.5 text-white/50" />
                        TBA
                      </span>
                      
                      {(game.purchaseLinks as any[])?.length > 0 ? (
                        <a
                          href={(game.purchaseLinks as any[])[0].url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-1 px-3 py-1 rounded-full bg-white/10 hover:bg-white hover:text-black border border-white/15 text-white font-semibold text-xs transition-all duration-200 cursor-pointer shadow-xs"
                        >
                          <span>{(game.purchaseLinks as any[])[0].storeName}</span>
                          <ExternalLink class="w-3 h-3" />
                        </a>
                      ) : (
                        <span class="text-white/35 text-[11px] font-medium">[ TBA Link ]</span>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    )}
  </main>

  {/* Client-side script to auto-scroll directly to current/target month section */}
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const targetElem = document.querySelector('[data-current-target="true"]');
      if (targetElem) {
        setTimeout(() => {
          targetElem.scrollIntoView({ behavior: "smooth", block: "start" });
        }, 400);
      }
    });
  </script>
</Layout>
