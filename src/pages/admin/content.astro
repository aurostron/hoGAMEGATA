---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getOrSeedContent } from '../../lib/siteContent';

const contentList = await getOrSeedContent();

// Group site content by section
const sectionsMap = new Map<string, any[]>();
for (const item of contentList) {
  const section = item.section || 'General';
  if (!sectionsMap.has(section)) {
    sectionsMap.set(section, []);
  }
  sectionsMap.get(section)!.push(item);
}

const sectionKeys = Array.from(sectionsMap.keys());
---

<AdminLayout title="Page Copy Editor" activeTab="content">
  <!-- Heading Section -->
  <div class="flex items-center justify-between pb-4 border-b border-[#1a1a24]">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-white uppercase font-heading">
        Page Copy Editor
      </h1>
      <p class="text-sm text-gray-400 mt-1">Manage global copy, headlines, and descriptions across the storefront.</p>
    </div>
    <span class="text-xs font-sans border border-red-500/30 text-red-400 bg-red-500/10 px-3 py-1 rounded-md">
      Live Updates Enabled
    </span>
  </div>

  <div class="space-y-8">
    {sectionKeys.map((sectionName) => (
      <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg overflow-hidden">
        <!-- Section Header -->
        <div class="px-6 py-4 bg-[#0c0c12] border-b border-[#1a1a24] flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wider text-white font-sans flex items-center gap-2">
            <span class="w-1.5 h-4 bg-[#ff2a2a] inline-block"></span>
            {sectionName} copy
          </h2>
          <span class="text-[10px] font-sans text-gray-500 uppercase">
            {sectionsMap.get(sectionName)!.length} fields
          </span>
        </div>

        <!-- Section Fields -->
        <div class="p-6 space-y-6 divide-y divide-[#1a1a24]/50">
          {sectionsMap.get(sectionName)!.map((field, idx) => (
            <div class={`flex flex-col md:flex-row md:items-start gap-4 ${idx > 0 ? 'pt-6' : ''}`}>
              <!-- Label Column -->
              <div class="md:w-1/4">
                <label class="block text-xs font-bold font-sans text-gray-400 uppercase tracking-wider mb-1">
                  {field.label}
                </label>
                <code class="text-[10px] font-sans text-gray-500 bg-black/40 px-1.5 py-0.5 rounded">
                  {field.key}
                </code>
              </div>

              <!-- Input & Save Column -->
              <div class="flex-1 space-y-2">
                {field.key.includes('_desc') || field.key.includes('_subtitle') ? (
                  <textarea
                    id={`field-${field.key}`}
                    class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded-md px-4 py-2.5 text-sm text-white font-sans placeholder-gray-600 focus:outline-none transition duration-150 resize-none h-24"
                    placeholder="Enter description copy..."
                  >{field.value}</textarea>
                ) : (
                  <input
                    id={`field-${field.key}`}
                    type="text"
                    value={field.value}
                    class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded-md px-4 py-2.5 text-sm text-white font-sans placeholder-gray-600 focus:outline-none transition duration-150"
                    placeholder="Enter copy string..."
                  />
                )}
                
                <div class="flex items-center justify-between">
                  <!-- Last Saved Info -->
                  <div class="text-[10px] font-sans text-gray-500 flex items-center space-x-1.5">
                    {field.updatedAt && (
                      <span>Last updated: {new Date(field.updatedAt).toLocaleString()}</span>
                    )}
                    {field.updatedBy && (
                      <span>by {field.updatedBy}</span>
                    )}
                  </div>

                  <!-- Save Button -->
                  <button
                    data-key={field.key}
                    class="save-btn font-sans text-xs font-bold uppercase tracking-wider border border-[#1a1a24] hover:border-[#ff2a2a] hover:bg-[#ff2a2a]/10 px-4 py-1.5 rounded transition duration-200 cursor-pointer text-white/90 hover:text-white"
                  >
                    Save Changes
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</AdminLayout>

<!-- Client side save logic with live UI feedback -->
<script>
  const saveButtons = document.querySelectorAll('.save-btn');

  saveButtons.forEach(button => {
    button.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const key = btn.getAttribute('data-key');
      const inputEl = document.getElementById(`field-${key}`) as HTMLInputElement | HTMLTextAreaElement;
      
      if (!key || !inputEl) return;

      const originalText = btn.textContent;
      
      // Update UI to saving state
      btn.disabled = true;
      btn.textContent = 'Saving...';
      btn.style.borderColor = '#ff2a2a';
      
      try {
        const response = await fetch('/api/admin/content', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            key: key,
            value: inputEl.value
          })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          btn.textContent = 'Saved!';
          btn.style.borderColor = '#22c55e'; // Green success border
          
          // Revert button text after 2 seconds
          setTimeout(() => {
            btn.textContent = originalText;
            btn.disabled = false;
            btn.style.borderColor = '';
          }, 2000);
        } else {
          throw new Error(data.error || 'Server error');
        }
      } catch (err) {
        console.error('Failed to save field:', err);
        btn.textContent = 'Failed';
        btn.style.borderColor = '#ef4444'; // Red failure border
        
        setTimeout(() => {
          btn.textContent = originalText;
          btn.disabled = false;
          btn.style.borderColor = '';
        }, 3000);
      }
    });
  });
</script>
