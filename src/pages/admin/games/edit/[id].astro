---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { turso } from '../../../../lib/turso';
import { games, developers, gamesToDevelopers, platforms, gamesToPlatforms } from '../../../../db/schema';
import { eq } from 'drizzle-orm';

export const prerender = false;

const { id } = Astro.params;

let game: any = null;
let currentDev: any = null;
let allPlatforms: any[] = [];
let currentPlatformIds: string[] = [];

try {
  // 1. Fetch game details
  const [gameResult] = await turso
    .select()
    .from(games)
    .where(eq(games.id, id!))
    .limit(1);
  game = gameResult;

  if (game) {
    // 2. Fetch linked developer
    const [devResult] = await turso
      .select({ id: developers.id, name: developers.name })
      .from(gamesToDevelopers)
      .innerJoin(developers, eq(gamesToDevelopers.developerId, developers.id))
      .where(eq(gamesToDevelopers.gameId, id!))
      .limit(1);
    currentDev = devResult || null;

    // 3. Fetch linked platforms
    const currentPlatRelations = await turso
      .select({ platformId: gamesToPlatforms.platformId })
      .from(gamesToPlatforms)
      .where(eq(gamesToPlatforms.gameId, id!));
    currentPlatformIds = currentPlatRelations.map(r => r.platformId);
  }

  // 4. Fetch all platforms
  allPlatforms = await turso
    .select()
    .from(platforms)
    .orderBy(platforms.name);
} catch (err) {
  console.error("Failed to query edit game page details:", err);
}

if (!game) {
  return Astro.redirect('/404');
}

let existingScreenshots: string[] = [];
if (game.screenshots) {
  try {
    existingScreenshots = JSON.parse(game.screenshots);
  } catch (e) {
    console.error("Failed to parse screenshots JSON:", e);
  }
}

const formattedReleaseDate = game.releaseDate 
  ? new Date(game.releaseDate).toISOString().split('T')[0] 
  : '';

let scareProfile: any = {};
if (game.scareProfile) {
  try {
    scareProfile = JSON.parse(game.scareProfile);
  } catch (e) {}
}

const hasScareProfile = game.scareRating !== null;
---

<AdminLayout title={`Edit "${game.title}"`} activeTab="games">
  <!-- Heading Section -->
  <div class="flex items-center justify-between pb-4 border-b border-[#1a1a24]">
    <div class="flex items-center space-x-4">
      <a href="/admin/games" class="text-xs font-mono border border-[#1a1a24] hover:border-white px-3 py-1.5 rounded transition duration-200">
        &larr; Back to Catalog
      </a>
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-white uppercase font-heading">
          Edit Game
        </h1>
        <p class="text-xs text-gray-500 font-mono mt-0.5">{game.id}</p>
      </div>
    </div>
    
    <span class={`text-[10px] uppercase font-bold font-mono px-2.5 py-1 rounded border ${
      game.status === 'released'
        ? 'bg-green-500/10 text-green-400 border-green-500/20'
        : game.status === 'upcoming'
        ? 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20'
        : 'bg-red-500/10 text-red-400 border-red-500/20'
    }`}>
      {game.status || 'unknown'}
    </span>
  </div>

  <form id="edit-game-form" class="grid grid-cols-1 lg:grid-cols-3 gap-6 pt-4">
    <!-- Left Column: Edit Metadata Form -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Specifications Card -->
      <div class="bg-[#07070a] border border-[#1a1a24] p-6 rounded-lg space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2">
          <span class="w-1.5 h-4 bg-[#ff2a2a] inline-block"></span>
          Game Specifications
        </h2>

        <!-- Game Title -->
        <div>
          <label class="block text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
            Game Title
          </label>
          <input
            type="text"
            id="game-title"
            value={game.title}
            required
            class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded px-4 py-2.5 text-sm text-white focus:outline-none transition duration-150"
          />
        </div>

        <!-- Feature on Homepage Hero -->
        <label class="flex items-center space-x-2.5 text-xs text-gray-300 font-bold select-none cursor-pointer font-mono pb-2 border-b border-[#1a1a24]/30">
          <input
            type="checkbox"
            id="game-is-trending"
            checked={game.isTrending}
            class="rounded bg-[#050508] border-[#1a1a24] text-[#ff2a2a] focus:ring-[#ff2a2a] w-4 h-4 cursor-pointer"
          />
          <span class="uppercase tracking-wider">Feature on Homepage Hero Slider</span>
        </label>

        <div class="grid grid-cols-2 gap-4">
          <!-- Game Status -->
          <div>
            <label class="block text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
              Storefront Status
            </label>
            <select
              id="game-status"
              class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded px-4 py-2.5 text-sm text-white focus:outline-none transition duration-150 font-mono text-xs uppercase"
            >
              <option value="released" selected={game.status === 'released'}>Released</option>
              <option value="upcoming" selected={game.status === 'upcoming'}>Upcoming</option>
              <option value="hidden" selected={game.status === 'hidden'}>Hidden / Removed</option>
            </select>
          </div>

          <!-- Release Date -->
          <div>
            <label class="block text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
              Release Date
            </label>
            <input
              type="date"
              id="game-release-date"
              value={formattedReleaseDate}
              class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded px-4 py-2.5 text-sm text-white focus:outline-none transition duration-150 font-mono text-xs"
            />
          </div>
        </div>

        <!-- Developer Autocomplete Field -->
        <div class="relative">
          <label class="block text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
            Developer / Creator
          </label>
          <input
            type="text"
            id="dev-search-input"
            value={currentDev?.name || ''}
            placeholder="Type developer name to link..."
            autocomplete="off"
            class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded px-4 py-2.5 text-sm text-white focus:outline-none transition duration-150"
          />
          <input
            type="hidden"
            id="developer-id-val"
            value={currentDev?.id || ''}
          />
          
          <!-- Dropdown suggestions -->
          <div
            id="dev-suggestions"
            class="hidden absolute left-0 right-0 mt-1 max-h-48 overflow-y-auto bg-[#0c0c12] border border-[#1a1a24] rounded-md shadow-lg z-50 divide-y divide-[#1a1a24]"
          ></div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <!-- Youtube Trailer URL -->
          <div>
            <label class="block text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
              YouTube Trailer URL
            </label>
            <input
              type="url"
              id="game-trailer"
              value={game.trailerUrl || ''}
              placeholder="e.g. https://www.youtube.com/watch?v=..."
              class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded px-4 py-2.5 text-sm text-white focus:outline-none transition duration-150 font-sans leading-relaxed"
            />
          </div>

          <!-- Cover URL -->
          <div>
            <label class="block text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
              Cover Image URL
            </label>
            <input
              type="url"
              id="game-cover-url"
              value={game.coverUrl || ''}
              placeholder="e.g. https://files.catbox.moe/..."
              class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded px-4 py-2.5 text-sm text-white focus:outline-none transition duration-150 font-sans leading-relaxed"
            />
          </div>
        </div>
      </div>

      <!-- Descriptions Card -->
      <div class="bg-[#07070a] border border-[#1a1a24] p-6 rounded-lg space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2">
          <span class="w-1.5 h-4 bg-[#ff2a2a] inline-block"></span>
          Descriptions & Context
        </h2>

        <!-- Summary -->
        <div>
          <label class="block text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
            Brief Summary
          </label>
          <textarea
            id="game-summary"
            rows="6"
            placeholder="A short elevator pitch description of the game..."
            class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded px-4 py-2 text-sm text-white focus:outline-none transition duration-150 font-sans leading-relaxed"
          >{game.summary || ''}</textarea>
        </div>

        <!-- Storyline -->
        <div>
          <label class="block text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
            Storyline
          </label>
          <textarea
            id="game-storyline"
            rows="10"
            placeholder="Detailed narrative description of the game plot..."
            class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded px-4 py-2 text-sm text-white focus:outline-none transition duration-150 font-sans leading-relaxed"
          >{game.storyline || ''}</textarea>
        </div>
      </div>

      <!-- Platforms card -->
      <div class="bg-[#07070a] border border-[#1a1a24] p-6 rounded-lg space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2">
          <span class="w-1.5 h-4 bg-[#ff2a2a] inline-block"></span>
          Available Platforms
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
          {allPlatforms.map((plat) => (
            <label class="flex items-center space-x-2.5 text-xs text-gray-300 font-medium select-none cursor-pointer">
              <input
                type="checkbox"
                name="platforms"
                value={plat.id}
                checked={currentPlatformIds.includes(plat.id)}
                class="rounded bg-[#050508] border-[#1a1a24] text-[#ff2a2a] focus:ring-[#ff2a2a] w-4 h-4 cursor-pointer"
              />
              <span>{plat.name}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Screenshots Card -->
      <div class="bg-[#07070a] border border-[#1a1a24] p-6 rounded-lg space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2">
          <span class="w-1.5 h-4 bg-[#ff2a2a] inline-block"></span>
          Game Screenshots
        </h2>

        <!-- Drag & Drop Zone -->
        <div
          id="screenshot-dropzone"
          class="border-2 border-dashed border-[#1a1a24] hover:border-[#ff2a2a] p-8 rounded-lg text-center cursor-pointer transition duration-150 flex flex-col items-center justify-center space-y-2 bg-[#050508]"
        >
          <svg class="w-8 h-8 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="text-xs text-gray-400 font-medium">Drag & drop screenshots here, or click to browse files</span>
          <span class="text-[10px] text-gray-600 uppercase font-mono font-bold">[ Batch uploads supported ]</span>
          <input
            type="file"
            id="screenshot-file-input"
            multiple
            accept="image/*"
            class="hidden"
          />
        </div>

        <!-- Thumbnails list -->
        <div id="screenshots-list" class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-2">
          {existingScreenshots.map((url: string) => (
            <div class="relative group aspect-video rounded overflow-hidden border border-[#1a1a24] bg-[#0c0c12]">
              <img src={`/api/image-proxy?url=${encodeURIComponent(url)}`} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
              <button
                type="button"
                data-url={url}
                class="remove-screenshot-btn absolute top-1 right-1 bg-black/80 hover:bg-[#ff2a2a] text-white rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold transition duration-150 cursor-pointer"
              >
                &times;
              </button>
            </div>
          ))}
        </div>
      </div>

      <!-- Scare Profile configuration card -->
      <div class="bg-[#07070a] border border-[#1a1a24] p-6 rounded-lg space-y-4">
        <div class="flex items-center justify-between border-b border-[#1a1a24] pb-3">
          <h2 class="text-sm font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2">
            <span class="w-1.5 h-4 bg-[#ff2a2a] inline-block"></span>
            Scare Meter Profile
          </h2>
          <label class="flex items-center space-x-2.5 text-xs text-gray-300 font-bold select-none cursor-pointer font-mono">
            <input
              type="checkbox"
              id="enable-scare-profile"
              checked={hasScareProfile}
              class="rounded bg-[#050508] border-[#1a1a24] text-[#ff2a2a] focus:ring-[#ff2a2a] w-4 h-4 cursor-pointer"
            />
            <span class="uppercase tracking-wider">Enable scare meter</span>
          </label>
        </div>

        <div id="scare-sliders-container" class="space-y-4 transition duration-200">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <!-- Scare Rating -->
            <div class="col-span-1 sm:col-span-2">
              <label class="flex justify-between items-baseline text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
                <span>Overall Scare Score</span>
                <span id="scare-val-label" class="text-white">{game.scareRating !== null ? `${game.scareRating}%` : '50%'}</span>
              </label>
              <input
                type="range"
                id="scare-rating"
                min="0"
                max="100"
                value={game.scareRating !== null ? game.scareRating : 50}
                class="w-full accent-[#ff2a2a] bg-[#1a1a24] h-1 rounded-lg appearance-none cursor-pointer"
              />
            </div>

            <!-- Dread Slider -->
            <div>
              <label class="flex justify-between items-baseline text-[10px] font-bold font-mono text-gray-400 uppercase tracking-wider mb-1">
                <span>Dread / Atmospheric Terror</span>
                <span id="dread-lbl" class="text-white">{scareProfile.dread !== undefined ? `${scareProfile.dread}%` : '0%'}</span>
              </label>
              <input
                type="range"
                id="scare-dread"
                min="0"
                max="100"
                value={scareProfile.dread !== undefined ? scareProfile.dread : 0}
                class="w-full accent-[#ff2a2a] bg-[#1a1a24] h-1 rounded-lg appearance-none cursor-pointer"
              />
            </div>

            <!-- Jumpscare Slider -->
            <div>
              <label class="flex justify-between items-baseline text-[10px] font-bold font-mono text-gray-400 uppercase tracking-wider mb-1">
                <span>Jump Scares Intensity</span>
                <span id="jumpscare-lbl" class="text-white">{scareProfile.jumpscare !== undefined ? `${scareProfile.jumpscare}%` : '0%'}</span>
              </label>
              <input
                type="range"
                id="scare-jumpscare"
                min="0"
                max="100"
                value={scareProfile.jumpscare !== undefined ? scareProfile.jumpscare : 0}
                class="w-full accent-[#ff2a2a] bg-[#1a1a24] h-1 rounded-lg appearance-none cursor-pointer"
              />
            </div>

            <!-- Psychological Slider -->
            <div>
              <label class="flex justify-between items-baseline text-[10px] font-bold font-mono text-gray-400 uppercase tracking-wider mb-1">
                <span>Psychological Mindgames</span>
                <span id="psych-lbl" class="text-white">{scareProfile.psychological !== undefined ? `${scareProfile.psychological}%` : '0%'}</span>
              </label>
              <input
                type="range"
                id="scare-psych"
                min="0"
                max="100"
                value={scareProfile.psychological !== undefined ? scareProfile.psychological : 0}
                class="w-full accent-[#ff2a2a] bg-[#1a1a24] h-1 rounded-lg appearance-none cursor-pointer"
              />
            </div>

            <!-- Gore Slider -->
            <div>
              <label class="flex justify-between items-baseline text-[10px] font-bold font-mono text-gray-400 uppercase tracking-wider mb-1">
                <span>Gore & Violence</span>
                <span id="gore-lbl" class="text-white">{scareProfile.gore !== undefined ? `${scareProfile.gore}%` : '0%'}</span>
              </label>
              <input
                type="range"
                id="scare-gore"
                min="0"
                max="100"
                value={scareProfile.gore !== undefined ? scareProfile.gore : 0}
                class="w-full accent-[#ff2a2a] bg-[#1a1a24] h-1 rounded-lg appearance-none cursor-pointer"
              />
            </div>

            <!-- Tension Slider -->
            <div>
              <label class="flex justify-between items-baseline text-[10px] font-bold font-mono text-gray-400 uppercase tracking-wider mb-1">
                <span>Tension / Pacing Stress</span>
                <span id="tension-lbl" class="text-white">{scareProfile.tension !== undefined ? `${scareProfile.tension}%` : '0%'}</span>
              </label>
              <input
                type="range"
                id="scare-tension"
                min="0"
                max="100"
                value={scareProfile.tension !== undefined ? scareProfile.tension : 0}
                class="w-full accent-[#ff2a2a] bg-[#1a1a24] h-1 rounded-lg appearance-none cursor-pointer"
              />
            </div>

            <!-- Disturbing Slider -->
            <div>
              <label class="flex justify-between items-baseline text-[10px] font-bold font-mono text-gray-400 uppercase tracking-wider mb-1">
                <span>Disturbing themes</span>
                <span id="disturbing-lbl" class="text-white">{scareProfile.disturbing !== undefined ? `${scareProfile.disturbing}%` : '0%'}</span>
              </label>
              <input
                type="range"
                id="scare-disturbing"
                min="0"
                max="100"
                value={scareProfile.disturbing !== undefined ? scareProfile.disturbing : 0}
                class="w-full accent-[#ff2a2a] bg-[#1a1a24] h-1 rounded-lg appearance-none cursor-pointer"
              />
            </div>

            <!-- Isolation Slider -->
            <div class="col-span-1 sm:col-span-2">
              <label class="flex justify-between items-baseline text-[10px] font-bold font-mono text-gray-400 uppercase tracking-wider mb-1">
                <span>Isolation / helplessness</span>
                <span id="isolation-lbl" class="text-white">{scareProfile.isolation !== undefined ? `${scareProfile.isolation}%` : '0%'}</span>
              </label>
              <input
                type="range"
                id="scare-isolation"
                min="0"
                max="100"
                value={scareProfile.isolation !== undefined ? scareProfile.isolation : 0}
                class="w-full accent-[#ff2a2a] bg-[#1a1a24] h-1 rounded-lg appearance-none cursor-pointer"
              />
            </div>
          </div>

          <!-- Scare Profile Short Summary -->
          <div>
            <label class="block text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
              Scare Summary
            </label>
            <textarea
              id="scare-short-summary"
              rows="3"
              placeholder="Summary explaining what makes the game scary..."
              class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded px-4 py-2 text-xs text-white focus:outline-none transition duration-150 font-sans leading-relaxed"
            >{scareProfile.shortSummary || ''}</textarea>
          </div>

          <!-- Player Warnings -->
          <div>
            <label class="block text-xs font-bold font-mono text-gray-400 uppercase tracking-wider mb-2">
              Player Warning Tags
            </label>
            <input
              type="text"
              id="scare-player-warnings"
              value={scareProfile.playerWarnings ? scareProfile.playerWarnings.join(', ') : ''}
              placeholder="JUMP SCARES, FLASHING LIGHTS, GORE"
              class="w-full bg-[#050508] border border-[#1a1a24] focus:border-[#ff2a2a] focus:ring-1 focus:ring-[#ff2a2a] rounded px-3 py-2 text-xs text-white focus:outline-none transition duration-150 font-mono"
            />
          </div>
        </div>
      </div>

      <!-- Action Panel Card -->
      <div class="bg-[#07070a] border border-[#1a1a24] p-6 rounded-lg flex items-center justify-between">
        <span id="form-feedback" class="text-xs font-mono text-gray-500"></span>
        <button
          type="submit"
          class="font-mono text-xs font-bold uppercase tracking-wider bg-white text-black hover:bg-[#ff2a2a] hover:text-white border border-white hover:border-[#ff2a2a] px-8 py-3 transition duration-150 rounded cursor-pointer"
        >
          Save Specifications
        </button>
      </div>

    </div>

    <!-- Right Column: Developer Global Actions & Stats -->
    <div class="space-y-6">
      <!-- Rename Developer Globally Card -->
      <div id="rename-dev-card" class={`bg-[#07070a] border border-[#1a1a24] p-6 rounded-lg space-y-4 ${!currentDev ? 'opacity-40 pointer-events-none' : ''}`}>
        <h2 class="text-sm font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2">
          <span class="w-1.5 h-4 bg-amber-500 inline-block"></span>
          Global Developer Rename
        </h2>
        <p class="text-xs text-gray-500 leading-relaxed font-medium">
          Renames the linked creator globally. Any changes here will automatically update this developer's name on all associated game pages.
        </p>

        <div class="space-y-3">
          <input
            type="text"
            id="dev-rename-input"
            value={currentDev?.name || ''}
            placeholder="New developer name..."
            class="w-full bg-[#050508] border border-[#1a1a24] focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded px-3 py-2 text-xs text-white focus:outline-none transition duration-150"
          />
          <button
            type="button"
            id="dev-rename-submit-btn"
            data-dev-id={currentDev?.id || ''}
            class="w-full font-mono text-xs font-bold uppercase tracking-wider border border-[#1a1a24] hover:border-amber-500 hover:bg-amber-500/10 py-2 rounded transition duration-200 cursor-pointer text-white/90"
          >
            Rename Globally
          </button>
          <span id="rename-feedback" class="block text-[10px] font-mono text-center text-gray-500"></span>
        </div>
      </div>

      <!-- Quick Tips -->
      <div class="bg-[#07070a] border border-[#1a1a24] p-6 rounded-lg space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2">
          <span class="w-1.5 h-4 bg-[#ff2a2a] inline-block"></span>
          Quick Operations Tips
        </h2>
        <ul class="text-xs text-gray-400 space-y-2 list-disc pl-4 leading-relaxed font-medium">
          <li>Type in the developer input box to search. If a developer doesn't exist, hit Tab/Enter to keep your entry, and saving will automatically register them.</li>
          <li>To hide a game page from the storefront, switch the status dropdown to <strong>Hidden</strong>.</li>
        </ul>
      </div>
    </div>
  </form>
</AdminLayout>

<script>
  // Elements
  const editForm = document.getElementById('edit-game-form') as HTMLFormElement;
  const gameTitleInput = document.getElementById('game-title') as HTMLInputElement;
  const gameStatusSelect = document.getElementById('game-status') as HTMLSelectElement;
  const gameReleaseInput = document.getElementById('game-release-date') as HTMLInputElement;
  const devSearchInput = document.getElementById('dev-search-input') as HTMLInputElement;
  const devIdHidden = document.getElementById('developer-id-val') as HTMLInputElement;
  const suggestionsBox = document.getElementById('dev-suggestions') as HTMLDivElement;
  const gameTrailerInput = document.getElementById('game-trailer') as HTMLInputElement;
  const gameCoverInput = document.getElementById('game-cover-url') as HTMLInputElement;
  const gameSummaryText = document.getElementById('game-summary') as HTMLTextAreaElement;
  const gameStorylineText = document.getElementById('game-storyline') as HTMLTextAreaElement;
  const gameIsTrendingInput = document.getElementById('game-is-trending') as HTMLInputElement;
  const formFeedback = document.getElementById('form-feedback') as HTMLSpanElement;

  const renameDevCard = document.getElementById('rename-dev-card') as HTMLDivElement;
  const devRenameInput = document.getElementById('dev-rename-input') as HTMLInputElement;
  const devRenameSubmitBtn = document.getElementById('dev-rename-submit-btn') as HTMLButtonElement;
  const renameFeedback = document.getElementById('rename-feedback') as HTMLSpanElement;

  // Scare Meter elements
  const enableScareProfileCheck = document.getElementById('enable-scare-profile') as HTMLInputElement;
  const scareSlidersContainer = document.getElementById('scare-sliders-container') as HTMLDivElement;
  const scareRating = document.getElementById('scare-rating') as HTMLInputElement;
  const dread = document.getElementById('scare-dread') as HTMLInputElement;
  const jumpscare = document.getElementById('scare-jumpscare') as HTMLInputElement;
  const psych = document.getElementById('scare-psych') as HTMLInputElement;
  const gore = document.getElementById('scare-gore') as HTMLInputElement;
  const tension = document.getElementById('scare-tension') as HTMLInputElement;
  const disturbing = document.getElementById('scare-disturbing') as HTMLInputElement;
  const isolation = document.getElementById('scare-isolation') as HTMLInputElement;
  const scareSummary = document.getElementById('scare-short-summary') as HTMLTextAreaElement;
  const playerWarningsInput = document.getElementById('scare-player-warnings') as HTMLInputElement;

  function updateScareProfileUI() {
    const enabled = enableScareProfileCheck.checked;
    if (enabled) {
      scareSlidersContainer.classList.remove('opacity-30', 'pointer-events-none');
    } else {
      scareSlidersContainer.classList.add('opacity-30', 'pointer-events-none');
    }
  }

  enableScareProfileCheck.addEventListener('change', updateScareProfileUI);
  updateScareProfileUI(); // initial run

  // Slider Label synchronization helper
  const syncLabel = (slider: HTMLInputElement, labelId: string) => {
    slider.addEventListener('input', () => {
      const lbl = document.getElementById(labelId);
      if (lbl) lbl.textContent = `${slider.value}%`;
    });
  };

  syncLabel(scareRating, 'scare-val-label');
  syncLabel(dread, 'dread-lbl');
  syncLabel(jumpscare, 'jumpscare-lbl');
  syncLabel(psych, 'psych-lbl');
  syncLabel(gore, 'gore-lbl');
  syncLabel(tension, 'tension-lbl');
  syncLabel(disturbing, 'disturbing-lbl');
  syncLabel(isolation, 'isolation-lbl');

  // Screenshots state and drag & drop selectors
  let uploadedScreenshots: string[] = Array.from(document.querySelectorAll('.remove-screenshot-btn'))
    .map((btn: any) => btn.getAttribute('data-url'))
    .filter(Boolean);
    
  const dropzone = document.getElementById('screenshot-dropzone') as HTMLDivElement;
  const fileInput = document.getElementById('screenshot-file-input') as HTMLInputElement;
  const screenshotsList = document.getElementById('screenshots-list') as HTMLDivElement;

  // Bind deletion listeners to existing items loaded on server-side
  document.querySelectorAll('.remove-screenshot-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const urlToRemove = (e.currentTarget as HTMLButtonElement).getAttribute('data-url');
      if (urlToRemove) {
        uploadedScreenshots = uploadedScreenshots.filter(url => url !== urlToRemove);
        (e.currentTarget as HTMLButtonElement).parentElement?.remove();
      }
    });
  });

  // Click dropzone to trigger hidden file input selector
  dropzone.addEventListener('click', () => {
    fileInput.click();
  });

  // Drag and drop border highlights
  ['dragenter', 'dragover'].forEach(eventName => {
    dropzone.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropzone.classList.add('border-[#ff2a2a]', 'bg-[#121217]/50');
    }, false);
  });

  ['dragleave', 'drop'].forEach(eventName => {
    dropzone.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-[#ff2a2a]', 'bg-[#121217]/50');
    }, false);
  });

  dropzone.addEventListener('drop', (e) => {
    const dt = e.dataTransfer;
    const files = dt?.files;
    if (files) {
      handleFilesUpload(files);
    }
  });

  fileInput.addEventListener('change', () => {
    const files = fileInput.files;
    if (files) {
      handleFilesUpload(files);
    }
  });

  // Concurrent Batch Uploading
  async function handleFilesUpload(files: FileList) {
    Array.from(files).forEach(async (file) => {
      const placeholderId = 'uploading-' + Math.random().toString(36).substr(2, 9);
      
      const thumb = document.createElement('div');
      thumb.id = placeholderId;
      thumb.className = 'relative group aspect-video rounded overflow-hidden border border-[#1a1a24] bg-[#0c0c12] flex items-center justify-center';
      
      const previewUrl = URL.createObjectURL(file);
      thumb.innerHTML = `
        <img src="${previewUrl}" class="w-full h-full object-cover opacity-30" />
        <div class="absolute inset-0 flex flex-col items-center justify-center p-2 text-center">
          <span class="text-[9px] font-mono text-gray-400 truncate w-full uppercase tracking-wider">${file.name}</span>
          <span class="text-[9px] font-mono font-bold text-[#ff2a2a] uppercase mt-1 animate-pulse">Uploading...</span>
        </div>
      `;
      screenshotsList.appendChild(thumb);

      try {
        const formData = new FormData();
        formData.append('file', file);

        const response = await fetch('/api/admin/upload', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (response.ok && data.url) {
          uploadedScreenshots.push(data.url);
          
          thumb.innerHTML = `
            <img src="/api/image-proxy?url=${encodeURIComponent(data.url)}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
            <button
              type="button"
              data-url="${data.url}"
              class="remove-screenshot-btn absolute top-1 right-1 bg-black/80 hover:bg-[#ff2a2a] text-white rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold transition duration-150 cursor-pointer"
            >
              &times;
            </button>
          `;

          const delBtn = thumb.querySelector('.remove-screenshot-btn');
          delBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            const urlToRemove = (e.currentTarget as HTMLButtonElement).getAttribute('data-url');
            if (urlToRemove) {
              uploadedScreenshots = uploadedScreenshots.filter(url => url !== urlToRemove);
              thumb.remove();
            }
          });
        } else {
          throw new Error('Upload failed');
        }
      } catch (err) {
        console.error('Screenshot upload failed:', err);
        thumb.innerHTML = `
          <div class="absolute inset-0 flex flex-col items-center justify-center p-2 bg-red-950/20 text-center">
            <span class="text-[9px] font-mono text-red-400 truncate w-full uppercase font-bold">Failed</span>
            <button type="button" class="mt-1 text-[8px] font-mono underline text-gray-500 hover:text-white" onclick="this.parentElement.parentElement.remove()">Dismiss</button>
          </div>
        `;
      } finally {
        URL.revokeObjectURL(previewUrl);
      }
    });
  }

  // Autocomplete variables
  let searchTimeout: any = null;

  // 1. Developer Autocomplete Handler
  devSearchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    const query = devSearchInput.value.trim();

    if (!query) {
      suggestionsBox.innerHTML = '';
      suggestionsBox.classList.add('hidden');
      devIdHidden.value = '';
      return;
    }

    searchTimeout = setTimeout(async () => {
      try {
        const response = await fetch(`/api/admin/developers?search=${encodeURIComponent(query)}`);
        const data = await response.json();

        if (response.ok && data.developers) {
          suggestionsBox.innerHTML = '';
          if (data.developers.length > 0) {
            suggestionsBox.classList.remove('hidden');
            data.developers.forEach((dev: any) => {
              const item = document.createElement('div');
              item.className = 'px-4 py-2 text-xs text-white hover:bg-[#ff2a2a]/20 cursor-pointer font-sans transition duration-100';
              item.textContent = dev.name;
              item.addEventListener('click', () => {
                devSearchInput.value = dev.name;
                devIdHidden.value = dev.id;
                suggestionsBox.classList.add('hidden');
                
                // Activate rename card
                renameDevCard.classList.remove('opacity-40', 'pointer-events-none');
                devRenameInput.value = dev.name;
                devRenameSubmitBtn.setAttribute('data-dev-id', dev.id);
              });
              suggestionsBox.appendChild(item);
            });
          } else {
            suggestionsBox.classList.add('hidden');
          }
        }
      } catch (err) {
        console.error('Failed to search developers:', err);
      }
    }, 250);
  });

  // Close suggestions box on click outside
  document.addEventListener('click', (e) => {
    if (e.target !== devSearchInput && e.target !== suggestionsBox) {
      suggestionsBox.classList.add('hidden');
    }
  });

  // 2. Edit Game Specifications Handler
  editForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    formFeedback.textContent = 'Saving changes...';
    formFeedback.style.color = '#a3a3a3';

    const title = gameTitleInput.value.trim();
    const status = gameStatusSelect.value;
    const releaseDate = gameReleaseInput.value;
    const coverUrl = gameCoverInput.value.trim();
    const trailerUrl = gameTrailerInput.value.trim();
    const summary = gameSummaryText.value.trim();
    const storyline = gameStorylineText.value.trim();

    let developerId = devIdHidden.value;
    const developerName = devSearchInput.value.trim();

    // If developer name was entered but no ID selected (meaning user entered a new creator)
    if (developerName && !developerId) {
      formFeedback.textContent = 'Registering new developer...';
      try {
        const response = await fetch('/api/admin/developers', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: developerName })
        });
        const data = await response.json();
        if (response.ok && data.developer) {
          developerId = data.developer.id;
          devIdHidden.value = developerId;
        } else {
          throw new Error('Failed to register developer');
        }
      } catch (err) {
        formFeedback.textContent = 'Failed to register developer.';
        formFeedback.style.color = '#ef4444';
        return;
      }
    }

    // Assemble checked platforms list
    const checkedPlats = Array.from(document.querySelectorAll('input[name="platforms"]:checked'))
      .map((checkbox: any) => checkbox.value);

    // Assemble Scare Meter structure
    let scareRatingVal = null;
    let scareProfileObj = null;

    if (enableScareProfileCheck.checked) {
      scareRatingVal = parseFloat(scareRating.value) || 0;
      const warnings = playerWarningsInput.value
        .split(',')
        .map(w => w.trim().toUpperCase())
        .filter(Boolean);

      scareProfileObj = {
        dread: parseInt(dread.value) || 0,
        jumpscare: parseInt(jumpscare.value) || 0,
        psychological: parseInt(psych.value) || 0,
        gore: parseInt(gore.value) || 0,
        tension: parseInt(tension.value) || 0,
        disturbing: parseInt(disturbing.value) || 0,
        isolation: parseInt(isolation.value) || 0,
        shortSummary: scareSummary.value.trim() || undefined,
        playerWarnings: warnings.length > 0 ? warnings : undefined
      };
    }

    try {
      const pathname = window.location.pathname;
      const gameId = pathname.substring(pathname.lastIndexOf('/') + 1);

      const response = await fetch(`/api/admin/games/${gameId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: title,
          status: status,
          releaseDate: releaseDate || null,
          coverUrl: coverUrl || null,
          trailerUrl: trailerUrl || null,
          summary: summary || null,
          storyline: storyline || null,
          scareRating: scareRatingVal,
          scareProfile: scareProfileObj,
          developerId: developerName ? developerId : null,
          platformIds: checkedPlats,
          screenshots: uploadedScreenshots,
          isTrending: gameIsTrendingInput.checked
        })
      });

      if (response.ok) {
        formFeedback.textContent = 'Changes saved successfully!';
        formFeedback.style.color = '#22c55e';
        setTimeout(() => {
          formFeedback.textContent = '';
        }, 3000);
      } else {
        throw new Error('Failed to save specifications');
      }
    } catch (err) {
      formFeedback.textContent = 'Failed to save changes.';
      formFeedback.style.color = '#ef4444';
    }
  });

  // 3. Rename Developer Globally Handler
  devRenameSubmitBtn.addEventListener('click', async () => {
    const devId = devRenameSubmitBtn.getAttribute('data-dev-id');
    const newName = devRenameInput.value.trim();

    if (!devId || !newName) return;

    renameFeedback.textContent = 'Renaming globally...';
    renameFeedback.style.color = '#a3a3a3';
    devRenameSubmitBtn.disabled = true;

    try {
      const response = await fetch(`/api/admin/developers/${devId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: newName })
      });

      if (response.ok) {
        renameFeedback.textContent = 'Developer renamed globally!';
        renameFeedback.style.color = '#22c55e';
        devSearchInput.value = newName; // Update main form field value
        
        setTimeout(() => {
          renameFeedback.textContent = '';
        }, 3000);
      } else {
        throw new Error('Global rename failed');
      }
    } catch (err) {
      renameFeedback.textContent = 'Failed to rename developer.';
      renameFeedback.style.color = '#ef4444';
    } finally {
      devRenameSubmitBtn.disabled = false;
    }
  });
</script>
