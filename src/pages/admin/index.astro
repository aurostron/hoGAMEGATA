---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { turso } from '../../lib/turso';
import { games, priceSnapshots, tags } from '../../db/schema';
import { count, isNull } from 'drizzle-orm';
import { env as cfEnv } from 'cloudflare:workers';

// Fetch current actual counts from Turso
let gamesCount = 0;
let unratedCount = 0;
let pricesCount = 0;
let tagsCount = 0;

try {
  const [
    [{ count: totalGames }],
    [{ count: totalUnrated }],
    [{ count: totalPrices }],
    [{ count: totalTags }],
  ] = await Promise.all([
    turso.select({ count: count() }).from(games),
    turso.select({ count: count() }).from(games).where(isNull(games.scareRating)),
    turso.select({ count: count() }).from(priceSnapshots),
    turso.select({ count: count() }).from(tags),
  ]);

  gamesCount = totalGames;
  unratedCount = totalUnrated;
  pricesCount = totalPrices;
  tagsCount = totalTags;
} catch (err) {
  console.error("Failed to query Admin metrics:", err);
}

// Read maintenance mode state from Cloudflare KV
let isMaintenanceOn = false;
try {
  const kv = (cfEnv as any).MAINTENANCE as KVNamespace | undefined;
  if (kv) {
    const status = await kv.get('status');
    isMaintenanceOn = status === 'on';
  }
} catch (err) {
  console.error('Failed to read maintenance KV:', err);
}

// Mock system services status checks
const systemStatus = [
  { name: 'Turso Edge DB', status: 'Healthy', latency: '< 5ms', type: 'success' },
  { name: 'Supabase Auth Server', status: 'Healthy', latency: '62ms', type: 'success' },
  { name: 'Cloudflare Workers Runtime', status: 'Healthy', latency: '1ms', type: 'success' },
  { name: 'Scare Meter AI Engine', status: 'Idle', latency: 'N/A', type: 'warning' },
];
---

<AdminLayout title="Dashboard" activeTab="dashboard">
  <!-- Heading Section -->
  <div class="flex items-center justify-between pb-4 border-b border-[#1a1a24]">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-white uppercase font-heading">
        Ops Dashboard
      </h1>
      <p class="text-sm text-gray-400 mt-1">Real-time status and telemetry of the GameGata engine.</p>
    </div>
    <span class="text-xs font-sans border border-green-500/30 text-green-400 bg-green-500/10 px-3 py-1 rounded-md flex items-center space-x-1.5 animate-pulse">
      <span class="h-2 w-2 rounded-full bg-green-500 block"></span>
      <span>Engine Online</span>
    </span>
  </div>

  <!-- Metric Grid -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <!-- Total Games Card -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-5 hover:border-gray-700 transition duration-200">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold font-sans text-gray-500 uppercase tracking-wider">Catalog Games</span>
        <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
      </div>
      <p class="text-3xl font-bold text-white mt-2 font-sans">
        {gamesCount.toLocaleString()}
      </p>
      <div class="flex items-center space-x-1.5 mt-2 text-xs text-green-400 font-medium">
        <span>100% migrated to Turso Edge</span>
      </div>
    </div>

    <!-- AI Unprocessed Card -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-5 hover:border-gray-700 transition duration-200">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold font-sans text-gray-500 uppercase tracking-wider">Awaiting Scare Rating</span>
        <svg class="h-5 w-5 text-[#ff2a2a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <p class="text-3xl font-bold text-white mt-2 font-sans">
        {unratedCount.toLocaleString()}
      </p>
      <div class="flex items-center space-x-1.5 mt-2 text-xs text-gray-400 font-medium">
        <span>{~Math.round((unratedCount / (gamesCount || 1)) * 100)}% of catalog needs analysis</span>
      </div>
    </div>

    <!-- Price Snapshots Card -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-5 hover:border-gray-700 transition duration-200">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold font-sans text-gray-500 uppercase tracking-wider">Indexed Prices</span>
        <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="text-3xl font-bold text-white mt-2 font-sans">
        {pricesCount.toLocaleString()}
      </p>
      <div class="flex items-center space-x-1.5 mt-2 text-xs text-green-400 font-medium">
        <span>Multi-store tracks active</span>
      </div>
    </div>

    <!-- Total Tags Card -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-5 hover:border-gray-700 transition duration-200">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold font-sans text-gray-500 uppercase tracking-wider">Taxonomy Tags</span>
        <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <p class="text-3xl font-bold text-white mt-2 font-sans">
        {tagsCount.toLocaleString()}
      </p>
      <div class="flex items-center space-x-1.5 mt-2 text-xs text-gray-400 font-medium">
        <span>Horror DNA mapping nodes</span>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
    <!-- System Telemetry -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-6 md:col-span-2 space-y-4">
      <h3 class="text-lg font-bold text-white uppercase tracking-tight">System Telemetry</h3>
      <div class="divide-y divide-[#1a1a24]">
        {systemStatus.map((service) => (
          <div class="flex items-center justify-between py-3">
            <span class="text-sm font-semibold text-gray-300">{service.name}</span>
            <div class="flex items-center space-x-4">
              <span class="text-xs text-gray-400 font-sans">{service.latency}</span>
              <span class={`text-[10px] uppercase font-bold font-sans px-2 py-0.5 rounded ${
                service.type === 'success' 
                  ? 'bg-green-500/10 text-green-400 border border-green-500/20' 
                  : 'bg-yellow-500/10 text-yellow-400 border border-yellow-500/20'
              }`}>
                {service.status}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Maintenance Mode Toggle -->
    <div class={`bg-[#07070a] border rounded-lg p-6 space-y-4 ${isMaintenanceOn ? 'border-red-500/40' : 'border-[#1a1a24]'}`}>
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-bold text-white uppercase tracking-tight">Maintenance Mode</h3>
        <span class={`text-[10px] font-bold font-sans px-2 py-0.5 rounded uppercase ${
          isMaintenanceOn
            ? 'bg-red-500/15 text-red-400 border border-red-500/30'
            : 'bg-green-500/10 text-green-400 border border-green-500/20'
        }`}>
          {isMaintenanceOn ? 'Active' : 'Inactive'}
        </span>
      </div>
      <p class="text-xs text-gray-500">
        {isMaintenanceOn
          ? 'Site is in maintenance mode. Only you can see it (bypass cookie active).'
          : 'Site is live. All visitors can access it normally.'}
      </p>
      <div class="space-y-2 pt-1">
        {isMaintenanceOn ? (
          <a
            href="/api/maintenance/toggle?state=off"
            class="w-full flex items-center justify-center space-x-2 py-2 px-4 bg-green-600 hover:bg-green-500 text-white rounded font-bold text-sm transition duration-150"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Turn Site Live</span>
          </a>
        ) : (
          <a
            href="/api/maintenance/toggle?state=on"
            class="w-full flex items-center justify-center space-x-2 py-2 px-4 bg-[#ff2a2a] hover:bg-[#d91e1e] text-white rounded font-bold text-sm transition duration-150"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Enable Maintenance</span>
          </a>
        )}
        <a
          href="/api/maintenance/toggle?clear_cookie=true"
          class="w-full flex items-center justify-center py-2 px-4 border border-[#1a1a24] hover:bg-[#121217] text-gray-400 rounded font-bold text-xs transition duration-150"
        >
          Test: Clear My Bypass Cookie
        </a>
      </div>
    </div>

    <!-- Quick Operations -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-6 space-y-4">
      <h3 class="text-lg font-bold text-white uppercase tracking-tight">Quick Actions</h3>
      <div class="space-y-3 pt-2">
        <a href="/admin/announcements" class="w-full flex items-center justify-center space-x-2 py-2 px-4 bg-white hover:bg-neutral-200 text-black rounded font-bold text-sm transition duration-150">
          <span>📢 Publish Announcements & Updates</span>
        </a>
        <a href="/admin/edits" class="w-full flex items-center justify-center space-x-2 py-2 px-4 bg-purple-600 hover:bg-purple-500 text-white rounded font-bold text-sm transition duration-150">
          <span>✏️ Moderation & Edits Queue</span>
        </a>
        <a href="/admin/bugs" class="w-full flex items-center justify-center space-x-2 py-2 px-4 bg-red-600 hover:bg-red-500 text-white rounded font-bold text-sm transition duration-150">
          <span>Bug & Issue Reports</span>
        </a>
        <a href="/admin/content" class="w-full flex items-center justify-center space-x-2 py-2 px-4 border border-[#1a1a24] hover:bg-[#121217] text-white rounded font-bold text-sm transition duration-150">
          <span>Edit Homepage Copy</span>
        </a>
        <a href="/admin/games" class="w-full flex items-center justify-center space-x-2 py-2 px-4 border border-[#1a1a24] hover:bg-[#121217] text-white rounded font-bold text-sm transition duration-150">
          <span>Manage Game Catalog</span>
        </a>
        <a href="/admin/imports" class="w-full flex items-center justify-center space-x-2 py-2 px-4 border border-[#1a1a24] hover:bg-[#121217] text-white rounded font-bold text-sm transition duration-150">
          <span>Run Data Ingestion</span>
        </a>
      </div>
    </div>
  </div>
</AdminLayout>
