---
import Layout from '../../layouts/Layout.astro';
import { BugManagementQueue } from '../../components/bugs/BugManagementQueue';

export const prerender = false;
---

<Layout title="Bug & Issue Reports - hoGAMEGATA Admin">
  <main className="min-h-screen bg-black text-zinc-100 py-10 px-4 sm:px-6 lg:px-8">
    <div className="max-w-6xl mx-auto space-y-8">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-800 pb-6">
        <div>
          <div className="flex items-center gap-3">
            <span className="px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-mono font-bold uppercase tracking-wider">
              Admin Console
            </span>
            <span className="text-xs text-zinc-500 font-mono">/admin/bugs</span>
          </div>
          <h1 className="text-3xl font-extrabold text-white tracking-tight mt-2">
            Bug & Issue Reports
          </h1>
          <p className="text-sm text-zinc-400 mt-1">
            Review user-submitted bug tickets, metadata complaints, and broken link reports.
          </p>
        </div>

        {/* Console Navigation Links */}
        <div className="flex items-center gap-2">
          <a
            href="/admin"
            className="px-3.5 py-2 rounded-xl border border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-white hover:border-zinc-700 text-xs font-semibold transition-colors"
          >
            ← Admin Dashboard
          </a>
          <a
            href="/admin/edits"
            className="px-3.5 py-2 rounded-xl border border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-white hover:border-zinc-700 text-xs font-semibold transition-colors"
          >
            ✏️ Edit Queue
          </a>
        </div>
      </div>

      {/* Main Bug Management Queue Component */}
      <BugManagementQueue client:load />
    </div>
  </main>
</Layout>
