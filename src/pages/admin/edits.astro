---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ModerationQueue } from '../../components/editing/ModerationQueue';
---

<AdminLayout title="Edit Moderation Queue" activeTab="edits">
  <div className="space-y-6">
    <div className="flex items-center justify-between pb-4 border-b border-[#1a1a24]">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-white uppercase font-heading">
          Community Edit Queue
        </h1>
        <p class="text-xs font-sans text-zinc-400 mt-1">
          Review, approve, or reject user-submitted game metadata edits. Approvals update the database directly and invalidate CDN cache tags.
        </p>
      </div>
    </div>

    <ModerationQueue client:load />
  </div>
</AdminLayout>
