---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { turso } from '../../lib/turso';
import { analyticsEvents, analyticsDaily } from '../../db/schema';
import { eq, desc, and, gte, sum, sql } from 'drizzle-orm';
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

// 1. Measure actual database latency
const dbPingStart = Date.now();
let dbLatency = 0;
let dbConnected = false;
try {
  await turso.run(sql`SELECT 1`);
  dbLatency = Date.now() - dbPingStart;
  dbConnected = true;
} catch (e) {
  console.error("DB Ping failed:", e);
}

// 2. Fetch default 7d stats for SSR initial load
const initialRange = "7d";
const rangeDays = 7;
const today = new Date();
const startDate = new Date();
startDate.setDate(today.getDate() - rangeDays);
const startDateString = startDate.toISOString().split("T")[0];

let dailySeries: any[] = [];
let totals = { views: 0, clicks: 0, searches: 0 };
let topGames: any[] = [];
let topSearches: any[] = [];
let topLinks: any[] = [];

try {
  const [
    seriesData,
    [totalsResult],
    gamesData,
    searchesData,
    linksData
  ] = await Promise.all([
    turso
      .select()
      .from(analyticsDaily)
      .where(gte(analyticsDaily.date, startDateString))
      .orderBy(analyticsDaily.date),

    turso
      .select({
        views: sum(analyticsDaily.totalViews),
        clicks: sum(analyticsDaily.totalClicks),
        searches: sum(analyticsDaily.totalSearches),
      })
      .from(analyticsDaily)
      .where(gte(analyticsDaily.date, startDateString)),

    turso
      .select({
        gameId: analyticsEvents.refId,
        title: analyticsEvents.refTitle,
        views: sum(analyticsEvents.count),
      })
      .from(analyticsEvents)
      .where(
        and(
          eq(analyticsEvents.type, "game_view"),
          gte(analyticsEvents.date, startDateString)
        )
      )
      .groupBy(analyticsEvents.refId, analyticsEvents.refTitle)
      .orderBy(desc(sum(analyticsEvents.count)))
      .limit(10),

    turso
      .select({
        query: analyticsEvents.refTitle,
        count: sum(analyticsEvents.count),
      })
      .from(analyticsEvents)
      .where(
        and(
          eq(analyticsEvents.type, "search"),
          gte(analyticsEvents.date, startDateString)
        )
      )
      .groupBy(analyticsEvents.refId, analyticsEvents.refTitle)
      .orderBy(desc(sum(analyticsEvents.count)))
      .limit(10),

    turso
      .select({
        linkId: analyticsEvents.refId,
        title: analyticsEvents.refTitle,
        count: sum(analyticsEvents.count),
      })
      .from(analyticsEvents)
      .where(
        and(
          eq(analyticsEvents.type, "link_click"),
          gte(analyticsEvents.date, startDateString)
        )
      )
      .groupBy(analyticsEvents.refId, analyticsEvents.refTitle)
      .orderBy(desc(sum(analyticsEvents.count)))
      .limit(10),
  ]);

  dailySeries = seriesData;
  totals = {
    views: Number(totalsResult?.views || 0),
    clicks: Number(totalsResult?.clicks || 0),
    searches: Number(totalsResult?.searches || 0),
  };
  topGames = gamesData;
  topSearches = searchesData;
  topLinks = linksData;
} catch (err) {
  console.error("Failed to load initial analytics:", err);
}

// Calculate max daily value for relative scaling in chart
const maxVal = Math.max(
  ...dailySeries.map((d) => Math.max(d.totalViews || 0, d.totalClicks || 0)),
  1
);
---

<AdminLayout title="Analytics & Telemetry" activeTab="analytics">
  <!-- Heading Section -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#1a1a24]">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-white uppercase font-heading">
        Analytics
      </h1>
      <p class="text-sm text-gray-400 mt-1">Traffic telemetry, store conversions, and user search trends.</p>
    </div>
    
    <!-- Timeframe Selection -->
    <div class="flex bg-[#07070a] border border-[#1a1a24] rounded-md p-1 self-start sm:self-center">
      <button
        id="range-7d"
        class="timeframe-btn px-4 py-1.5 rounded text-xs font-mono font-bold uppercase transition duration-150 bg-[#ff2a2a] text-white cursor-pointer"
        data-range="7d"
      >
        7 Days
      </button>
      <button
        id="range-30d"
        class="timeframe-btn px-4 py-1.5 rounded text-xs font-mono font-bold uppercase transition duration-150 text-gray-400 hover:text-white cursor-pointer"
        data-range="30d"
      >
        30 Days
      </button>
    </div>
  </div>

  <!-- Metric Aggregate Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 pt-2">
    <!-- Page Views Card -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold font-mono text-gray-500 uppercase tracking-wider">Catalog Views</span>
        <svg class="h-4 w-4 text-[#ff2a2a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
      </div>
      <p id="total-views" class="text-3xl font-bold text-white mt-2 font-mono">
        {totals.views.toLocaleString()}
      </p>
      <span class="block text-[10px] text-gray-500 font-mono mt-1">TOTAL GAME DETAILS PAGE LOADS</span>
    </div>

    <!-- Link Clicks Card -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold font-mono text-gray-500 uppercase tracking-wider">Outbound Clicks</span>
        <svg class="h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </div>
      <p id="total-clicks" class="text-3xl font-bold text-white mt-2 font-mono">
        {totals.clicks.toLocaleString()}
      </p>
      <span class="block text-[10px] text-gray-500 font-mono mt-1">TOTAL STOREFRONT REDIRECTS</span>
    </div>

    <!-- Searches Card -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold font-mono text-gray-500 uppercase tracking-wider">Queries Logged</span>
        <svg class="h-4 w-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <p id="total-searches" class="text-3xl font-bold text-white mt-2 font-mono">
        {totals.searches.toLocaleString()}
      </p>
      <span class="block text-[10px] text-gray-500 font-mono mt-1">TOTAL KEYWORD QUERIES RUN</span>
    </div>
  </div>

  <!-- Daily Traffic Series Chart Card -->
  <div class="bg-[#07070a] border border-[#1a1a24] p-5 rounded-lg space-y-4">
    <div class="flex items-center justify-between border-b border-[#1a1a24] pb-3">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2">
        <span class="w-1.5 h-4 bg-[#ff2a2a] inline-block"></span>
        Daily Traffic Trends
      </h3>
      <div class="flex items-center space-x-4 text-[10px] font-mono font-bold uppercase tracking-wider">
        <div class="flex items-center space-x-1.5">
          <span class="h-2 w-2 bg-[#ff2a2a] rounded-full"></span>
          <span class="text-gray-400">Views</span>
        </div>
        <div class="flex items-center space-x-1.5">
          <span class="h-2 w-2 bg-gray-500 rounded-full"></span>
          <span class="text-gray-400">Clicks</span>
        </div>
      </div>
    </div>

    <!-- Chart Graph Container -->
    <div id="chart-viewport" class="pt-4">
      {dailySeries.length === 0 ? (
        <div class="h-64 flex items-center justify-center border border-[#1a1a24]/50 rounded bg-black/20 text-xs font-mono text-gray-500 uppercase">
          [ No telemetry data captured in this range ]
        </div>
      ) : (
        <div id="chart-bars" class="h-64 flex items-end justify-between gap-1.5 sm:gap-4 border-b border-[#1a1a24] pb-2 px-2 overflow-x-auto select-none">
          {dailySeries.map((day) => {
            const viewPct = Math.round(((day.totalViews || 0) / maxVal) * 100);
            const clickPct = Math.round(((day.totalClicks || 0) / maxVal) * 100);
            const dateLabel = new Date(day.date).toLocaleDateString(undefined, { weekday: 'short', month: 'numeric', day: 'numeric' });
            
            return (
              <div class="flex-1 min-w-[36px] flex flex-col items-center h-full justify-end group relative">
                <!-- Hover Tooltip -->
                <div class="absolute bottom-full mb-2 bg-[#0c0c12] border border-[#1a1a24] rounded px-2.5 py-1.5 text-[10px] font-mono text-gray-300 shadow-xl opacity-0 group-hover:opacity-100 transition-opacity duration-150 pointer-events-none z-10 w-32 text-center">
                  <p class="font-bold border-b border-[#1a1a24]/50 pb-1 mb-1 font-sans">{day.date}</p>
                  <p class="flex justify-between font-mono">
                    <span>Views:</span> 
                    <span class="text-[#ff2a2a] font-bold">{day.totalViews}</span>
                  </p>
                  <p class="flex justify-between font-mono">
                    <span>Clicks:</span> 
                    <span class="text-white font-bold">{day.totalClicks}</span>
                  </p>
                </div>
                
                <!-- Bars Graph -->
                <div class="w-full flex items-end justify-center gap-0.5 h-full max-h-[85%]">
                  <!-- Views Bar -->
                  <div
                    class="w-2.5 sm:w-4 bg-[#ff2a2a] hover:bg-[#ff4f4f] rounded-t transition-all duration-300"
                    style={`height: ${viewPct}%`}
                  ></div>
                  <!-- Clicks Bar -->
                  <div
                    class="w-2.5 sm:w-4 bg-gray-500 hover:bg-gray-400 rounded-t transition-all duration-300"
                    style={`height: ${clickPct}%`}
                  ></div>
                </div>
                
                <!-- X-Axis date label -->
                <span class="text-[9px] font-mono text-gray-500 mt-2 truncate w-full text-center">
                  {dateLabel}
                </span>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Top Metrics Split Grid (Views vs. Searches vs. Clicks) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 pt-2">
    <!-- Top Viewed Games Table -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-5 space-y-4">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white font-mono border-b border-[#1a1a24] pb-2 flex items-center gap-2">
        <span class="w-1.5 h-3 bg-[#ff2a2a] inline-block"></span>
        Top Viewed Games
      </h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead>
            <tr class="text-gray-500 border-b border-[#1a1a24] pb-2 text-[10px] uppercase font-bold">
              <th class="pb-2">Game Title</th>
              <th class="pb-2 text-right">Views</th>
            </tr>
          </thead>
          <tbody id="top-games-tbody" class="divide-y divide-[#1a1a24]/30">
            {topGames.length === 0 ? (
              <tr>
                <td colspan="2" class="py-8 text-center text-gray-600 italic">No views registered</td>
              </tr>
            ) : (
              topGames.map((item) => (
                <tr class="hover:bg-[#121217]/30">
                  <td class="py-2.5 text-gray-300 font-sans font-medium truncate max-w-[160px]">
                    <a href={`/admin/games/edit/${item.gameId}`} class="hover:text-[#ff2a2a] transition duration-100">
                      {item.title || 'Unknown Game'}
                    </a>
                  </td>
                  <td class="py-2.5 text-right text-[#ff2a2a] font-bold">{Number(item.views).toLocaleString()}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Top Search Queries Table -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-5 space-y-4">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white font-mono border-b border-[#1a1a24] pb-2 flex items-center gap-2">
        <span class="w-1.5 h-3 bg-[#ff2a2a] inline-block"></span>
        Top Search Queries
      </h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead>
            <tr class="text-gray-500 border-b border-[#1a1a24] pb-2 text-[10px] uppercase font-bold">
              <th class="pb-2">Search Query</th>
              <th class="pb-2 text-right">Count</th>
            </tr>
          </thead>
          <tbody id="top-searches-tbody" class="divide-y divide-[#1a1a24]/30">
            {topSearches.length === 0 ? (
              <tr>
                <td colspan="2" class="py-8 text-center text-gray-600 italic">No searches logged</td>
              </tr>
            ) : (
              topSearches.map((item) => (
                <tr class="hover:bg-[#121217]/30">
                  <td class="py-2.5 text-gray-300 font-sans font-medium">"{item.query}"</td>
                  <td class="py-2.5 text-right text-blue-400 font-bold">{Number(item.count).toLocaleString()}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Top Storefront Clicks Table -->
    <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-5 space-y-4">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white font-mono border-b border-[#1a1a24] pb-2 flex items-center gap-2">
        <span class="w-1.5 h-3 bg-[#ff2a2a] inline-block"></span>
        Top Storefront Clicks
      </h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead>
            <tr class="text-gray-500 border-b border-[#1a1a24] pb-2 text-[10px] uppercase font-bold">
              <th class="pb-2">Destination Store</th>
              <th class="pb-2 text-right">Clicks</th>
            </tr>
          </thead>
          <tbody id="top-links-tbody" class="divide-y divide-[#1a1a24]/30">
            {topLinks.length === 0 ? (
              <tr>
                <td colspan="2" class="py-8 text-center text-gray-600 italic">No redirects tracked</td>
              </tr>
            ) : (
              topLinks.map((item) => {
                const parts = item.linkId?.split(":") || [];
                const storeName = parts[parts.length - 1] || "Link";
                return (
                  <tr class="hover:bg-[#121217]/30">
                    <td class="py-2.5 text-gray-300 font-sans font-medium capitalize flex flex-col">
                      <span>{item.title || 'Store Link'}</span>
                      <span class="text-[9px] font-mono text-gray-500 uppercase">{storeName}</span>
                    </td>
                    <td class="py-2.5 text-right text-green-400 font-bold">{Number(item.count).toLocaleString()}</td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Real-Time Telemetry & Systems Health Card -->
  <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg p-6 space-y-4">
    <div class="flex items-center justify-between border-b border-[#1a1a24] pb-3">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2">
        <span class="w-1.5 h-4 bg-[#ff2a2a] inline-block"></span>
        System Latency & Node Health
      </h3>
      <span class="text-xs font-mono border border-green-500/30 text-green-400 bg-green-500/10 px-3 py-0.5 rounded flex items-center space-x-1.5">
        <span class="h-2 w-2 rounded-full bg-green-500 block animate-pulse"></span>
        <span>Monitoring Active</span>
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
      <!-- Database Telemetry -->
      <div class="border border-[#1a1a24] rounded-lg p-4 bg-black/25 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-bold font-mono text-gray-500 uppercase">Turso Edge Database</span>
          <p class="text-xl font-bold text-white mt-1 font-mono">{dbConnected ? "Connected" : "Disconnected"}</p>
        </div>
        <div class="mt-4 pt-2 border-t border-[#1a1a24]/30 flex justify-between items-baseline text-xs font-mono">
          <span class="text-gray-400">Ping latency:</span>
          <span class={`font-bold ${dbLatency < 50 ? 'text-green-400' : 'text-yellow-400'}`}>{dbLatency} ms</span>
        </div>
      </div>

      <!-- Server Environment -->
      <div class="border border-[#1a1a24] rounded-lg p-4 bg-black/25 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-bold font-mono text-gray-500 uppercase">Cloudflare Edge Host</span>
          <p class="text-xl font-bold text-white mt-1 font-mono">v8 workerd</p>
        </div>
        <div class="mt-4 pt-2 border-t border-[#1a1a24]/30 flex justify-between items-baseline text-xs font-mono">
          <span class="text-gray-400">Memory profile:</span>
          <span class="text-gray-300 font-bold">Standard Isolation</span>
        </div>
      </div>

      <!-- Cache Policy -->
      <div class="border border-[#1a1a24] rounded-lg p-4 bg-black/25 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-bold font-mono text-gray-500 uppercase">Analytics Cache policy</span>
          <p class="text-xl font-bold text-white mt-1 font-mono">60s Bypass</p>
        </div>
        <div class="mt-4 pt-2 border-t border-[#1a1a24]/30 flex justify-between items-baseline text-xs font-mono">
          <span class="text-gray-400">Aggregation type:</span>
          <span class="text-gray-300 font-bold uppercase">Upsert Daily</span>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // Range selection interactivity
  const btns = document.querySelectorAll(".timeframe-btn");
  
  btns.forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const range = target.getAttribute("data-range");
      if (!range) return;

      // Update button visual states
      btns.forEach((b) => {
        b.classList.remove("bg-[#ff2a2a]", "text-white");
        b.classList.add("text-gray-400", "hover:text-white");
      });
      target.classList.remove("text-gray-400", "hover:text-white");
      target.classList.add("bg-[#ff2a2a]", "text-white");

      // Fetch analytics data
      try {
        const response = await fetch(`/api/admin/analytics?range=${range}`);
        if (!response.ok) throw new Error("API error");
        
        const data = await response.json();

        // 1. Update totals
        document.getElementById("total-views")!.innerText = Number(data.totals.views).toLocaleString();
        document.getElementById("total-clicks")!.innerText = Number(data.totals.clicks).toLocaleString();
        document.getElementById("total-searches")!.innerText = Number(data.totals.searches).toLocaleString();

        // 2. Re-render daily trend chart
        const chartViewport = document.getElementById("chart-viewport")!;
        if (data.dailySeries.length === 0) {
          chartViewport.innerHTML = `
            <div class="h-64 flex items-center justify-center border border-[#1a1a24]/50 rounded bg-black/20 text-xs font-mono text-gray-500 uppercase">
              [ No telemetry data captured in this range ]
            </div>
          `;
        } else {
          // Re-calculate max relative value
          const maxVal = Math.max(...data.dailySeries.map((d: any) => Math.max(d.totalViews || 0, d.totalClicks || 0)), 1);
          
          let barsHtml = `<div id="chart-bars" class="h-64 flex items-end justify-between gap-1.5 sm:gap-4 border-b border-[#1a1a24] pb-2 px-2 overflow-x-auto select-none">`;
          
          data.dailySeries.forEach((day: any) => {
            const viewPct = Math.round(((day.totalViews || 0) / maxVal) * 100);
            const clickPct = Math.round(((day.totalClicks || 0) / maxVal) * 100);
            const dateLabel = new Date(day.date).toLocaleDateString(undefined, { weekday: "short", month: "numeric", day: "numeric" });
            
            barsHtml += `
              <div class="flex-1 min-w-[36px] flex flex-col items-center h-full justify-end group relative">
                <div class="absolute bottom-full mb-2 bg-[#0c0c12] border border-[#1a1a24] rounded px-2.5 py-1.5 text-[10px] font-mono text-gray-300 shadow-xl opacity-0 group-hover:opacity-100 transition-opacity duration-150 pointer-events-none z-10 w-32 text-center">
                  <p class="font-bold border-b border-[#1a1a24]/50 pb-1 mb-1 font-sans">${day.date}</p>
                  <p class="flex justify-between font-mono"><span>Views:</span> <span class="text-[#ff2a2a] font-bold">${day.totalViews}</span></p>
                  <p class="flex justify-between font-mono"><span>Clicks:</span> <span class="text-white font-bold">${day.totalClicks}</span></p>
                </div>
                
                <div class="w-full flex items-end justify-center gap-0.5 h-full max-h-[85%]">
                  <div class="w-2.5 sm:w-4 bg-[#ff2a2a] hover:bg-[#ff4f4f] rounded-t transition-all duration-300" style="height: ${viewPct}%"></div>
                  <div class="w-2.5 sm:w-4 bg-gray-500 hover:bg-gray-400 rounded-t transition-all duration-300" style="height: ${clickPct}%"></div>
                </div>
                
                <span class="text-[9px] font-mono text-gray-500 mt-2 truncate w-full text-center">${dateLabel}</span>
              </div>
            `;
          });
          
          barsHtml += `</div>`;
          chartViewport.innerHTML = barsHtml;
        }

        // 3. Update Top viewed games
        const gamesTbody = document.getElementById("top-games-tbody")!;
        if (data.topGames.length === 0) {
          gamesTbody.innerHTML = `<tr><td colspan="2" class="py-8 text-center text-gray-600 italic">No views registered</td></tr>`;
        } else {
          gamesTbody.innerHTML = data.topGames
            .map((item: any) => `
              <tr class="hover:bg-[#121217]/30">
                <td class="py-2.5 text-gray-300 font-sans font-medium truncate max-w-[160px]">
                  <a href="/admin/games/edit/${item.gameId}" class="hover:text-[#ff2a2a] transition duration-100">
                    ${item.title || "Unknown Game"}
                  </a>
                </td>
                <td class="py-2.5 text-right text-[#ff2a2a] font-bold">${Number(item.views).toLocaleString()}</td>
              </tr>
            `)
            .join("");
        }

        // 4. Update Top search queries
        const searchesTbody = document.getElementById("top-searches-tbody")!;
        if (data.topSearches.length === 0) {
          searchesTbody.innerHTML = `<tr><td colspan="2" class="py-8 text-center text-gray-600 italic">No searches logged</td></tr>`;
        } else {
          searchesTbody.innerHTML = data.topSearches
            .map((item: any) => `
              <tr class="hover:bg-[#121217]/30">
                <td class="py-2.5 text-gray-300 font-sans font-medium">"${item.query}"</td>
                <td class="py-2.5 text-right text-blue-400 font-bold">${Number(item.count).toLocaleString()}</td>
              </tr>
            `)
            .join("");
        }

        // 5. Update Top store links
        const linksTbody = document.getElementById("top-links-tbody")!;
        if (data.topLinks.length === 0) {
          linksTbody.innerHTML = `<tr><td colspan="2" class="py-8 text-center text-gray-600 italic">No redirects tracked</td></tr>`;
        } else {
          linksTbody.innerHTML = data.topLinks
            .map((item: any) => {
              const parts = item.linkId?.split(":") || [];
              const storeName = parts[parts.length - 1] || "Link";
              return `
                <tr class="hover:bg-[#121217]/30">
                  <td class="py-2.5 text-gray-300 font-sans font-medium capitalize flex flex-col">
                    <span>${item.title || "Store Link"}</span>
                    <span class="text-[9px] font-mono text-gray-500 uppercase">${storeName}</span>
                  </td>
                  <td class="py-2.5 text-right text-green-400 font-bold">${Number(item.count).toLocaleString()}</td>
                </tr>
              `;
            })
            .join("");
        }
      } catch (err) {
        console.error("Failed to refresh analytics timeframe:", err);
      }
    });
  });
</script>
