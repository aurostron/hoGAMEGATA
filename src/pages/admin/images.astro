---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { turso } from '../../lib/turso';
import { games } from '../../db/schema';
import { isNotNull, or, desc } from 'drizzle-orm';

export const prerender = false;

interface GameCollection {
  id: string;
  title: string;
  slug: string;
  coverUrl: string | null;
  screenshots: string[];
  totalAssets: number;
  catboxCount: number;
  hasCover: boolean;
  hosts: string[];
}

let gameCollections: GameCollection[] = [];
let totalGamesWithMedia = 0;
let totalMediaAssets = 0;
let totalCatboxAssets = 0;

try {
  const dbGames = await turso
    .select({
      id: games.id,
      title: games.title,
      slug: games.slug,
      coverUrl: games.coverUrl,
      screenshots: games.screenshots,
    })
    .from(games)
    .where(or(isNotNull(games.coverUrl), isNotNull(games.screenshots)))
    .orderBy(desc(games.id))
    .limit(300);

  for (const g of dbGames) {
    const title = g.title || "Untitled Game";
    const slug = g.slug || "";
    let screenshots: string[] = [];
    let catboxCount = 0;
    const hostsSet = new Set<string>();

    if (g.coverUrl) {
      if (g.coverUrl.includes("catbox.moe")) catboxCount++;
      try {
        hostsSet.add(new URL(g.coverUrl).hostname.replace("www.", ""));
      } catch (e) {}
    }

    if (g.screenshots) {
      try {
        const parsed = JSON.parse(g.screenshots);
        if (Array.isArray(parsed)) {
          screenshots = parsed.filter((u): u is string => typeof u === "string" && u.trim().length > 0);
          screenshots.forEach((u) => {
            if (u.includes("catbox.moe")) catboxCount++;
            try {
              hostsSet.add(new URL(u).hostname.replace("www.", ""));
            } catch (e) {}
          });
        }
      } catch (e) {}
    }

    const totalAssets = (g.coverUrl ? 1 : 0) + screenshots.length;

    if (totalAssets > 0) {
      totalGamesWithMedia++;
      totalMediaAssets += totalAssets;
      totalCatboxAssets += catboxCount;

      gameCollections.push({
        id: g.id,
        title,
        slug,
        coverUrl: g.coverUrl,
        screenshots,
        totalAssets,
        catboxCount,
        hasCover: !!g.coverUrl,
        hosts: Array.from(hostsSet),
      });
    }
  }
} catch (err) {
  console.error("Failed to query game media collections for admin:", err);
}
---

