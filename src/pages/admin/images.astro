          <div class="flex items-center justify-center gap-3 pt-2">
            <label class="cursor-pointer bg-[#ff2a2a] hover:bg-[#ff4444] text-white font-sans text-xs font-bold uppercase px-4 py-2 rounded-md transition shadow">
              <span>Select Files</span>
              <input type="file" id="modal-add-files-input" multiple accept="image/*" class="hidden" />
            </label>
          </div>

          <div id="modal-upload-status" class="text-xs font-sans text-emerald-400 hidden pt-2"></div>
        </div>

      </div>
    </div>
  </div>

  <!-- Hidden Replace File Input -->
  <input type="file" id="hidden-replace-input" accept="image/*" class="hidden" />
</AdminLayout>

<script>
  let currentModalGame: any = null;
  let activeReplaceTarget: { type: 'cover' | 'screenshot'; index?: number } | null = null;

  // DOM Elements
  const modal = document.getElementById('media-modal') as HTMLDivElement;
  const closeModalBtn = document.getElementById('close-modal-btn') as HTMLButtonElement;
  const modalGameTitle = document.getElementById('modal-game-title') as HTMLHeadingElement;
  const modalGameId = document.getElementById('modal-game-id') as HTMLSpanElement;
  const coverContainer = document.getElementById('cover-container') as HTMLDivElement;
  const coverStatus = document.getElementById('cover-status') as HTMLSpanElement;
  const screenshotsGrid = document.getElementById('screenshots-grid') as HTMLDivElement;
  const screenshotsCount = document.getElementById('screenshots-count') as HTMLSpanElement;
  const modalAddFilesInput = document.getElementById('modal-add-files-input') as HTMLInputElement;
  const hiddenReplaceInput = document.getElementById('hidden-replace-input') as HTMLInputElement;
  const modalUploadStatus = document.getElementById('modal-upload-status') as HTMLDivElement;
  const searchInput = document.getElementById('collection-search') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.filter-btn');
  const collectionCards = document.querySelectorAll('.collection-card');

  // Open Modal logic
  document.querySelectorAll('.open-modal-btn, .collection-card').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = (el.closest('.collection-card') as HTMLElement);
      if (!card) return;
      const rawData = card.dataset.gameData;
      if (rawData) {
        currentModalGame = JSON.parse(rawData);
        renderModalContent();
        modal.classList.remove('hidden');
      }
    });
  });

  closeModalBtn?.addEventListener('click', () => {
    modal.classList.add('hidden');
    currentModalGame = null;
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
      currentModalGame = null;
    }
  });

  // Client-Side Canvas WebP Compression
  async function compressToWebP(file: File): Promise<File> {
    if (file.type === 'image/svg+xml' || file.type === 'image/webp') return file;
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement('canvas');
        canvas.width = img.naturalWidth || img.width;
        canvas.height = img.naturalHeight || img.height;
        const ctx = canvas.getContext('2d');
        if (!ctx) { resolve(file); return; }
        ctx.drawImage(img, 0, 0);
        canvas.toBlob((blob) => {
          if (!blob) { resolve(file); return; }
          const newName = file.name.replace(/\.[^/.]+$/, '') + '.webp';
          resolve(new File([blob], newName, { type: 'image/webp' }));
        }, 'image/webp', 0.85);
      };
      img.onerror = () => { URL.revokeObjectURL(url); resolve(file); };
      img.src = url;
    });
  }

  // Upload to Catbox proxy
  async function uploadFileToCatbox(file: File): Promise<string> {
    const webpFile = await compressToWebP(file);
    const formData = new FormData();
    formData.append('file', webpFile);
    const res = await fetch('/api/admin/upload', { method: 'POST', body: formData });
    const data = await res.json();
    if (res.ok && data.url) {
      return data.url;
    }
    throw new Error(data.error || 'Upload failed');
  }

  // Mutate database media
  async function mutateMedia(payload: any) {
    const res = await fetch('/api/admin/games/media', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    if (!res.ok) {
      alert(data.error || 'Operation failed');
      throw new Error(data.error);
    }
    return data;
  }

  // Render Modal Content
  function renderModalContent() {
    if (!currentModalGame) return;

    modalGameTitle.textContent = currentModalGame.title;
    modalGameId.textContent = currentModalGame.id;

    // 1. Render Cover
    if (currentModalGame.coverUrl) {
      coverStatus.textContent = 'Cover present';
      coverContainer.innerHTML = `
        <div class="relative w-32 h-44 shrink-0 bg-[#0c0c12] rounded-lg overflow-hidden border border-[#1a1a24]">
          <img src="/api/image-proxy?url=${encodeURIComponent(currentModalGame.coverUrl)}" class="w-full h-full object-cover" />
          <span class="absolute top-1 left-1 bg-blue-600 text-white text-[9px] font-sans font-bold px-1.5 py-0.5 rounded uppercase">Cover</span>
        </div>
        <div class="space-y-3 flex-1">
          <p class="text-xs font-sans text-gray-300 break-all bg-[#09090d] p-2 rounded border border-[#1a1a24]">
            ${currentModalGame.coverUrl}
          </p>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn-replace-cover bg-[#121217] hover:bg-white hover:text-black border border-[#1a1a24] text-xs font-sans font-bold px-3 py-1.5 rounded transition uppercase">
              🔄 Replace Cover
            </button>
            <button type="button" class="btn-delete-cover bg-red-950/60 hover:bg-red-600 text-red-300 hover:text-white border border-red-800/50 text-xs font-sans font-bold px-3 py-1.5 rounded transition uppercase">
              🗑️ Delete Cover
            </button>
            <button type="button" data-url="${currentModalGame.coverUrl}" class="btn-copy-link bg-[#121217] hover:bg-gray-700 text-gray-300 text-xs font-sans px-3 py-1.5 rounded border border-[#1a1a24] uppercase">
              Copy Link
            </button>
          </div>
        </div>
      `;
    } else {
      coverStatus.textContent = 'No cover set';
      coverContainer.innerHTML = `
        <div class="w-32 h-44 shrink-0 bg-[#0c0c12] rounded-lg border border-dashed border-[#1a1a24] flex items-center justify-center text-xs font-sans text-gray-600 uppercase">
          No Cover
        </div>
        <div class="space-y-2 flex-1">
          <p class="text-xs font-sans text-gray-500">No cover poster has been assigned to this game yet.</p>
          <button type="button" class="btn-replace-cover bg-[#ff2a2a] hover:bg-[#ff4444] text-white text-xs font-sans font-bold px-4 py-2 rounded transition uppercase">
            + Upload Cover Image
          </button>
        </div>
      `;
    }

    // 2. Render Screenshots
    const screenshots: string[] = currentModalGame.screenshots || [];
    screenshotsCount.textContent = screenshots.length.toString();

    if (screenshots.length === 0) {
      screenshotsGrid.innerHTML = `
        <div class="col-span-full py-8 text-center bg-[#050508] border border-[#1a1a24] rounded-xl text-xs font-sans text-gray-500">
          No screenshots uploaded yet. Use the uploader below to add screenshots.
        </div>
      `;
    } else {
      screenshotsGrid.innerHTML = screenshots.map((url, idx) => `
        <div class="bg-[#07070a] border border-[#1a1a24] rounded-lg overflow-hidden flex flex-col justify-between space-y-2 p-2">
          <div class="relative aspect-video bg-[#0c0c12] rounded overflow-hidden">
            <img src="/api/image-proxy?url=${encodeURIComponent(url)}" class="w-full h-full object-cover" />
            <span class="absolute top-1 left-1 bg-purple-600 text-white text-[9px] font-sans font-bold px-1.5 py-0.5 rounded">
              #${idx + 1}
            </span>
          </div>
          <span class="text-[10px] font-sans text-gray-500 truncate block px-1" title="${url}">${url}</span>
          <div class="flex items-center justify-between gap-1 pt-1 border-t border-[#121217]">
            <button type="button" data-idx="${idx}" class="btn-replace-screenshot text-[10px] font-sans font-bold uppercase px-2 py-1 bg-[#121217] hover:bg-white hover:text-black border border-[#1a1a24] text-gray-300 rounded transition">
              Replace
            </button>
            <button type="button" data-idx="${idx}" class="btn-delete-screenshot text-[10px] font-sans font-bold uppercase px-2 py-1 bg-red-950/60 hover:bg-red-600 text-red-300 hover:text-white border border-red-800/50 rounded transition">
              Delete
            </button>
            <button type="button" data-url="${url}" class="btn-copy-link text-[10px] font-sans uppercase px-2 py-1 bg-[#121217] text-gray-400 hover:text-white border border-[#1a1a24] rounded">
              Copy
            </button>
          </div>
        </div>
      `).join('');
    }

    bindModalEvents();
  }

  function bindModalEvents() {
    // Replace Cover
    document.querySelectorAll('.btn-replace-cover').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeReplaceTarget = { type: 'cover' };
        hiddenReplaceInput.click();
      });
    });

    // Delete Cover
    document.querySelectorAll('.btn-delete-cover').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to remove the cover for this game?')) return;
        try {
          await mutateMedia({ action: 'delete-cover', gameId: currentModalGame.id });
          currentModalGame.coverUrl = null;
          renderModalContent();
        } catch (e) {}
      });
    });

    // Replace Screenshot
    document.querySelectorAll('.btn-replace-screenshot').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.idx || '0', 10);
        activeReplaceTarget = { type: 'screenshot', index: idx };
        hiddenReplaceInput.click();
      });
    });

    // Delete Screenshot
    document.querySelectorAll('.btn-delete-screenshot').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const idx = parseInt((btn as HTMLElement).dataset.idx || '0', 10);
        if (!confirm(`Delete screenshot #${idx + 1}?`)) return;
        try {
          const data = await mutateMedia({ action: 'delete-screenshot', gameId: currentModalGame.id, index: idx });
          currentModalGame.screenshots = data.screenshots;
          renderModalContent();
        } catch (e) {}
      });
    });

    // Copy Link
    document.querySelectorAll('.btn-copy-link').forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = (btn as HTMLElement).dataset.url;
        if (url) {
          navigator.clipboard.writeText(url);
          const orig = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = orig; }, 1500);
        }
      });
    });
  }

  // Handle Replace File Upload
  hiddenReplaceInput?.addEventListener('change', async () => {
    const file = hiddenReplaceInput.files?.[0];
    if (!file || !activeReplaceTarget || !currentModalGame) return;

    try {
      modalUploadStatus.classList.remove('hidden');
      modalUploadStatus.textContent = 'Compressing WebP & uploading to Catbox...';

      const newUrl = await uploadFileToCatbox(file);

      if (activeReplaceTarget.type === 'cover') {
        await mutateMedia({ action: 'update-cover', gameId: currentModalGame.id, coverUrl: newUrl });
        currentModalGame.coverUrl = newUrl;
      } else if (activeReplaceTarget.type === 'screenshot' && typeof activeReplaceTarget.index === 'number') {
        const data = await mutateMedia({
          action: 'replace-screenshot',
          gameId: currentModalGame.id,
          index: activeReplaceTarget.index,
          newUrl,
        });
        currentModalGame.screenshots = data.screenshots;
      }

      modalUploadStatus.textContent = 'Image updated successfully!';
      setTimeout(() => modalUploadStatus.classList.add('hidden'), 2500);
      renderModalContent();
    } catch (err: any) {
      alert(`Replacement failed: ${err.message}`);
      modalUploadStatus.classList.add('hidden');
    } finally {
      hiddenReplaceInput.value = '';
      activeReplaceTarget = null;
    }
  });

  // Handle Add New Screenshots inside Modal
  modalAddFilesInput?.addEventListener('change', async () => {
    const files = modalAddFilesInput.files;
    if (!files || files.length === 0 || !currentModalGame) return;

    try {
      modalUploadStatus.classList.remove('hidden');
      modalUploadStatus.textContent = `Uploading ${files.length} WebP images to Catbox...`;

      const uploadedUrls: string[] = [];
      for (const file of Array.from(files)) {
        const url = await uploadFileToCatbox(file);
        uploadedUrls.push(url);
      }

      const data = await mutateMedia({
        action: 'add-screenshots',
        gameId: currentModalGame.id,
        urls: uploadedUrls,
      });

      currentModalGame.screenshots = data.screenshots;
      modalUploadStatus.textContent = `Successfully added ${uploadedUrls.length} screenshot(s)!`;
      setTimeout(() => modalUploadStatus.classList.add('hidden'), 2500);
      renderModalContent();
    } catch (err: any) {
      alert(`Failed to add images: ${err.message}`);
      modalUploadStatus.classList.add('hidden');
    } finally {
      modalAddFilesInput.value = '';
    }
  });

  // Filter & Search Logic for Collection Cards
  let activeFilter = 'all';

  function applyFilters() {
    const query = searchInput?.value?.toLowerCase().trim() || '';

    collectionCards.forEach((card) => {
      const el = card as HTMLElement;
      const title = (el.dataset.gameTitle || '').toLowerCase();
      const rawData = el.dataset.gameData;
      if (!rawData) return;
      const data = JSON.parse(rawData);

      let matchesFilter = true;
      if (activeFilter === 'catbox') matchesFilter = data.catboxCount > 0;
      else if (activeFilter === 'has-cover') matchesFilter = data.hasCover;
      else if (activeFilter === 'has-screenshots') matchesFilter = data.screenshots.length > 0;

      let matchesSearch = true;
      if (query) {
        const hostsStr = (data.hosts || []).join(' ').toLowerCase();
        matchesSearch = title.includes(query) || hostsStr.includes(query);
      }

      if (matchesFilter && matchesSearch) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'border-[#ff2a2a]', 'bg-[#ff2a2a]/10', 'text-white');
        b.classList.add('border-[#1a1a24]', 'bg-[#050508]', 'text-gray-400');
      });
      btn.classList.add('active', 'border-[#ff2a2a]', 'bg-[#ff2a2a]/10', 'text-white');
      btn.classList.remove('border-[#1a1a24]', 'bg-[#050508]', 'text-gray-400');

      activeFilter = (btn as HTMLElement).dataset.filter || 'all';
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', applyFilters);
</script>
