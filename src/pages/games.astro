---
import Layout from '../layouts/Layout.astro';
import GataCatalogClient from '../components/GataCatalogClient';
import { turso, initTursoForRequest } from '../lib/turso';
import { games, genres, tags, platforms } from '../db/schema';
import { count, or, isNull, ne } from 'drizzle-orm';
import { env as cfWorkerEnv } from "cloudflare:workers";
import { getDataVersion } from '../lib/dataVersion';

const isDev = import.meta.env?.DEV || (typeof process !== "undefined" && process.env && process.env.NODE_ENV === "development");
const runtimeEnv = isDev
  ? (typeof process !== "undefined" && process.env ? process.env : cfWorkerEnv)
  : (cfWorkerEnv || (typeof process !== "undefined" ? process.env : {}));

initTursoForRequest(runtimeEnv);

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=600'
);

const dataVersion = await getDataVersion();
let totalGames: number = dataVersion.totalGames || 107851;
let allGenres: any[] = [];
let allPlatforms: any[] = [];

try {
  // Query database counts and lists in parallel (lightweight only, visible non-hidden games)
  const [
    [{ count: gamesCount }],
    genresList,
    platformsList
  ] = await Promise.all([
    turso.select({ count: count() }).from(games).where(or(isNull(games.status), ne(games.status, "hidden"))),
    turso.select({ name: genres.name, slug: genres.slug }).from(genres).orderBy(genres.name).limit(60),
    turso.select({ name: platforms.name, slug: platforms.slug }).from(platforms).orderBy(platforms.name).limit(100)
  ]);

  totalGames = dataVersion.totalGames || gamesCount || 107851;
  allGenres = genresList;
  allPlatforms = platformsList;
} catch (err) {
  console.error("Failed to query catalog metadata from Turso:", err);
}
---

<Layout 
  title="Horror Games Registry | hoGAMEGATA" 
  description="Explore the complete horror database registry. Advanced filters, catalog lists, price comparisons, and steam rating metrics."
  withSearch={false}
>
  <div class="max-w-[1400px] mx-auto px-6 sm:px-10 mt-10 flex-1 pb-24 w-full">
    <GataCatalogClient
      client:only="react"
      initialTotalGames={totalGames}
      initialGenres={allGenres}
      initialTags={[]}
      initialPlatforms={allPlatforms}
    />
  </div>
</Layout>
