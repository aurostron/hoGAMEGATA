---
import Layout from '../layouts/Layout.astro';
import GataCatalogClient from '../components/GataCatalogClient';
import { getCatalogStats, getCatalogGenres, getCatalogPlatforms } from '../lib/catalogMeta';

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=600'
);

const stats = getCatalogStats();
const totalGames: number = stats.totalVisibleGames;
const allGenres = getCatalogGenres();
const allPlatforms = getCatalogPlatforms();
---

<Layout 
  title="Horror Games Registry | hoGAMEGATA" 
  description="Explore the complete horror database registry. Advanced filters, catalog lists, price comparisons, and steam rating metrics."
  withSearch={false}
>
  <div class="max-w-[1400px] mx-auto px-6 sm:px-10 mt-10 flex-1 pb-24 w-full">
    <GataCatalogClient
      client:only="react"
      initialTotalGames={totalGames}
      initialGenres={allGenres}
      initialTags={[]}
      initialPlatforms={allPlatforms}
    />
  </div>
</Layout>
