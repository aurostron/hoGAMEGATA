---
import Layout from '../layouts/Layout.astro';
import ReturnButton from '../components/ReturnButton';
---

<Layout 
  title="Developer Request Portal | hoGAMEGATA" 
  description="Submit your horror game to the hoGAMEGATA registry or request database updates and removals." 
  withSearch={false} 
  withLink={true}
>
  <main class="flex-1 flex items-center justify-center p-6 my-12 pb-24">
    <div class="max-w-[1300px] w-full border border-white/10 bg-[#08080a] p-8 md:p-10 flex flex-col gap-8 relative overflow-hidden">
      
      <!-- Top nav inside card -->
      <div class="flex justify-between items-center border-b border-white/10 pb-4">
        <div class="flex flex-col">
          <span class="font-mono text-[9px] text-[#ff2a2a] uppercase tracking-widest font-black">Developer Portal</span>
          <span class="font-mono text-[8px] text-white/50 uppercase tracking-widest">Game Submissions & Removals</span>
        </div>
        <ReturnButton client:only="react" />
      </div>

      <!-- Header Title -->
      <div class="flex flex-col gap-2">
        <h1 class="font-sans font-black text-3xl sm:text-4xl uppercase tracking-tighter leading-none text-[#f3f4f6]">
          SUBMIT OR UPDATE A GAME
        </h1>
        <p class="font-mono text-xs text-white/50 uppercase tracking-widest leading-relaxed">
          Showcase your horror project, update screenshots, or request removal from the registry.
        </p>
      </div>

      <!-- Tally Embed Iframe Container -->
      <div class="w-full bg-black/40 border border-white/15 p-1 relative min-h-[600px] overflow-hidden">
        <!-- TALLY FORM EMBED -->
        <iframe 
          src="https://tally.so/embed/Gx49Zp?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1" 
          width="100%" 
          height="850" 
          frameborder="0" 
          marginheight="0" 
          marginwidth="0" 
          title="Developer Requests"
          class="w-full bg-transparent"
        ></iframe>
      </div>

      <!-- Submission Guidelines Box -->
      <div class="border border-white/10 p-4 bg-[#0d0d0f]">
        <div class="space-y-1 font-sans text-xs text-gray-400 leading-relaxed">
          <span class="text-white font-bold uppercase block font-mono text-[11px] tracking-wide">Notice & Guidelines</span>
          <p>• Make sure to provide valid store links (Steam, GOG, Epic Games Store, or itch.io) to enable automated price tracking.</p>
          <p>• For database removal requests, please supply verification details (such as requesting from your official studio email domain).</p>
          <p>• All requests are audited and processed by the registry curation team within 48 to 72 hours.</p>
        </div>
      </div>

    </div>
  </main>
</Layout>
