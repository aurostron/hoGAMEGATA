---
import Layout from '../layouts/Layout.astro';
import ReturnButton from '../components/ReturnButton';
---

<Layout 
  title="Developer Request Portal | hoGAMEGATA" 
  description="Submit your horror game to the hoGAMEGATA registry or request database updates and removals." 
  withSearch={false} 
  withLink={true}
>
  <main class="flex-1 flex items-center justify-center p-4 sm:p-6 my-8 sm:my-12 pb-24">
    <div class="max-w-[1300px] w-full border border-white/5 bg-[#121215]/50 backdrop-blur-md rounded-2xl flex flex-col relative overflow-hidden shadow-2xl">
      
      <!-- Top header bar inside card (with padding) -->
      <div class="flex justify-between items-center border-b border-white/5 px-6 sm:px-8 py-5">
        <div class="flex flex-col">
          <span class="font-sans text-[10px] text-[#ff2a2a] uppercase tracking-widest font-black">Developer Portal</span>
          <span class="font-sans text-[9px] text-white/40 uppercase tracking-widest font-semibold mt-0.5">Game Submissions & Removals</span>
        </div>
        <ReturnButton client:only="react" />
      </div>

      <!-- Page info / intro (with padding) -->
      <div class="px-6 sm:px-8 py-8 flex flex-col gap-2">
        <h1 class="font-sans font-black text-3xl sm:text-4xl uppercase tracking-tight leading-none text-white">
          Submit or Update a Game
        </h1>
        <p class="font-sans text-sm text-white/50 leading-relaxed max-w-2xl font-normal">
          Showcase your horror project, update screenshots, or request removal from the registry. Complete the secure form below.
        </p>
      </div>

      <!-- Iframe container (no padding, full width!) -->
      <div class="w-full bg-[#0a0a0d] border-y border-white/5 relative overflow-hidden">
        <!-- TALLY FORM EMBED -->
        <iframe 
          data-tally-src="https://tally.so/embed/Gx49Zp?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1" 
          width="100%" 
          height="650" 
          frameborder="0" 
          marginheight="0" 
          marginwidth="0" 
          title="Developer Requests"
          class="w-full bg-transparent"
        ></iframe>
      </div>

      <!-- Guidelines Box (with padding) -->
      <div class="p-6 sm:p-8 bg-white/[0.01]">
        <div class="border border-white/5 p-6 bg-black/20 rounded-xl space-y-4">
          <span class="text-white font-bold uppercase block font-sans text-xs tracking-wider">Notice & Guidelines</span>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-sans text-xs text-white/60 leading-relaxed">
            <div class="space-y-1">
              <span class="text-white font-semibold block">01. Automated Tracking</span>
              <p>Provide valid store links (Steam, GOG, Epic Games Store, or itch.io) to enable automated price tracking.</p>
            </div>
            <div class="space-y-1">
              <span class="text-white font-semibold block">02. Ownership Verification</span>
              <p>For database removal requests, please supply verification details (such as requesting from your official studio email domain).</p>
            </div>
            <div class="space-y-1">
              <span class="text-white font-semibold block">03. Review Window</span>
              <p>All requests are audited and processed by the registry curation team within 48 to 72 hours.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>

<!-- Load Tally Widget SDK to enable dynamic height resizing and remove scrollbars -->
<script is:inline src="https://tally.so/widgets/embed.js"></script>
