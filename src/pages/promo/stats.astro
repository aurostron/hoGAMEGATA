---
import '../../styles/global.css';
import promoScreenshots from '../../data/promo-screenshots.json';
import SciFiLogo from '../../components/SciFiLogo';
import { getServerUser, isAdminUser } from '../../lib/serverAuth';
import { env as cfWorkerEnv } from "cloudflare:workers";

export const prerender = false;

// 🔒 Private Dev-Only Route Protection (404 for non-dev/non-admin in production)
const isDev = import.meta.env.DEV || (typeof process !== "undefined" && process.env?.NODE_ENV === "development") || Astro.url.hostname === "localhost" || Astro.url.hostname === "127.0.0.1";
if (!isDev) {
  const runtimeEnv = cfWorkerEnv || (typeof process !== "undefined" ? process.env : {});
  const user = await getServerUser(Astro.request, Astro.cookies, runtimeEnv);
  const isAdmin = user && isAdminUser(user.email, runtimeEnv);
  const bypassCookie = Astro.cookies.get("maintenance_bypass")?.value;
  const secret = (runtimeEnv as any)?.MAINTENANCE_SECRET;
  const hasBypass = bypassCookie && secret && bypassCookie === secret;

  if (!isAdmin && !hasBypass) {
    return new Response("Not Found", { status: 404, statusText: "Not Found" });
  }
}

// Exact verified counts (0 runtime TursoDB queries — preserves Cloudflare Worker limits)
const totalGames = 107814;
const totalDevelopers = 68034;

// 8 Verified game databases across the web
const databases = [
  { rank: "01", name: "hoGAMEGATA", type: "Horror Database", count: totalGames, countStr: totalGames.toLocaleString('en-US'), isPrimary: true, source: "https://gamegata.xyz/directory" },
  { rank: "02", name: "itch.io", type: "Horror Tag", count: 91820, countStr: "91,820", isPrimary: false, source: "https://itch.io/games/tag-horror" },
  { rank: "03", name: "Valve Steam", type: "Horror Tag", count: 27901, countStr: "27,901", isPrimary: false, source: "https://store.steampowered.com/search/?tags=1667" },
  { rank: "04", name: "IGDB", type: "Horror Theme (19)", count: 20488, countStr: "20,488", isPrimary: false, source: "https://www.igdb.com/themes/horror" },
  { rank: "05", name: "MobyGames", type: "Horror Genre", count: 5470, countStr: "5,470", isPrimary: false, source: "https://www.mobygames.com/game/genre:horror/" },
  { rank: "06", name: "Giant Bomb", type: "Horror Concept", count: 3200, countStr: "~3,200", isPrimary: false, source: "https://www.giantbomb.com/horror/3015-355/games/" },
  { rank: "07", name: "GOG.com", type: "Horror Tag", count: 1215, countStr: "1,215", isPrimary: false, source: "https://www.gog.com/games?tags=horror" },
  { rank: "08", name: "Survival Horrors", type: "Classic Registry", count: 450, countStr: "< 500", isPrimary: false, source: "https://survivalhorrors.org" },
];

// Graph Coordinates (viewBox 0 0 520 325)
// Baseline Y = 285, Max count = 120,000 -> Max Y = 35 (Height = 250)
const getY = (c: number) => Math.round(285 - (c / 120000) * 250);
const points = [
  { x: 65, y: getY(totalGames), count: totalGames, label: "hGG" },
  { x: 128, y: getY(91820), count: 91820, label: "itch" },
  { x: 191, y: getY(27901), count: 27901, label: "Steam" },
  { x: 254, y: getY(20488), count: 20488, label: "IGDB" },
  { x: 317, y: getY(5470), count: 5470, label: "Moby" },
  { x: 380, y: getY(3200), count: 3200, label: "Giant Bomb" },
  { x: 443, y: getY(1215), count: 1215, label: "GOG" },
  { x: 495, y: getY(450), count: 450, label: "survivalhorrors" },
];

const curvePath = `M ${points[0].x} ${points[0].y} ` +
  `C 95 ${points[0].y + 10}, 105 ${points[1].y - 10}, ${points[1].x} ${points[1].y} ` +
  `C 155 ${points[1].y + 40}, 165 ${points[2].y - 20}, ${points[2].x} ${points[2].y} ` +
  `C 220 ${points[2].y + 20}, 235 ${points[3].y - 5}, ${points[3].x} ${points[3].y} ` +
  `C 275 ${points[3].y}, 295 ${points[4].y}, ${points[4].x} ${points[4].y} ` +
  `C 340 ${points[4].y}, 360 ${points[5].y}, ${points[5].x} ${points[5].y} ` +
  `C 400 ${points[5].y}, 420 ${points[6].y}, ${points[6].x} ${points[6].y} ` +
  `C 460 ${points[6].y}, 480 ${points[7].y}, ${points[7].x} ${points[7].y}`;

const areaPath = `${curvePath} L ${points[7].x} 285 L ${points[0].x} 285 Z`;

// Safely serialize 50 screenshots JSON for inline client slideshow (0 runtime DB queries)
const serializedScreenshots = JSON.stringify(promoScreenshots || []);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-black">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>How hoGAMEGATA Works | The Web's Most Curated Horror Game Database</title>
  <meta name="description" content="An architectural breakdown and verified data comparison of hoGAMEGATA, indexing 107,814+ curated horror games and 68,034+ creators across Steam, itch.io, GOG, and indie archives.">
  <link rel="icon" type="image/png" href="/icons/icon-192x192.png">

  <!-- Clean Pure Sans-Serif Fonts (Outfit + Geist) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --font-display: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-body: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    body {
      font-family: var(--font-body);
      font-feature-settings: "tnum" 1;
      font-variant-numeric: tabular-nums;
    }
    .font-brand {
      font-family: var(--font-display);
    }
    .font-sans-ui {
      font-family: var(--font-body);
    }

    /* Fixed Ken Burns Image Slideshow Background (Simple, Dimmed, Blurred) */
    #slideshow-bg {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      pointer-events: none;
      overflow: hidden;
      background-color: #000000;
    }

    .slide-layer {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      transition: opacity 1.4s ease-in-out, transform 7s cubic-bezier(0.25, 1, 0.5, 1);
      will-change: opacity, transform;
    }

    /* Subtle Monochrome Vignette */
    .cinema-vignette {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 2;
      background: radial-gradient(circle at center, transparent 30%, rgba(0, 0, 0, 0.82) 100%);
    }

    /* Subtle Film Scanlines */
    .film-scanlines {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 3;
      background: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.1),
        rgba(0, 0, 0, 0.1) 1px,
        transparent 1px,
        transparent 2px
      );
      opacity: 0.3;
    }

    /* Interactive 3D Perspective Card Tilt (Monochrome Silver/White Hover) */
    .perspective-container {
      perspective: 1200px;
    }
    .card-3d {
      transform-style: preserve-3d;
      transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.2s ease, border-color 0.2s ease;
      will-change: transform;
    }
    .card-3d:hover {
      border-color: rgba(255, 255, 255, 0.28);
      box-shadow: 0 20px 40px -15px rgba(255, 255, 255, 0.06);
    }
    .pop-3d {
      transform: translateZ(20px);
    }

    /* Hide scrollbars for clean full-bleed containers */
    .scrollbar-none::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-none {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="min-h-screen w-full bg-black text-zinc-300 antialiased overflow-x-hidden relative selection:bg-zinc-800 selection:text-white">

  <!-- ====================================================================
       BACKGROUND SLIDESHOW (From DB Screenshots, Dimmed & Blurred)
       ==================================================================== -->
  <div id="slideshow-bg">
    <!-- Double-buffering slide layers for smooth cross-fading -->
    <div id="slide-layer-0" class="slide-layer opacity-100 scale-100"></div>
    <div id="slide-layer-1" class="slide-layer opacity-0 scale-105"></div>
    
    <!-- Dim & Blur Overlay (Matches Login Page Atmosphere) -->
    <div class="absolute inset-0 bg-black/80 md:bg-black/82 backdrop-blur-[2.5px] z-10"></div>
  </div>

  <div class="cinema-vignette"></div>
  <div class="film-scanlines"></div>

  <!-- Page Content Container (Above Background) -->
  <div class="relative z-10 flex flex-col min-h-screen">

    <!-- Top Sticky Navigation Bar -->
    <nav class="sticky top-0 z-50 backdrop-blur-xl bg-black/85 border-b border-zinc-800/90 px-4 sm:px-6 lg:px-8 py-3 transition-all">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
        
        <!-- Default hoGAMEGATA Logo (Matching Main Site) -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <SciFiLogo withLink={true} />
          <span class="hidden xs:inline-block border border-white/20 text-white px-2 py-0.5 font-mono text-[8.5px] uppercase tracking-widest bg-white/10 select-none shrink-0 rounded-full font-bold">
            Beta
          </span>
        </div>

        <!-- Navigation Links -->
        <div class="hidden md:flex items-center gap-6 text-xs font-sans-ui text-zinc-400">
          <a href="#overview" class="hover:text-white transition">Overview</a>
          <a href="#how-it-works" class="hover:text-white transition">How It Works</a>
          <a href="#curation" class="hover:text-white transition">Curation Engine</a>
          <a href="#comparison" class="hover:text-white transition">Data Comparison</a>
          <a href="#explorer" class="hover:text-white transition">Native Data Explorer</a>
          <a href="#mirror" class="hover:text-white transition">Open Mirror</a>
        </div>

        <!-- Live Curation Badge (Monochrome) -->
        <div class="flex items-center gap-2 text-xs font-sans-ui">
          <span class="w-2 h-2 rounded-full bg-zinc-300 animate-pulse"></span>
          <span class="text-zinc-400 hidden sm:inline"><strong class="text-white font-bold">{totalGames.toLocaleString('en-US')}</strong> Curated Titles</span>
          <span class="text-zinc-700 hidden sm:inline">•</span>
          <span class="text-white font-bold uppercase tracking-wider text-[11px] sm:text-xs">#1 Most Curated</span>
        </div>

      </div>
    </nav>

    <!-- MAIN SCROLLABLE CONTENT -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-16 sm:space-y-24">

      <!-- ====================================================================
           SECTION 1: HERO OVERVIEW & KEY NUMBERS (MONOCHROME WHITE-TO-BLACK)
           ==================================================================== -->
      <section id="overview" class="pt-4 sm:pt-8 flex flex-col items-center text-center space-y-6">
        
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-950 border border-zinc-800 text-xs text-zinc-400">
          <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
          <span class="uppercase tracking-wider font-semibold text-[10px] text-zinc-200">Technical Breakdown & Engine Docs</span>
        </div>

        <!-- Big Display Headline (Monochrome Silver Gradient) -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white font-brand tracking-tight uppercase leading-[1.05] max-w-4xl">
          THE WEB'S <span class="text-transparent bg-clip-text bg-gradient-to-b from-white via-zinc-200 to-zinc-400 underline decoration-zinc-700 underline-offset-8">MOST CURATED</span> HORROR DATABASE.
        </h1>

        <!-- Subheading Explaining "Why Most Curated" -->
        <p class="text-sm sm:text-base lg:text-lg text-zinc-400 max-w-2xl leading-relaxed">
          Storefronts like Steam and itch expand wildly every single day with untagged shovelware and meme prototypes. 
          <strong class="text-zinc-100">hoGAMEGATA</strong> focuses on deep curation: indexing, filtering noise, and preserving genuine horror gaming history across every platform.
        </p>

        <!-- Quick Metrics Monolith Grid (Interactive 3D Tilt, Monochrome) -->
        <div class="w-full grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 pt-6 perspective-container">
          
          <div class="card-3d bg-zinc-950/80 border border-zinc-800/90 rounded-2xl p-4 sm:p-5 text-left flex flex-col justify-between backdrop-blur-md">
            <div class="text-[10px] font-sans-ui uppercase tracking-wider text-zinc-400 font-semibold">Total Hand-Indexed</div>
            <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-white font-brand mt-2 mb-1">
              {totalGames.toLocaleString('en-US')}<span class="text-zinc-500 text-2xl sm:text-3xl font-light">+</span>
            </div>
            <div class="text-xs text-zinc-400 pop-3d">Curated horror games from Steam, itch, GOG, and indie archives.</div>
          </div>

          <div class="card-3d bg-zinc-950/80 border border-zinc-800/90 rounded-2xl p-4 sm:p-5 text-left flex flex-col justify-between backdrop-blur-md">
            <div class="text-[10px] font-sans-ui uppercase tracking-wider text-zinc-400 font-semibold">Studios & Creators</div>
            <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-white font-brand mt-2 mb-1">
              {totalDevelopers.toLocaleString('en-US')}<span class="text-zinc-500 text-2xl sm:text-3xl font-light">+</span>
            </div>
            <div class="text-xs text-zinc-400 pop-3d">Solo developers, student game jam teams, and established studios.</div>
          </div>

          <div class="card-3d bg-zinc-950/80 border border-zinc-800/90 rounded-2xl p-4 sm:p-5 text-left flex flex-col justify-between backdrop-blur-md">
            <div class="text-[10px] font-sans-ui uppercase tracking-wider text-zinc-400 font-semibold">vs. Commercial Stores</div>
            <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-white font-brand mt-2 mb-1">
              +286%
            </div>
            <div class="text-xs text-zinc-400 pop-3d">Nearly 4× more horror titles than Steam by uniting independent repositories.</div>
          </div>

          <div class="card-3d bg-zinc-950/80 border border-zinc-800/90 rounded-2xl p-4 sm:p-5 text-left flex flex-col justify-between backdrop-blur-md">
            <div class="text-[10px] font-sans-ui uppercase tracking-wider text-zinc-400 font-semibold">Community Access</div>
