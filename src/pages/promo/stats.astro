        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 perspective-container">
          
          <!-- Subgenre Card 1 -->
          <div class="card-3d bg-zinc-950/90 border border-zinc-800/90 rounded-2xl p-5 flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-sans-ui uppercase tracking-widest text-zinc-400 font-bold">Retro & PS1 Style</span>
              <h3 class="text-xl font-black text-white font-brand tracking-tight uppercase mt-1 mb-2">Lo-Fi Dread</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                Crunchy textures, fixed cameras, CRT scanlines, and 90s dread inspired by early Resident Evil and Silent Hill.
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-zinc-900 flex items-center justify-between">
              <span class="text-xs font-bold text-white">14,000+ Titles</span>
              <span class="text-[10px] text-zinc-500">Curated</span>
            </div>
          </div>

          <!-- Subgenre Card 2 -->
          <div class="card-3d bg-zinc-950/90 border border-zinc-800/90 rounded-2xl p-5 flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-sans-ui uppercase tracking-widest text-zinc-400 font-bold">Psychological & Cosmic</span>
              <h3 class="text-xl font-black text-white font-brand tracking-tight uppercase mt-1 mb-2">Unseen Terror</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                Atmospheric slow-burns, Lovecraftian cosmic dread, auditory hallucinations, and mind-bending sanity mechanics.
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-zinc-900 flex items-center justify-between">
              <span class="text-xs font-bold text-white">22,000+ Titles</span>
              <span class="text-[10px] text-zinc-500">Curated</span>
            </div>
          </div>

          <!-- Subgenre Card 3 -->
          <div class="card-3d bg-zinc-950/90 border border-zinc-800/90 rounded-2xl p-5 flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-sans-ui uppercase tracking-widest text-zinc-400 font-bold">Classic Survival</span>
              <h3 class="text-xl font-black text-white font-brand tracking-tight uppercase mt-1 mb-2">Scarcity & Tension</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                Count every single bullet, manage tight inventory grids, solve physical environmental puzzles, and evade relentless stalkers.
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-zinc-900 flex items-center justify-between">
              <span class="text-xs font-bold text-white">18,500+ Titles</span>
              <span class="text-[10px] text-zinc-500">Curated</span>
            </div>
          </div>

          <!-- Subgenre Card 4 -->
          <div class="card-3d bg-zinc-950/90 border border-zinc-800/90 rounded-2xl p-5 flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-sans-ui uppercase tracking-widest text-zinc-400 font-bold">Indie Jams & Proto</span>
              <h3 class="text-xl font-black text-white font-brand tracking-tight uppercase mt-1 mb-2">Viral Experiments</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                Raw 15-minute student prototypes, Haunted PS1 demo discs, analog found-footage, and itch.io viral breakout hits.
