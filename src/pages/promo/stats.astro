          <a href="#overview" class="hover:text-white transition">Back to Top &uarr;</a>
        </div>

      </div>
    </footer>

  </div>

  <!-- Raw Screenshots Data (Serialized at build time with 0 runtime DB hits) -->
  <script is:inline id="promo-screenshots-data" type="application/json" set:html={serializedScreenshots} />

  <!-- Client-Side Slideshow & Native Data Explorer Script -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // =========================================================================
      // 1. KEN BURNS SLIDESHOW BACKGROUND (Simple, Dimmed, Blurred)
      // =========================================================================
      let screenshots = [];
      try {
        const raw = document.getElementById("promo-screenshots-data")?.textContent;
        if (raw) screenshots = JSON.parse(raw);
      } catch (e) {
        console.warn("Could not parse promo screenshots:", e);
      }

      if (screenshots && screenshots.length > 0) {
        const layer0 = document.getElementById("slide-layer-0");
        const layer1 = document.getElementById("slide-layer-1");
        const bgGameName = document.getElementById("bg-game-name");
        const bgDevName = document.getElementById("bg-dev-name");
        
        let currentIndex = 0;
        let activeLayer = 0; // 0 or 1

        // Initialize first slide
        if (layer0) {
          layer0.style.backgroundImage = `url(${screenshots[0].url})`;
          if (bgGameName) bgGameName.textContent = screenshots[0].gameName;
          if (bgDevName) bgDevName.textContent = screenshots[0].devName;
        }

        // Rotate every 6.5 seconds with double buffering
        setInterval(() => {
          const nextIndex = (currentIndex + 1) % screenshots.length;
          const nextItem = screenshots[nextIndex];
          const incomingLayer = activeLayer === 0 ? layer1 : layer0;
          const outgoingLayer = activeLayer === 0 ? layer0 : layer1;

          if (incomingLayer && outgoingLayer) {
            // Preload next image and fade in
            incomingLayer.style.backgroundImage = `url(${nextItem.url})`;
            incomingLayer.style.opacity = "1";
            incomingLayer.style.transform = "scale(1.04)";
            
            outgoingLayer.style.opacity = "0";
            outgoingLayer.style.transform = "scale(1.0)";

            if (bgGameName) bgGameName.textContent = nextItem.gameName;
            if (bgDevName) bgDevName.textContent = nextItem.devName;

            activeLayer = activeLayer === 0 ? 1 : 0;
            currentIndex = nextIndex;
          }
        }, 6500);
      }

      // =========================================================================
      // 2. NATIVE CLIENT-SIDE DATA EXPLORER (Games & 15k Tags)
      // =========================================================================
      const tabBtnGames = document.getElementById("tab-btn-games");
      const tabBtnTags = document.getElementById("tab-btn-tags");
      const panelGames = document.getElementById("panel-games");
      const panelTags = document.getElementById("panel-tags");
      const searchInput = document.getElementById("explorer-search");
      const clearBtn = document.getElementById("explorer-clear");
      const statusLabel = document.getElementById("explorer-status");
      const loadingState = document.getElementById("explorer-loading");
      
      const gamesTableBody = document.getElementById("games-table-body");
      const gamesPagination = document.getElementById("games-pagination");
      const gamesPageInfo = document.getElementById("games-page-info");
      const gamesPrevBtn = document.getElementById("games-prev-btn");
      const gamesNextBtn = document.getElementById("games-next-btn");

      const tagsCountLabel = document.getElementById("tags-count-label");
      const tagsChipContainer = document.getElementById("tags-chip-container");

      let currentTab = "games"; // "games" | "tags"
      let allGamesList = null;   // Array of { title, dev, url }
      let filteredGames = [];
      let gamesPage = 1;
      const gamesPageSize = 50;

      let allTagsList = null;    // Array of { name, slug }
      let filteredTags = [];

      // Switch Tabs
      function setTab(tab) {
        currentTab = tab;
        if (tab === "games") {
          tabBtnGames.className = "px-3 sm:px-4 py-1.5 rounded-lg font-semibold transition bg-zinc-800 text-white cursor-pointer";
          tabBtnTags.className = "px-3 sm:px-4 py-1.5 rounded-lg font-semibold transition text-zinc-400 hover:text-white cursor-pointer";
          panelGames.classList.remove("hidden");
          panelTags.classList.add("hidden");
          searchInput.placeholder = "Search across 107,814 games and developers...";
          if (!allGamesList) loadGamesData();
        } else {
          tabBtnTags.className = "px-3 sm:px-4 py-1.5 rounded-lg font-semibold transition bg-zinc-800 text-white cursor-pointer";
          tabBtnGames.className = "px-3 sm:px-4 py-1.5 rounded-lg font-semibold transition text-zinc-400 hover:text-white cursor-pointer";
          panelTags.classList.remove("hidden");
          panelGames.classList.add("hidden");
          searchInput.placeholder = "Search across 15,825 verified horror tags...";
          if (!allTagsList) loadTagsData();
        }
        applyFilter();
      }

      tabBtnGames?.addEventListener("click", () => setTab("games"));
      tabBtnTags?.addEventListener("click", () => setTab("tags"));

      // 1. Stream & parse /all-games.txt on demand
      async function loadGamesData() {
        if (allGamesList) return;
        loadingState?.classList.remove("hidden");
        statusLabel.textContent = "Loading 107k catalog dump...";

        try {
          // Fetch from local static file first, fallback to github raw
          let res = await fetch("/all-games.txt").catch(() => null);
          if (!res || !res.ok) {
            res = await fetch("https://raw.githubusercontent.com/project-hgg/project-hgg.github.io/main/all-games.txt");
          }
          const text = await res.text();
          const lines = text.split("\n");
          const items = [];

          for (let i = 0; i < lines.length; i++) {
            const line = lines[i].trim();
            if (!line || line.startsWith("#")) continue;
            const parts = line.split("|").map(p => p.trim());
            if (parts.length >= 2) {
              items.push({
                title: parts[0],
                dev: parts[1] || "Independent Creator",
                url: parts[2] || `https://gamegata.xyz/search?q=${encodeURIComponent(parts[0])}`
              });
            }
          }

          allGamesList = items;
          filteredGames = items;
          statusLabel.textContent = `Loaded ${allGamesList.length.toLocaleString('en-US')} games client-side.`;
          renderGamesPage();
        } catch (err) {
          console.error("Failed to load games txt:", err);
          statusLabel.textContent = "Failed to load games dump.";
        } finally {
          loadingState?.classList.add("hidden");
        }
      }

      // Render games table page
      function renderGamesPage() {
        if (!gamesTableBody || !allGamesList) return;
        const total = filteredGames.length;
        const totalPages = Math.ceil(total / gamesPageSize) || 1;
        if (gamesPage > totalPages) gamesPage = totalPages;
        if (gamesPage < 1) gamesPage = 1;

        const start = (gamesPage - 1) * gamesPageSize;
        const pageItems = filteredGames.slice(start, start + gamesPageSize);

        if (pageItems.length === 0) {
          gamesTableBody.innerHTML = `<tr><td colspan="3" class="py-8 text-center text-zinc-500">No games found matching your search.</td></tr>`;
        } else {
          gamesTableBody.innerHTML = pageItems.map(g => `
            <tr class="hover:bg-zinc-900/40 transition-colors">
              <td class="py-2.5 px-4 font-medium text-white truncate max-w-[240px] sm:max-w-none">
                ${escapeHtml(g.title)}
              </td>
              <td class="py-2.5 px-4 text-zinc-400 truncate max-w-[160px] sm:max-w-none">
                ${escapeHtml(g.dev)}
              </td>
              <td class="py-2.5 px-4 text-right shrink-0">
                <a href="${g.url}" target="_blank" rel="noopener noreferrer" class="text-zinc-300 hover:text-white underline text-[11px] inline-flex items-center gap-1">
                  View &rarr;
                </a>
              </td>
            </tr>
          `).join("");
        }

        gamesPagination?.classList.remove("hidden");
        if (gamesPageInfo) {
          gamesPageInfo.textContent = `Showing ${(total === 0 ? 0 : start + 1).toLocaleString()}-${Math.min(start + gamesPageSize, total).toLocaleString()} of ${total.toLocaleString()} games (Page ${gamesPage} of ${totalPages})`;
        }
        if (gamesPrevBtn) gamesPrevBtn.disabled = gamesPage <= 1;
        if (gamesNextBtn) gamesNextBtn.disabled = gamesPage >= totalPages;
      }

      gamesPrevBtn?.addEventListener("click", () => {
        if (gamesPage > 1) {
          gamesPage--;
          renderGamesPage();
        }
      });

      gamesNextBtn?.addEventListener("click", () => {
        const totalPages = Math.ceil(filteredGames.length / gamesPageSize);
        if (gamesPage < totalPages) {
          gamesPage++;
          renderGamesPage();
        }
      });

      // 2. Stream & parse /all-tags.txt
      async function loadTagsData() {
        if (allTagsList) return;
        loadingState?.classList.remove("hidden");
        statusLabel.textContent = "Loading 15,825 verified tags...";

        try {
          let res = await fetch("/all-tags.txt").catch(() => null);
          if (!res || !res.ok) {
            res = await fetch("https://raw.githubusercontent.com/project-hgg/project-hgg.github.io/main/all-tags.txt");
          }
          const text = await res.text();
          const lines = text.split("\n");
          const items = [];

          for (let i = 0; i < lines.length; i++) {
            const line = lines[i].trim();
            if (!line || line.startsWith("#")) continue;
            const parts = line.split("|").map(p => p.trim());
            items.push({
              name: parts[0],
              slug: parts[1] || parts[0].toLowerCase().replace(/[^a-z0-9]+/g, "-")
            });
          }

          allTagsList = items;
          filteredTags = items;
          statusLabel.textContent = `Loaded ${allTagsList.length.toLocaleString('en-US')} tags.`;
          renderTagsCloud();
        } catch (err) {
          console.error("Failed to load tags:", err);
          statusLabel.textContent = "Failed to load tags.";
        } finally {
          loadingState?.classList.add("hidden");
        }
      }

      // Render tags chips
      function renderTagsCloud() {
        if (!tagsChipContainer || !allTagsList) return;
        const total = filteredTags.length;
        if (tagsCountLabel) {
          tagsCountLabel.textContent = `Showing ${Math.min(total, 300).toLocaleString()} of ${total.toLocaleString()} tags`;
        }

        const displayItems = filteredTags.slice(0, 300);
        if (displayItems.length === 0) {
          tagsChipContainer.innerHTML = `<div class="py-8 text-center text-zinc-500 w-full">No tags found matching query.</div>`;
        } else {
          tagsChipContainer.innerHTML = displayItems.map(t => `
            <a 
              href="https://gamegata.xyz/search?q=${encodeURIComponent(t.name)}" 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-800 hover:border-zinc-500 hover:bg-zinc-800 text-zinc-300 hover:text-white text-[11px] font-sans-ui transition inline-flex items-center gap-1.5"
            >
              <span>#${escapeHtml(t.name)}</span>
            </a>
          `).join("");
        }
      }

      // Filter handling (with debounce)
      let debounceTimer = null;
      function applyFilter() {
        const query = (searchInput?.value || "").trim().toLowerCase();
        if (clearBtn) clearBtn.classList.toggle("hidden", query.length === 0);

        if (currentTab === "games") {
          if (!allGamesList) {
            loadGamesData();
            return;
          }
          if (!query) {
            filteredGames = allGamesList;
          } else {
            filteredGames = allGamesList.filter(g => 
              g.title.toLowerCase().includes(query) || g.dev.toLowerCase().includes(query)
            );
          }
          gamesPage = 1;
          renderGamesPage();
        } else {
          if (!allTagsList) {
            loadTagsData();
            return;
          }
          if (!query) {
            filteredTags = allTagsList;
          } else {
            filteredTags = allTagsList.filter(t => 
              t.name.toLowerCase().includes(query)
            );
          }
          renderTagsCloud();
        }
      }

      searchInput?.addEventListener("input", () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(applyFilter, 150);
      });

      clearBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        applyFilter();
      });

      function escapeHtml(str) {
        return (str || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      // =========================================================================
      // 3. SMOOTH 3D PERSPECTIVE TILT ON MOUSE MOVEMENT
      // =========================================================================
      const cards = document.querySelectorAll(".card-3d");
      cards.forEach((card) => {
        let isHovered = false;

        card.addEventListener("mouseenter", () => {
          isHovered = true;
        });

        card.addEventListener("mousemove", (e) => {
          if (!isHovered) return;
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          
          const rotX = -(y / (rect.height / 2)) * 6;
          const rotY = (x / (rect.width / 2)) * 6;

          card.style.transform = `perspective(1000px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) translateZ(6px)`;
        });

        card.addEventListener("mouseleave", () => {
          isHovered = false;
          card.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)";
        });
      });
    });
  </script>

</body>
</html>