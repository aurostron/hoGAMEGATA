---
import Layout from '../../layouts/Layout.astro';
import { turso } from '../../lib/turso';
import {
  games as gamesTable,
  developers as developersTable,
  gamesToDevelopers,
  platforms as platformsTable,
  gamesToPlatforms,
  genres as genresTable,
  gamesToGenres
} from '../../db/schema';
import { eq, inArray, and, or, isNull, ne } from 'drizzle-orm';
import { getCloudinaryFetchUrl, getHighResCoverUrl, stripHtml, formatReleaseDate, getReleaseYear } from '../../lib/utils';
import PlatformLogos from '../../components/PlatformLogos';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'no-cache, no-store, must-revalidate'
);

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const STOREFRONT_NAMES = new Set([
  "gog-com", "gog", "steam", "itch-io", "itch", "epic-games", "epic-games-store", "nintendo-eshop", "playstation-store", "xbox-store", "humble-bundle"
]);

if (STOREFRONT_NAMES.has(slug.toLowerCase().trim())) {
  return Astro.redirect('/404');
}

// 1. Fetch Developer
const [developer] = await turso
  .select()
  .from(developersTable)
  .where(eq(developersTable.slug, slug))
  .limit(1);

if (!developer) {
  return Astro.redirect('/404');
}

// 2. Fetch games of this developer via join table gamesToDevelopers
const gameRelations = await turso
  .select({ gameId: gamesToDevelopers.gameId })
  .from(gamesToDevelopers)
  .where(eq(gamesToDevelopers.developerId, developer.id));

const gameIds = gameRelations.map((r: any) => r.gameId);

let games: any[] = [];
if (gameIds.length > 0) {
  const fetchedGames = await turso
    .select()
    .from(gamesTable)
    .where(
      and(
        inArray(gamesTable.id, gameIds),
        or(isNull(gamesTable.status), ne(gamesTable.status, "hidden"))
      )
    )
    .orderBy(gamesTable.releaseDate); // Chronological order

  // Fetch platforms mapping
  const platformsResult = await turso
    .select({
      gameId: gamesToPlatforms.gameId,
      id: platformsTable.id,
      name: platformsTable.name,
      slug: platformsTable.slug,
    })
    .from(gamesToPlatforms)
    .innerJoin(platformsTable, eq(gamesToPlatforms.platformId, platformsTable.id))
    .where(inArray(gamesToPlatforms.gameId, gameIds));

  // Fetch genres mapping
  const genresResult = await turso
    .select({
      gameId: gamesToGenres.gameId,
      id: genresTable.id,
      name: genresTable.name,
      slug: genresTable.slug,
    })
    .from(gamesToGenres)
    .innerJoin(genresTable, eq(gamesToGenres.genreId, genresTable.id))
    .where(inArray(gamesToGenres.gameId, gameIds));

  const platformsMap = new Map<string, any[]>();
  for (const p of platformsResult) {
    if (!platformsMap.has(p.gameId)) platformsMap.set(p.gameId, []);
    platformsMap.get(p.gameId)!.push({ id: p.id, name: p.name, slug: p.slug });
  }

  const genresMap = new Map<string, any[]>();
  for (const g of genresResult) {
    if (!genresMap.has(g.gameId)) genresMap.set(g.gameId, []);
    genresMap.get(g.gameId)!.push({ id: g.id, name: g.name, slug: g.slug });
  }

  games = fetchedGames.map((g: any) => ({
    ...g,
    platforms: platformsMap.get(g.id) || [],
    genres: genresMap.get(g.id) || [],
  }));
}

// Compute statistics
const totalGames = games.length;
const ratedGames = games.filter(g => g.rating);
const avgRating = ratedGames.length > 0 
  ? Math.round(ratedGames.reduce((acc, curr) => acc + curr.rating, 0) / ratedGames.length) 
  : null;

const years = games
  .map(g => {
    if (!g.releaseDate) return null;
    const d = new Date(g.releaseDate);
    return (!isNaN(d.getTime()) && d.getFullYear() > 1970) ? d.getFullYear() : null;
  })
  .filter(Boolean) as number[];
const startYear = years.length > 0 ? Math.min(...years) : null;
const endYear = years.length > 0 ? Math.max(...years) : null;

// Curated data fallbacks
const DEV_CURATED_DATA: Record<string, { description?: string; location?: string; style?: string }> = {
  "chillas-art": {
    description: "Chilla's Art (チルズアート) is a legendary Japanese indie game developer duo known for pioneering the VHS aesthetic in psychological horror, capturing Japanese urban legends, and delivering dread-inducing gaming masterpieces.",
    location: "Japan",
    style: "VHS, Atmospheric Horror"
  },
  "deep-sea-prisoner": {
    description: "Deep-Sea Prisoner (Funamusea) is a Japanese indie creator famous for highly narrative, atmospheric adventure horror titles like Mogeko Castle and The Gray Garden.",
    location: "Japan",
    style: "Adventure, Psychological Horror"
  },
  "limbolane": {
    description: "LimboLane is an independent game studio creators of the surreal psychological adventure game Smile For Me.",
    location: "USA",
    style: "Surreal, Puzzle Adventure"
  }
};

const allGenres = games.flatMap(g => g.genres || []).map((g: any) => g.name);
const uniqueGenres = Array.from(new Set(allGenres)).slice(0, 3).join(", ");
const computedStyle = uniqueGenres || "Horror, Atmospheric";

const curated = DEV_CURATED_DATA[slug] || {};
const devDescription = curated.description || `${developer.name} is a game developer. Check out their catalog of games, chronological release timeline, and ratings.`;
const devLocation = curated.location || null;
const devStyle = curated.style || computedStyle;
---

<Layout title={`${developer.name} | hoGAMEGATA`} description={devDescription} withSearch={true}>
  {/* Atmospheric Developer Hero */}
  <div class="relative w-full overflow-hidden border-b border-white/10" style="min-height: 280px;">
    <div class="absolute inset-0 bg-black"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(180,0,0,0.15) 0%, transparent 80%);"></div>
    <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 60%, rgba(3,3,3,1) 100%);"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 py-16 flex flex-col md:flex-row md:items-end justify-between gap-8 h-full">
      <div class="flex flex-col sm:flex-row sm:items-center gap-6">
        {developer.avatarUrl && (
          <div class="w-20 h-20 border border-white/15 bg-[#08080a] shrink-0 p-1 flex items-center justify-center shadow-2xl transition-all duration-300 hover:border-white/30">
            <img src={developer.avatarUrl} alt={developer.name} class="w-full h-full object-cover" />
          </div>
        )}
        <div class="space-y-4">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white tracking-tight uppercase select-none">
            {developer.name}
          </h1>
          <p class="text-xs text-white/60 max-w-xl leading-relaxed">
            {devDescription}
          </p>
        </div>
      </div>

      {/* Developer Stats Panel */}
      <div class="border border-white/15 p-5 bg-[#08080a] backdrop-blur-md font-sans text-sm space-y-3 min-w-[280px] sm:min-w-[320px] text-white/80 self-start md:self-end shadow-xl shadow-black/40">
        <div class="text-[#ff2a2a] border-b border-white/10 pb-1.5 mb-2 text-xs uppercase tracking-wider font-bold flex items-center justify-between">
          <span>About the developer</span>
        </div>
        <div class="flex justify-between items-center text-xs">
          <span class="text-white/50 font-medium">Games made:</span>
          <span class="text-white font-bold">{totalGames}</span>
        </div>
        <div class="flex justify-between items-center text-xs">
          <span class="text-white/50 font-medium">Years active:</span>
          <span class="text-white font-bold">{startYear ? (startYear === endYear ? `${startYear}` : `${startYear} - ${endYear || 'Present'}`) : 'TBD'}</span>
        </div>
        <div class="flex justify-between items-center text-xs">
          <span class="text-white/50 font-medium">Average score:</span>
          <span class="text-white font-bold">{avgRating ? `${(avgRating / 10).toFixed(1)} / 10` : "N/A"}</span>
        </div>
        {devLocation && (
          <div class="flex justify-between items-center text-xs">
            <span class="text-white/50 font-medium">Based in:</span>
            <span class="text-white font-bold">{devLocation}</span>
          </div>
        )}
        <div class="flex justify-between items-center text-xs">
          <span class="text-white/50 font-medium">Style:</span>
          <span class="text-white font-bold">{devStyle}</span>
        </div>
      </div>
    </div>
  </div>

  <main class="max-w-5xl mx-auto px-6 mt-12 pb-32 flex-1 w-full relative">
    
    {/* Page Subtitle */}
    <div class="flex items-center gap-2 mb-16">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <h3 class="text-[10px] text-white/60 uppercase tracking-widest font-black">
        Games timeline
      </h3>
    </div>

    {/* Timeline Container */}
    <div class="relative w-full" id="timeline-container">
      
      {/* Central Line Track */}
      <div class="absolute left-4 md:left-1/2 top-2 bottom-2 w-0.5 bg-white/10 -translate-x-1/2 z-0"></div>
      
      {/* Scroll-Progress glowing crimson path line */}
      <div 
        id="timeline-progress" 
        class="absolute left-4 md:left-1/2 top-2 w-0.5 bg-[#ff2a2a] -translate-x-1/2 z-10 transition-all duration-75 ease-out shadow-[0_0_10px_#ff2a2a]"
        style="height: 0%;"
      ></div>

      {/* Timeline Node List */}
      <div class="space-y-16 relative z-20">
        {games.map((game, index) => {
          const isLeft = index % 2 === 0;
          const gameYear = getReleaseYear(game.releaseDate, "TBD");
          const cleanDate = formatReleaseDate(game.releaseDate, "TBD");

          return (
            <div 
              class="timeline-item flex flex-col md:flex-row items-start md:items-center justify-between w-full opacity-0 translate-y-12 transition-all duration-700 ease-out"
              data-game-id={game.id}
            >
              {/* Year marker on the other side of card on desktop */}
              <div class={`hidden md:flex flex-1 ${isLeft ? 'justify-end pr-12 order-3' : 'justify-start pl-12 order-1'}`}>
                <div class="font-mono text-3xl font-black text-white select-none cursor-default leading-none">
                  {gameYear}
                </div>
              </div>

              {/* Timeline Center Node Dot */}
              <div class="absolute left-4 md:left-1/2 w-3.5 h-3.5 bg-black border-2 border-white/30 rounded-none -translate-x-1/2 z-30 timeline-dot transition-all duration-300 order-2">
                <div class="w-full h-full bg-[#ff2a2a] opacity-0 transition-opacity duration-300 rounded-none shadow-[0_0_8px_#ff2a2a]"></div>
              </div>

              {/* Game Card Container */}
              <div class={`w-full md:w-[45%] pl-10 md:pl-0 order-3 ${isLeft ? 'md:order-1 md:pr-12' : 'md:order-3 md:pl-12'}`}>
                <a 
                  href={`/game/${game.slug}`}
                  class="block border border-white/15 bg-white/[0.01] hover:bg-white/[0.03] p-4 relative transition-all duration-300 glow-border hover:translate-y-[-2px] group"
                >
                  {/* Floating Year badge for mobile */}
                  <span class="md:hidden absolute top-3 right-3 font-mono text-[9px] uppercase tracking-widest bg-white/15 text-white border border-white/20 font-bold px-1.5 py-0.5">
                    {gameYear}
                  </span>

                  {/* Rating Badge */}
                  {game.rating && (
                    <span class="absolute top-3 left-3 font-mono text-[8px] uppercase tracking-widest bg-[#7f1d1d] text-[#fca5a5] border border-[#fca5a5] font-black px-1.5 py-0.5 z-10 flex items-center gap-1 shadow-glow">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2.5 h-2.5 fill-current"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {(game.rating / 10).toFixed(1)}
                    </span>
                  )}

                  <div class="flex gap-4">
                    {/* Cover Art */}
                    <div class="w-20 sm:w-24 aspect-[3/4] bg-neutral-900 border border-white/10 overflow-hidden shrink-0 flex items-center justify-center relative">
                      {game.coverUrl ? (
                        <img 
                          src={getCloudinaryFetchUrl(getHighResCoverUrl(game.coverUrl)) || ""} 
                          alt={game.title}
                          class="object-cover w-full h-full transition-transform duration-500 ease-out group-hover:scale-105"
                          loading="lazy"
                        />
                      ) : (
                        <span class="font-mono text-[7px] text-white/40 uppercase tracking-widest text-center">NO COVER</span>
                      )}
                    </div>

                    {/* Game Details */}
                    <div class="flex-1 flex flex-col justify-between min-w-0">
                      <div>
                        <h4 class="text-white text-base sm:text-lg font-black tracking-wide uppercase line-clamp-1 group-hover:text-[#ff2a2a] transition-colors duration-200">
                          {game.title}
                        </h4>
                        <div class="font-mono text-[8px] text-white/50 block font-bold mt-1">
                          Released: {cleanDate}
                        </div>
                        <p class="text-[11px] text-white/60 line-clamp-2 mt-2 leading-relaxed font-sans pr-4">
                          {game.summary ? stripHtml(game.summary) : `Atmospheric gaming experience engineered by ${developer.name}.`}
                        </p>
                      </div>

                      {/* Footer tags */}
                      <div class="flex items-center justify-between pt-2 border-t border-white/10 font-mono text-[9px] mt-3">
                        <PlatformLogos platforms={game.platforms} platformNames={game.platformNames} />
                        <span class="flex items-center gap-1 text-[8px] uppercase font-bold text-white/40 group-hover:text-white transition-colors duration-150">
                          View details <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </span>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </main>
</Layout>

<script>
  // Intersection Observer for fade-in animations
  const observerOptions = {
    root: null,
    rootMargin: '0px 0px -15% 0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-12');
        entry.target.classList.add('opacity-100', 'translate-y-0');
        
        // Light up dot
        const dot = entry.target.querySelector('.timeline-dot div');
        if (dot) dot.classList.replace('opacity-0', 'opacity-100');
        
        // Light up dot border
        const dotBorder = entry.target.querySelector('.timeline-dot');
        if (dotBorder) {
          dotBorder.classList.remove('border-white/30');
          dotBorder.classList.add('border-[#ff2a2a]', 'shadow-[0_0_10px_#ff2a2a]');
        }
      }
    });
  }, observerOptions);

  const items = document.querySelectorAll('.timeline-item');
  items.forEach(item => observer.observe(item));

  // Dynamic Scroll Progress Line
  const timelineProgress = document.getElementById('timeline-progress');
  const timelineContainer = document.getElementById('timeline-container');
  
  if (timelineProgress && timelineContainer && items.length > 0) {
    function updateTimelineProgress() {
      const scrollPosition = window.scrollY + (window.innerHeight * 0.7); // offset trigger height
      const containerRect = timelineContainer.getBoundingClientRect();
      const containerTop = containerRect.top + window.scrollY;
      
      // Get the last item's dot position relative to the container
      const lastItem = items[items.length - 1];
      const lastDot = lastItem.querySelector('.timeline-dot');
      let maxScrollHeight = containerRect.height;
      
      if (lastDot) {
        const lastDotRect = lastDot.getBoundingClientRect();
        // Calculate dot center Y relative to container top
        maxScrollHeight = lastDotRect.top - containerRect.top + (lastDotRect.height / 2);
      }
      
      // Calculate how far we've scrolled relative to container top (with 8px top-2 offset)
      const relativeScroll = scrollPosition - containerTop - 8;
      
      // Clamp the height between 0 and (maxScrollHeight - 8)
      const height = Math.max(0, Math.min(maxScrollHeight - 8, relativeScroll));
      
      // Set line height in pixels
      timelineProgress.style.height = `${height}px`;
    }

    // Bind listeners
    window.addEventListener('scroll', updateTimelineProgress);
    window.addEventListener('resize', updateTimelineProgress);
    
    // Run initial execution
    updateTimelineProgress();
  }
</script>
