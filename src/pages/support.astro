            {/* Steam */}
            <img src="/3rd-party/steam_logo.png" alt="Steam" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* GOG */}
            <img src="/3rd-party/GOG.com_Logo.png" alt="GOG.com" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
