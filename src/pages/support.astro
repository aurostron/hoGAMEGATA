      </div>
    </div>

    {/* Awesome Stuff & Curated Horror Resources */}
    <div class="w-full pt-16 sm:pt-20 space-y-8 text-left">
      <div class="text-center space-y-2">
        <h2 class="text-xl sm:text-3xl font-black uppercase tracking-widest text-white font-sans">
          Awesome Stuff & Useful Links
        </h2>
        <p class="text-xs sm:text-sm text-white/60 max-w-xl mx-auto font-normal leading-relaxed">
          Good websites, communities, databases, and indie platforms we love, use, and recommend.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mt-6">
        {awesomeResources.map((group) => (
          <div class="border border-white/10 bg-[#121216] p-5 sm:p-6 rounded-xl flex flex-col justify-between space-y-5 hover:border-white/20 transition-colors">
            <div class="border-b border-white/10 pb-3">
              <h3 class="font-sans text-sm sm:text-base font-bold uppercase tracking-wider text-white">
                {group.category}
              </h3>
            </div>

            <div class="space-y-3">
              {group.items.map((item) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group block p-3 rounded-lg bg-black/30 border border-white/5 hover:border-white/20 hover:bg-white/[0.04] transition-all duration-150"
                >
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-sans font-bold text-xs sm:text-sm text-white group-hover:text-red-400 transition-colors">
                      {item.name}
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/40 group-hover:text-red-400 transition-colors shrink-0"><path d="M15 3h6v6"/><path d="10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  </div>
                  <span class="font-mono text-[10px] text-white/40 block mt-0.5 group-hover:text-white/60 transition-colors">
                    {item.displayUrl}
                  </span>
                  <p class="text-xs text-white/70 leading-relaxed mt-1.5 font-normal">
                    {item.desc}
                  </p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Precautions & Disclaimer */}
    <div class="w-full pt-16 sm:pt-20 text-left">
      <div class="border border-white/10 bg-[#121216] p-6 sm:p-8 rounded-xl space-y-4">
        <div class="flex items-center gap-3 border-b border-white/10 pb-3">
