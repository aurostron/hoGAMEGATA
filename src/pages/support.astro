            <img src="/3rd-party/Humble_Bundle_logo.png" alt="Humble Bundle" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* SteamGridDB */}
            <img src="/3rd-party/steam-grid-db_logo.png" alt="SteamGridDB" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* Internet Archive */}
            <img src="/3rd-party/Internet_Archive_logo_and_wordmark.png" alt="Internet Archive" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
          </div>
