            {/* ITAD */}
            <img src="/3rd-party/ITAD_logo.png" alt="IsThereAnyDeal" class="h-8 sm:h-10 w-auto object-contain mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* RAWG */}
