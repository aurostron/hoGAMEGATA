---
import Layout from "../layouts/Layout.astro";
import { turso } from "../lib/turso";
import { games, developers, tags } from "../db/schema";
import { count } from "drizzle-orm";

// Fetch DB stats for the header component directly from Turso
let stats: any = null;
try {
  const [
    [{ gamesCount }],
    [{ devsCount }],
    [{ tagsCount }],
  ] = await Promise.all([
    turso.select({ gamesCount: count() }).from(games),
    turso.select({ devsCount: count() }).from(developers),
    turso.select({ tagsCount: count() }).from(tags),
  ]);

  stats = {
    games: gamesCount,
    developers: devsCount,
    tags: tagsCount,
    screenshots: gamesCount * 4,
  };
} catch (e) {
  console.error("Failed to query DB stats in support.astro:", e);
}
---

<Layout
  title="hoGAMEGATA | Support Our Mission"
  description="Help preserve horror gaming history. Support hoGAMEGATA's mission to keep our horror database free and ad-free."
  statsGames={stats?.games}
  statsDevelopers={stats?.developers}
  statsScreenshots={stats?.screenshots}
  statsTags={stats?.tags}
>
  <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16 flex flex-col items-center justify-center text-center space-y-10 sm:space-y-14">
    {/* Section Header */}
    <div class="space-y-4">
      <div class="relative flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-red-950/20 border border-red-500/30 rounded-full shadow-[0_0_20px_rgba(255,42,42,0.2)] mx-auto">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7 sm:w-9 sm:h-9 text-red-500 animate-pulse"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
      </div>
      <h1 class="text-2xl sm:text-4xl font-black uppercase tracking-widest text-white mt-4">
        Support The Mission
      </h1>
      <p class="text-xs sm:text-base text-white/70 max-w-2xl leading-relaxed mx-auto font-normal">
        hoGAMEGATA is a free, ad-free database dedicated to horror games and game metadata preservation. We never sell user data or lock features behind paywalls. hoGAMEGATA only collects, stores and serves pre-existing/known games as an aggregator.
      </p>
    </div>

    {/* Support Methods Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 w-full text-left mt-6">
      {/* 1. Share & Spread */}
      <div class="border border-white/10 bg-[#121216] p-5 sm:p-6 rounded-xl flex flex-col justify-between space-y-4 hover:border-white/20 transition-colors">
        <div class="space-y-3.5">
          <div class="text-red-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 sm:w-7 sm:h-7"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3 class="font-mono text-sm sm:text-base font-bold uppercase tracking-wider text-white">
            1. Share the site!
          </h3>
          <p class="text-xs sm:text-sm text-white/60 leading-relaxed">
            The easiest way to help is to share your favorite game pages, tag combinations, and lists with fellow horror enthusiasts. Help us build a larger community.
          </p>
        </div>
        <span class="font-mono text-[10px] font-bold text-white/40 uppercase tracking-widest pt-2">and it's free!</span>
      </div>

      {/* 2. Contribute Metadata */}
      <div class="border border-white/10 bg-[#121216] p-5 sm:p-6 rounded-xl flex flex-col justify-between space-y-4 hover:border-white/20 transition-colors">
        <div class="space-y-3.5">
          <div class="text-emerald-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 sm:w-7 sm:h-7"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="font-mono text-sm sm:text-base font-bold uppercase tracking-wider text-white">
            2. Contribute Data
          </h3>
          <p class="text-xs sm:text-sm text-white/60 leading-relaxed">
            Preservation starts with metadata. Report missing details, suggest tags, submit scare ratings, and contribute to retro / abandonware lists to keep the records complete.
          </p>
        </div>
        <span class="font-mono text-[10px] font-bold text-white/40 uppercase tracking-widest pt-2">Contribution will be available soon!</span>
      </div>

      {/* 3. Patreon & Hosting */}
      <div class="border border-white/10 bg-[#121216] p-5 sm:p-6 rounded-xl flex flex-col justify-between space-y-4 hover:border-white/20 transition-colors">
        <div class="space-y-3.5">
          <div class="text-amber-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 sm:w-7 sm:h-7"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" x2="6" y1="2" y2="4"/><line x1="10" x2="10" y1="2" y2="4"/><line x1="14" x2="14" y1="2" y2="4"/></svg>
          </div>
          <h3 class="font-mono text-sm sm:text-base font-bold uppercase tracking-wider text-white">
            3. Buy Me A Coffee
          </h3>
          <p class="text-xs sm:text-sm text-white/60 leading-relaxed">
            Domain, Database hosting, cron jobs, and API requests cost real money and computational power. Support us financially on Ko-Fi or which ever way possible to help cover our direct operating infrastructure costs.
          </p>
        </div>
        <span class="font-mono text-[10px] font-bold text-white/40 uppercase tracking-widest pt-2">Support links will be available soon!</span>
      </div>
    </div>

    {/* Our Supporters Section */}
    <div class="w-full pt-16 space-y-8">
      <h2 class="text-xl sm:text-2xl font-bold uppercase tracking-widest text-white font-sans">
        We would like to thank
      </h2>
      
      {/* Infinite scrolling marquee of clean logos */}
      <div class="relative w-full overflow-hidden py-8 border-y border-white/5 bg-black/25">
        <div class="absolute left-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-r from-[#030303] to-transparent z-10 pointer-events-none" />
        <div class="absolute right-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-l from-[#030303] to-transparent z-10 pointer-events-none" />
        
        <div class="flex w-max animate-marquee py-2 will-change-transform">
          {/* Group 1 */}
          <div class="flex shrink-0 items-center gap-16 sm:gap-24 pr-16 sm:pr-24">
            {/* Steam */}
            <img src="/3rd-party/steam_logo.png" alt="Steam" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* GOG */}
            <img src="/3rd-party/GOG.com_Logo.png" alt="GOG.com" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* IGDB */}
            <img src="/3rd-party/IGDB_logo.png" alt="IGDB" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* itch.io */}
            <img src="/3rd-party/itch_logo.png" alt="itch.io" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* CheapShark */}
            <img src="/3rd-party/cheapshark_logo.png" alt="CheapShark" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* ITAD */}
            <img src="/3rd-party/ITAD_logo.png" alt="IsThereAnyDeal" class="h-8 sm:h-10 w-auto object-contain mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* RAWG */}
            <img src="/3rd-party/rawg_logo.jpg" alt="RAWG" class="h-8 sm:h-10 w-auto object-contain mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* ProtonDB */}
            <img src="/3rd-party/protondb-logo.png" alt="ProtonDB" class="h-8 sm:h-10 w-auto object-contain mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* Fanatical */}
            <img src="/3rd-party/Fanatical_Logo.png" alt="Fanatical" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* Humble Bundle */}
            <img src="/3rd-party/Humble_Bundle_logo.png" alt="Humble Bundle" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* SteamGridDB */}
            <img src="/3rd-party/steam-grid-db_logo.png" alt="SteamGridDB" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* Internet Archive */}
            <img src="/3rd-party/Internet_Archive_logo_and_wordmark.png" alt="Internet Archive" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
          </div>
          
          {/* Group 2 (Duplicate) */}
          <div class="flex shrink-0 items-center gap-16 sm:gap-24 pr-16 sm:pr-24" aria-hidden="true">
            {/* Steam */}
            <img src="/3rd-party/steam_logo.png" alt="Steam" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* GOG */}
            <img src="/3rd-party/GOG.com_Logo.png" alt="GOG.com" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* IGDB */}
            <img src="/3rd-party/IGDB_logo.png" alt="IGDB" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* itch.io */}
            <img src="/3rd-party/itch_logo.png" alt="itch.io" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* CheapShark */}
            <img src="/3rd-party/cheapshark_logo.png" alt="CheapShark" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* ITAD */}
            <img src="/3rd-party/ITAD_logo.png" alt="IsThereAnyDeal" class="h-8 sm:h-10 w-auto object-contain mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* RAWG */}
            <img src="/3rd-party/rawg_logo.jpg" alt="RAWG" class="h-8 sm:h-10 w-auto object-contain mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* ProtonDB */}
            <img src="/3rd-party/protondb-logo.png" alt="ProtonDB" class="h-8 sm:h-10 w-auto object-contain mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* Fanatical */}
            <img src="/3rd-party/Fanatical_Logo.png" alt="Fanatical" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* Humble Bundle */}
            <img src="/3rd-party/Humble_Bundle_logo.png" alt="Humble Bundle" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* SteamGridDB */}
            <img src="/3rd-party/steam-grid-db_logo.png" alt="SteamGridDB" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* Internet Archive */}
            <img src="/3rd-party/Internet_Archive_logo_and_wordmark.png" alt="Internet Archive" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
          </div>
        </div>
      </div>
    </div>

    {/* Back Button */}
    <div class="pt-12 select-none">
      <a
        href="/"
        class="font-mono text-[10px] uppercase font-bold tracking-widest text-white/50 hover:text-white transition-colors"
      >
        Return to Storefront
      </a>
    </div>
  </div>

  <style>
    @keyframes marquee {
      0% { transform: translate3d(0, 0, 0); }
      100% { transform: translate3d(-50%, 0, 0); }
    }
    .animate-marquee {
      animation: marquee 45s linear infinite;
    }
    .animate-marquee:hover {
      animation-play-state: paused;
    }
    .will-change-transform {
      will-change: transform;
    }
    .mix-blend-screen {
      mix-blend-mode: screen;
    }
    .invert {
      filter: invert(1);
    }
  </style>
</Layout>
