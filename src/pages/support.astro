            <img src="/3rd-party/IGDB_logo.png" alt="IGDB" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* itch.io */}
            <img src="/3rd-party/itch_logo.png" alt="itch.io" class="h-8 sm:h-10 w-auto object-contain invert mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
