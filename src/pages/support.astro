            <img src="/3rd-party/protondb-logo.png" alt="ProtonDB" class="h-8 sm:h-10 w-auto object-contain mix-blend-screen opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
            {/* Fanatical */}
            <img src="/3rd-party/Fanatical_Logo.png" alt="Fanatical" class="h-8 sm:h-10 w-auto object-contain opacity-75 hover:opacity-100 transition-opacity duration-150 select-none pointer-events-none" />
            
