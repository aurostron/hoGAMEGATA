---
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>hoGAMEGATA — 107,000+ Horror Games Archive</title>
  <link rel="stylesheet" href="/promo-assets/styles.css">
</head>
<body>

  <!-- Ambient Cinematic Elements -->
  <div class="cinema-vignette"></div>
  <div class="film-scanlines"></div>

  <!-- Minimalist Corner Watermark -->
  <div class="video-header-watermark">
    <div class="video-brand-logo">
      <span class="italic">ho</span>GAMEGATA
    </div>
  </div>

  <!-- Discrete Audio Pill (Top Right) -->
  <div class="audio-status-pill" id="audio-toggle-btn" title="Toggle Ambient Synth">
    <div class="audio-bars">
      <div class="audio-bar"></div>
      <div class="audio-bar"></div>
      <div class="audio-bar"></div>
    </div>
    <span id="audio-label">Sound</span>
  </div>

  <!-- Viewport Scenes Container -->
  <main class="scene-viewport">

    <!-- ====================================================================
         SCENE 1: THE DENSE 3D NETFLIX WALL REVEAL
         ==================================================================== -->
    <section class="scene active" id="scene-1">
      <div class="wall-scene-container">
        <div class="wall-3d-grid">
          <div class="marquee-row marquee-left" id="marquee-row-1"></div>
          <div class="marquee-row marquee-right" id="marquee-row-2"></div>
          <div class="marquee-row marquee-left-fast" id="marquee-row-3"></div>
          <div class="marquee-row marquee-right-fast" id="marquee-row-4"></div>
          <div class="marquee-row marquee-left-slow" id="marquee-row-5"></div>
          <div class="marquee-row marquee-right-slow" id="marquee-row-6"></div>
        </div>
      </div>

      <div class="scene-hero-overlay">
        <h1 class="hero-headline anim-title">
          107,000+ GAMES. <br />
          <span class="crimson">ZERO ADS.</span>
        </h1>
        <p class="hero-sub anim-sub">
          From survival horror to experimental horror, the most diverse database you'll ever see.
        </p>
      </div>
    </section>

    <!-- ====================================================================
         SCENE 2: UNMATCHED SCALE & NUMBERS
         ==================================================================== -->
    <section class="scene" id="scene-2">
      <div style="text-align: center; max-width: 1000px; z-index: 10;">
        <h2 class="hero-headline anim-title" style="font-size: clamp(34px, 5.5vw, 60px);">
          BUILT FOR THE <br />
          <span class="crimson">HORROR FANS.</span>
        </h2>

        <div class="stats-grid">
          <div class="stat-monolith anim-item-1">
            <div class="stat-number"><span id="stat-total-games">107,814</span><span class="plus">+</span></div>
            <div class="stat-label">Total Games Indexed</div>
            <div class="stat-desc">Steam, GOG, Epic & itch releases in one unified, lightning-fast registry.</div>
          </div>

          <div class="stat-monolith anim-item-2">
            <div class="stat-number"><span id="stat-itch-games">89,157</span><span class="plus">+</span></div>
            <div class="stat-label">Indie & Itch Titles</div>
            <div class="stat-desc">itch.io Games and Game Jam Projects preserved forever.</div>
          </div>

          <div class="stat-monolith anim-item-3">
            <div class="stat-number"><span id="stat-total-devs">68,034</span><span class="plus">+</span></div>
            <div class="stat-label">Studios & Creators</div>
            <div class="stat-desc">Dedicated pages for every dev and solo creator.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SCENE 3: SUBGENRE CURATION
         ==================================================================== -->
    <section class="scene" id="scene-3">
      <div style="text-align: center; max-width: 1200px; z-index: 10;">
        <h2 class="hero-headline anim-title" style="font-size: clamp(32px, 5vw, 56px);">
          EVERY FLAVOR <br />
          <span class="crimson">OF HORROR</span>
        </h2>

        <div class="curation-grid">
          <div class="curation-card anim-item-1">
            <div>
              <div class="curation-tag">Retro & PS1</div>
              <h3 class="curation-title">Lo-Fi Dread</h3>
              <p class="curation-desc">Crunchy textures, fixed cameras, CRT scanlines, and 90s dread.</p>
            </div>
            <div class="curation-badge">14,000+ GAMES</div>
          </div>

          <div class="curation-card anim-item-2">
            <div>
              <div class="curation-tag">Psychological</div>
              <h3 class="curation-title">Cosmic & Surreal</h3>
              <p class="curation-desc">Atmospheric slow-burns, mind-bending soundscapes, and puzzles.</p>
            </div>
            <div class="curation-badge">22,000+ GAMES</div>
          </div>

          <div class="curation-card anim-item-3">
            <div>
              <div class="curation-tag">Survival</div>
              <h3 class="curation-title">Classic Scarcity</h3>
              <p class="curation-desc">Limited ammo, persistent stalkers, and inventory puzzles.</p>
            </div>
            <div class="curation-badge">18,500+ GAMES</div>
          </div>

          <div class="curation-card anim-item-4">
            <div>
              <div class="curation-tag">Game Jams</div>
              <h3 class="curation-title">Indie Oddities</h3>
              <p class="curation-desc">Raw 15-minute student prototypes and viral experiments.</p>
            </div>
            <div class="curation-badge">50,000+ FREE GAMES</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SCENE 4: SMART PRICE CHECKER & ENGINE
         ==================================================================== -->
    <section class="scene" id="scene-4">
      <div style="text-align: center; max-width: 1150px; z-index: 10;">
        <h2 class="hero-headline anim-title" style="font-size: clamp(32px, 5vw, 56px);">
          LIVE DEALS. <br />
          <span class="crimson">ZERO OVERPAYING. NO BS.</span>
        </h2>

        <div class="features-split">
          <div class="feature-cards-col">
            <div class="feature-pill-card anim-item-1">
              <div class="feature-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
              </div>
              <div class="feature-info">
                <h4>Live Price Comparison</h4>
                <p>Real-time deal alerts across Steam, GOG, Humble, and itch.io.</p>
              </div>
            </div>

            <div class="feature-pill-card anim-item-2">
              <div class="feature-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <circle cx="12" cy="12" r="6"></circle>
                  <circle cx="12" cy="12" r="2"></circle>
                </svg>
              </div>
              <div class="feature-info">
                <h4>Sub-50ms Typo-Tolerant Search</h4>
                <p>Instant suggestions and relevance ranking get you there immediately.</p>
              </div>
            </div>

            <div class="feature-pill-card anim-item-3">
              <div class="feature-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                  <path d="m3 9 2.44-6"></path>
                  <path d="m9 3 2.44 6"></path>
                  <path d="m15 3 2.44 6"></path>
                  <path d="M3 9h18"></path>
                </svg>
              </div>
              <div class="feature-info">
                <h4>Hover Video Previews</h4>
                <p>Instant gameplay trailers right inside the catalog without page reloads.</p>
              </div>
            </div>
          </div>

          <div class="live-deal-showcase anim-item-4">
            <div class="deal-header-status">
              <span class="deal-status-dot"></span>
              <span>LIVE DEAL: VISAGE</span>
            </div>

            <div class="deal-row best-deal">
              <span>GOG (Best Deal)</span>
              <span class="price-val">$17.49 <span style="font-size: 11px; opacity: 0.6; text-decoration: line-through;">$34.99</span></span>
            </div>

            <div class="deal-row">
              <span style="color: var(--text-sub);">Steam Store</span>
              <span class="price-val">$34.99</span>
            </div>

            <div class="deal-row">
              <span style="color: var(--text-sub);">Humble Store</span>
              <span class="price-val">$34.99</span>
            </div>

            <div class="deal-verify-note">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
              <span>Direct verification gateway protecting clicks & developers.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SCENE 5: COMMUNITY MISSION
         ==================================================================== -->
    <section class="scene" id="scene-5">
      <div class="mission-scene-content">
        <h2 class="hero-headline anim-title" style="font-size: clamp(34px, 5.2vw, 58px);">
          NO ADS.<br />
          <span class="crimson">NO PAYWALLS.</span>
        </h2>
        <p class="hero-sub anim-sub" style="margin-top: 14px; max-width: 640px;">
          Dedicated to every indie creator, modder, bedroom developer, and horror fan keeping the genre alive.
        </p>
      </div>
    </section>

    <!-- ====================================================================
         SCENE 6: FINAL MOVIE TITLE CARD
         ==================================================================== -->
    <section class="scene" id="scene-6">
      <div class="final-movie-card">
        <div class="final-brand-title anim-title">
          <span class="italic">ho</span>GAMEGATA
        </div>
        <div class="final-made-with anim-sub">
          Made with <span class="heart-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="#e50914" stroke="#e50914" stroke-width="1"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg></span> aurostron.
        </div>
        <div class="final-project-url anim-item-1">
          live at gamegata.xyz
        </div>
      </div>
    </section>

  </main>

  <!-- Three.js Library & Custom 3D Atmospheric Engine -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script is:inline src="/promo-assets/three-bg.js"></script>
  <script is:inline src="/promo-assets/script.js"></script>
</body>
</html>
