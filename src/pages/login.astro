---
import LoginPageComponent from '../components/LoginPage';
import '../styles/global.css';
import { CURATED_HORROR_SCREENSHOTS } from '../data/curatedScreenshots';

// Shuffle and select exactly 10 unique screenshots per user session
const screenshots = [...CURATED_HORROR_SCREENSHOTS]
  .sort(() => 0.5 - Math.random())
  .slice(0, 10);
---

<!doctype html>
<html lang="en" class="h-full antialiased font-sans overflow-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" />
    <title>Sign In | hoGAMEGATA</title>
    <meta name="description" content="Sign in to your hoGAMEGATA tracking account." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&family=Hanken+Grotesk:ital,wght@0,400;0,700;0,800;1,900&family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet" />
	</head>
	<body class="h-full w-full bg-black text-white overflow-hidden">
    <LoginPageComponent client:only="react" screenshots={screenshots} />
	</body>
</html>
