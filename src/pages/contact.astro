---
import Layout from '../layouts/Layout.astro';
import ReturnButton from '../components/ReturnButton';
---

<Layout 
  title="Contact Us | hoGAMEGATA" 
  description="Get in touch with the hoGAMEGATA team. Report bugs, suggest database entries, or send general inquiries." 
  withSearch={false} 
  withLink={true}
>
  <main class="flex-1 flex items-center justify-center p-6 my-12 pb-24">
    <div class="max-w-xl w-full border-4 border-white bg-[#08080a] p-8 md:p-12 shadow-[8px_8px_0px_0px_#ffffff] flex flex-col gap-8 relative overflow-hidden">
      
      <!-- Top nav inside card -->
      <div class="flex justify-between items-center border-b border-white/10 pb-4">
        <div class="flex flex-col">
          <span class="font-mono text-[9px] text-[#ff2a2a] uppercase tracking-widest font-black">Support</span>
          <span class="font-mono text-[8px] text-white/50 uppercase tracking-widest">Get In Touch</span>
        </div>
        <ReturnButton client:only="react" />
      </div>

      <!-- Header Title -->
      <div class="flex flex-col gap-2">
        <h1 class="font-sans font-black text-4xl sm:text-5xl uppercase tracking-tighter leading-none text-[#f3f4f6]">
          CONTACT
        </h1>
        <span class="font-mono text-xs text-white/50 uppercase tracking-widest">
          Wanna say hello or report a bug?
        </span>
      </div>

      <!-- Contact details list -->
      <div class="space-y-6">
        <!-- Email Link -->
        <a
          href="mailto:hello@gamegata.xyz"
          class="group flex items-center gap-4 p-4 border border-white/15 bg-black/40 hover:bg-white hover:text-black hover:border-white transition-all duration-150 rounded-none"
        >
          <div class="p-3 border border-white/20 group-hover:border-black/20 group-hover:bg-black/5">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-[#ff2a2a] group-hover:text-black transition-colors"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div class="flex-grow flex flex-col">
            <span class="font-mono text-[10px] text-white/40 uppercase tracking-wider font-bold group-hover:text-black/60 transition-colors">Say Hello / Inquiries</span>
            <span class="font-sans font-black text-base tracking-tight transition-colors">hello@gamegata.xyz</span>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
        </a>

        <!-- Bluesky Link -->
        <a
          href="https://bsky.app/profile/gamegata.xyz"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 p-4 border border-white/15 bg-black/40 hover:bg-white hover:text-black hover:border-white transition-all duration-150 rounded-none"
        >
          <div class="p-3 border border-white/20 group-hover:border-black/20 group-hover:bg-black/5">
            <svg class="w-5 h-5 text-[#ff2a2a] group-hover:text-black transition-colors" viewBox="0 0 568 501" fill="currentColor">
              <path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.209C491.866-1.611 568-28.906 568 57.094c0 17.164-9.845 144.354-15.632 165.01-20.25 72.26-94.025 90.72-159.273 79.664 114.077 19.344 143.25 87.89 80.373 152.361-119.555 122.585-177.01-30.73-188.751-68.804-1.229-3.985-1.617-5.244-1.717-5.571-.1.327-.488 1.586-1.717 5.571-11.74 38.074-69.196 191.389-188.751 68.804-62.877-64.471-33.704-133.017 80.373-152.361-65.248 11.056-139.023-7.404-159.273-79.664C9.845 198.548 0 74.258 0 57.094 0-28.906 76.134-1.611 123.121 33.664Z"/>
            </svg>
          </div>
          <div class="flex-grow flex flex-col">
            <span class="font-mono text-[10px] text-white/40 uppercase tracking-wider font-bold group-hover:text-black/60 transition-colors">Follow on Bluesky</span>
            <span class="font-sans font-black text-base tracking-tight transition-colors">@gamegata.xyz</span>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
        </a>
      </div>

      <!-- Info warning box -->
      <div class="border border-white/10 p-4 bg-[#0d0d0f] flex gap-3">
        <div class="space-y-1 font-sans text-xs text-gray-400 leading-relaxed">
          <span class="text-white font-bold uppercase block font-mono text-[12px] tracking-wide">Notice</span>
          <p>We try to review all emails and bug reports within 48 hours. If you need urgent contact, please DM @auros.tron on Discord for a faster reply.</p>
          <p>
          <p>•</p>
            If you are a game developer and you need to make corrections OR if your
            game is missing, you can contribute directly at the IGDB website. </p>
            <p>•</p>
            <p>Changes that are done there are automatically synced to hoGAMEGATA.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
