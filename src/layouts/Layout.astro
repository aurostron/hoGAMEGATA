---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InteractiveTutorial from '../components/InteractiveTutorial';
import OnboardingModal from '../components/OnboardingModal';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  withSearch?: boolean;
  withLink?: boolean;
}

const { 
  title = "hoGAMEGATA | Horror Game Discovery Database", 
  description = "A fast, minimal, and premium metadata registry for survival horror, psychological horror, and indie nightmare games.",
  withSearch = false,
  withLink = true
} = Astro.props;
---
<!doctype html>
<html lang="en" class="h-full antialiased font-sans">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="msvalidate.01" content="5F938F573CF16B17C56424DD8B4413438" />
    
    
    <!-- Google Fonts: Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-full flex flex-col bg-background text-foreground selection:bg-white selection:text-black">
    <Header withSearch={withSearch} withLink={withLink} />
    <main class="flex-1 flex flex-col w-full">
      <slot />
    </main>
    <Footer />
    <InteractiveTutorial client:load />
    <OnboardingModal client:load />
	</body>
</html>
