---
import MirrorGateway from '../components/MirrorGateway';
import MirrorBanner from '../components/MirrorBanner';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OnboardingModal from '../components/OnboardingModal';
import BottomNav from '../components/BottomNav';
import RandomWarpOverlay from '../components/RandomWarpOverlay';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  withSearch?: boolean;
  withLink?: boolean;
  ogImage?: string;
  ogType?: string;
  ogUrl?: string;
  statsGames?: number;
  statsDevelopers?: number;
  statsDeals?: number;
  statsTags?: number;
  noIndex?: boolean;
  editGameData?: {
    gameId: string;
    gameTitle: string;
    gameData: any;
  };
}

const canonicalUrl = new URL(Astro.url.pathname, 'https://gamegata.xyz').href;

const { 
  title = "hoGAMEGATA | The Horror Game Database (107,000+ Titles)", 
  description = "Discover 107,000+ horror games, 68,000+ developers, and 430,000+ screenshots. hoGAMEGATA is the definitive open, ad-free metadata registry for survival horror, psychological terror, and indie nightmare games.",
  withSearch = false,
  withLink = true,
  ogImage,
  ogType = "website",
  ogUrl = canonicalUrl,
  noIndex = false,
  editGameData,
} = Astro.props;
---
<!doctype html>
<html lang="en" class="h-full antialiased font-sans overflow-x-clip">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="aurostron" />
    <meta name="creator" content="aurostron" />
    <meta name="keywords" content="aurostron, hoGAMEGATA, GAMEGATA, hGG, hgg, hgg db, gamegata db, gamegata database, horror games database, 107000 horror games, 100k horror games database, 68000 developers, open horror games mega metadata, hogamegata, game gata, survival horror database, horror game discovery, indie horror registry" />
    <meta name="msvalidate.01" content="5F938F573CF16B17C56424DDB4413438" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="hoGAMEGATA" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter / Social Previews -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={ogUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}
    
    <!-- JSON-LD Brand Entity & WebSite Schema -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://gamegata.xyz/#website",
      "name": "hoGAMEGATA",
      "alternateName": [
        "hGG",
        "hgg",
        "hgg db",
        "gamegata db",
        "gamegata database",
        "gamegata",
        "hogamegata",
        "open horror games mega metadata"
      ],
      "url": "https://gamegata.xyz",
      "description": "An open, minimalist, ad-free horror game metadata database built by solo developer aurostron, cataloging over 107,000 titles and 68,000+ developers.",
      "author": {
        "@type": "Person",
        "name": "aurostron",
        "jobTitle": "Solo Developer & Creator",
        "url": "https://gamegata.xyz/about"
      },
      "creator": {
        "@type": "Person",
        "name": "aurostron"
      },
      "publisher": {
        "@type": "Organization",
        "@id": "https://gamegata.xyz/#organization",
        "name": "hoGAMEGATA",
        "alternateName": ["hGG", "gamegata db", "hogamegata"],
        "url": "https://gamegata.xyz",
        "logo": "https://gamegata.xyz/icons/icon-512x512.png"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://gamegata.xyz/games?search={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "DataCatalog",
      "@id": "https://gamegata.xyz/#datacatalog",
      "name": "hoGAMEGATA Horror Game Metadata Index",
      "description": "Comprehensive open metadata catalog indexing 107,800+ horror games, 68,000+ developers, 15,800+ sub-genre tags, created by solo developer aurostron.",
      "url": "https://gamegata.xyz",
      "author": {
        "@type": "Person",
        "name": "aurostron"
      },
      "provider": {
        "@type": "Organization",
        "@id": "https://gamegata.xyz/#organization"
      },
      "dataset": {
        "@type": "Dataset",
        "name": "Global Horror Games Video Game Registry",
        "description": "Historical and contemporary horror video game catalog from classic 1980s-2000s titles to modern indie releases and upcoming AAA nightmares.",
        "size": "107,800+ records"
      }
    })} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://gamegata.xyz/#organization",
      "name": "hoGAMEGATA",
      "alternateName": ["hGG", "hgg", "hgg db", "gamegata db", "gamegata database", "hogamegata"],
      "url": "https://gamegata.xyz",
      "logo": "https://gamegata.xyz/icons/icon-512x512.png",
      "description": "The open horror game discovery database preserving metadata for 107,000+ survival horror, psychological terror, and indie nightmare games.",
      "founder": {
        "@type": "Person",
        "name": "aurostron",
        "jobTitle": "Solo Developer"
      }
    })} />

    
    
    <!-- PWA Support -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0d0d0f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="hoGAMEGATA" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512x512.png" />

    <!-- Google Fonts: Geist Sans, Geist Mono, Hanken Grotesk, & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&family=Hanken+Grotesk:ital,wght@0,400;0,700;0,800;1,900&family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-full w-full max-w-full overflow-x-clip flex flex-col bg-background text-foreground selection:bg-white selection:text-black relative">
    <MirrorGateway client:only="react" />
    <MirrorBanner client:only="react" />
    <Header withSearch={withSearch} withLink={withLink} editGameData={editGameData} />
    <div class="flex-1 flex flex-col w-full max-w-full min-w-0 overflow-x-clip pb-28 md:pb-8">
      <slot />
    </div>
    <Footer />
    <BottomNav client:only="react" />
    <RandomWarpOverlay client:only="react" />
    <OnboardingModal client:only="react" />

    <!-- Register PWA Service Worker -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.error('ServiceWorker registration failed: ', err);
          });
        });
      }
    </script>

    <!-- Global Rate Limit & Lockout Cleanup -->
    <script is:inline>
      (function cleanupRateLimitLockout() {
        try {
          sessionStorage.removeItem('api_rate_limit_lockout');
          document.cookie = "api_rate_limit_lockout=; max-age=0; path=/; SameSite=Lax";
          const existingOverlay = document.getElementById('full-tab-rate-limit-overlay');
          if (existingOverlay) existingOverlay.remove();
          if (document.body) document.body.style.overflow = '';
        } catch (e) {}

        const originalFetch = window.fetch;
        if (typeof originalFetch === 'function') {
          window.fetch = async function(...args) {
            const response = await originalFetch.apply(this, args);
            try {
              if (response.status === 429) {
                console.warn('[RateLimit] API request throttled:', args[0]);
              }
            } catch (e) {}
            return response;
          };
        }
      })();
    </script>
	</body>
</html>
