---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OnboardingModal from '../components/OnboardingModal';
import '../styles/global.css';
import { count } from 'drizzle-orm';
import { turso } from '../lib/turso';
import { games, developers, priceSnapshots, tags } from '../db/schema';

interface Props {
  title?: string;
  description?: string;
  withSearch?: boolean;
  withLink?: boolean;
  ogImage?: string;
  ogType?: string;
  ogUrl?: string;
  statsGames?: number;
  statsDevelopers?: number;
  statsDeals?: number;
  statsTags?: number;
}

const canonicalUrl = new URL(Astro.url.pathname, 'https://gamegata.xyz').href;

const { 
  title = "hoGAMEGATA | Horror Games Mega Metadata", 
  description = "A fast, minimal, and premium metadata registry for survival horror, psychological horror, and indie nightmare games.",
  withSearch = false,
  withLink = true,
  ogImage,
  ogType = "website",
  ogUrl = canonicalUrl,
  statsGames,
  statsDevelopers,
  statsDeals,
  statsTags,
} = Astro.props;

const isHomepage = Astro.url.pathname === "/";

let sGames = isHomepage ? statsGames : undefined;
let sDevs = isHomepage ? statsDevelopers : undefined;
let sDeals = isHomepage ? statsDeals : undefined;
let sTags = isHomepage ? statsTags : undefined;

if (isHomepage && (sGames === undefined || sDevs === undefined || sDeals === undefined || sTags === undefined)) {
  try {
    const [
      [{ count: gCount }],
      [{ count: dCount }],
      [{ count: tCount }],
      [{ count: dlCount }],
    ] = await Promise.all([
      turso.select({ count: count() }).from(games),
      turso.select({ count: count() }).from(developers),
      turso.select({ count: count() }).from(tags),
      turso.select({ count: count() }).from(priceSnapshots),
    ]);
    sGames = gCount;
    sDevs = dCount;
    sTags = tCount;
    sDeals = dlCount;
  } catch (err) {
    console.error("Failed to query global header statistics in Layout.astro:", err);
  }
}
---
<!doctype html>
<html lang="en" class="h-full antialiased font-sans">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="msvalidate.01" content="5F938F573CF16B17C56424DDB4413438" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={ogUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}
    
    
    <!-- Google Fonts: Geist Sans, Geist Mono, & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-full flex flex-col bg-background text-foreground selection:bg-white selection:text-black">
    <Header withSearch={withSearch} withLink={withLink} statsGames={sGames} statsDevelopers={sDevs} statsDeals={sDeals} statsTags={sTags} />
    <div class="flex-1 flex flex-col w-full">
      <slot />
    </div>
    <Footer />
    <OnboardingModal client:only="react" />
	</body>
</html>
