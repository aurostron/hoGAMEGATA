---
import '../styles/global.css';

interface Props {
  title: string;
  activeTab?: string;
}

const { title, activeTab = 'dashboard' } = Astro.props;

// Mock session user email for header (or load via session in future)
const userEmail = "bapum@example.com";
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | GameGata Admin Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        background-color: #030305;
        font-family: 'Outfit', sans-serif;
      }
      .glow-border {
        border-color: rgba(255, 42, 42, 0.1);
      }
      .glow-border:hover {
        border-color: rgba(255, 42, 42, 0.4);
        box-shadow: 0 0 15px rgba(255, 42, 42, 0.1);
      }
      .nav-link.active {
        background-color: rgba(255, 42, 42, 0.1);
        border-left: 3px solid #ff2a2a;
        color: #ffffff;
      }
    </style>
  </head>
  <body class="text-gray-200 min-h-screen flex flex-col">
    <!-- Top Header -->
    <header class="h-16 border-b border-[#1a1a24] bg-[#07070a] px-4 sm:px-6 flex items-center justify-between sticky top-0 z-40">
      <div class="flex items-center space-x-3">
        <!-- Hamburger Menu Button -->
        <button id="mobile-nav-toggle" class="md:hidden p-1 text-gray-400 hover:text-white hover:bg-[#121217] rounded focus:outline-none cursor-pointer" aria-label="Toggle navigation menu">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <span class="text-xl sm:text-2xl font-black tracking-tight text-white uppercase font-heading flex items-center">
          GAME<span class="text-[#ff2a2a] glow-text">GATA</span>
          <span class="hidden sm:inline-block text-[9px] font-mono font-normal tracking-normal lowercase border border-[#ff2a2a] px-2 py-0.5 ml-2 text-[#ff2a2a] bg-[#ff2a2a]/10 rounded-full">admin ops</span>
        </span>
      </div>
      
      <div class="flex items-center space-x-3 sm:space-x-4">
        <div class="text-right hidden sm:block">
          <p class="text-xs text-gray-400 font-mono">Logged in as</p>
          <p class="text-sm font-semibold text-white">{userEmail}</p>
        </div>
        <div class="h-8 w-8 rounded-full bg-[#ff2a2a]/20 border border-[#ff2a2a]/40 flex items-center justify-center font-bold text-sm text-[#ff2a2a] uppercase select-none">
          {userEmail[0]}
        </div>
        <a href="/api/auth/logout" class="text-xs font-semibold px-2.5 py-1.5 border border-[#1a1a24] rounded-md hover:bg-white hover:text-black transition duration-200">
          Sign Out
        </a>
      </div>
    </header>

    <div class="flex flex-1 overflow-hidden relative">
      <!-- Sidebar Overlay -->
      <div id="sidebar-overlay" class="fixed inset-0 bg-black/75 z-40 hidden transition-opacity duration-300 opacity-0 md:hidden"></div>

      <!-- Sidebar Nav -->
      <aside id="admin-sidebar" class="fixed inset-y-0 left-0 z-50 w-64 border-r border-[#1a1a24] bg-[#07070a] flex flex-col shrink-0 transform -translate-x-full transition-transform duration-300 md:relative md:translate-x-0 md:bg-[#07070a]/50">
        <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
          <p class="text-[10px] uppercase font-mono tracking-widest text-gray-500 px-3 mb-2 font-bold">Management</p>
          
          <a href="/admin" class={`nav-link flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium text-gray-400 hover:text-white hover:bg-[#121217] transition duration-150 ${activeTab === 'dashboard' ? 'active' : ''}`}>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2v-4zM14 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2v-4z" />
            </svg>
            <span>Dashboard</span>
          </a>

          <a href="/admin/content" class={`nav-link flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium text-gray-400 hover:text-white hover:bg-[#121217] transition duration-150 ${activeTab === 'content' ? 'active' : ''}`}>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Page Content</span>
          </a>

          <a href="/admin/games" class={`nav-link flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium text-gray-400 hover:text-white hover:bg-[#121217] transition duration-150 ${activeTab === 'games' ? 'active' : ''}`}>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span>Game Catalog</span>
          </a>

          <a href="/admin/ai" class={`nav-link flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium text-gray-400 hover:text-white hover:bg-[#121217] transition duration-150 ${activeTab === 'ai' ? 'active' : ''}`}>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
            <span>AI Scare Meter</span>
          </a>

          <a href="/admin/imports" class={`nav-link flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium text-gray-400 hover:text-white hover:bg-[#121217] transition duration-150 ${activeTab === 'imports' ? 'active' : ''}`}>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" />
            </svg>
            <span>Import Center</span>
          </a>

          <div class="pt-6">
            <p class="text-[10px] uppercase font-mono tracking-widest text-gray-500 px-3 mb-2 font-bold">System</p>
            <a href="/admin/health" class={`nav-link flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium text-gray-400 hover:text-white hover:bg-[#121217] transition duration-150 ${activeTab === 'health' ? 'active' : ''}`}>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>System Health</span>
            </a>
          </div>
        </nav>
        
        <div class="p-4 border-t border-[#1a1a24] bg-[#07070a]/80 text-center shrink-0">
          <p class="text-[10px] text-gray-500 font-mono">GameGata v1.0.0 (Turso Hybrid)</p>
        </div>
      </aside>

      <!-- Main Content Panel -->
      <main class="flex-1 overflow-y-auto p-4 sm:p-8 bg-[#0a0a0f] relative">
        <div class="max-w-5xl mx-auto space-y-6">
          <slot />
        </div>
      </main>
    </div>

    <script>
      const toggleBtn = document.getElementById('mobile-nav-toggle');
      const sidebar = document.getElementById('admin-sidebar');
      const overlay = document.getElementById('sidebar-overlay');

      if (toggleBtn && sidebar && overlay) {
        const openMenu = () => {
          sidebar.classList.remove('-translate-x-full');
          sidebar.classList.add('translate-x-0');
          overlay.classList.remove('hidden');
          setTimeout(() => {
            overlay.classList.remove('opacity-0');
            overlay.classList.add('opacity-100');
          }, 10);
        };

        const closeMenu = () => {
          sidebar.classList.remove('translate-x-0');
          sidebar.classList.add('-translate-x-full');
          overlay.classList.remove('opacity-100');
          overlay.classList.add('opacity-0');
          setTimeout(() => {
            overlay.classList.add('hidden');
          }, 300);
        };

        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = sidebar.classList.contains('translate-x-0');
          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        });

        overlay.addEventListener('click', closeMenu);

        // Auto-close menu when clicking a link (on mobile)
        sidebar.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            if (window.innerWidth < 768) {
              closeMenu();
            }
          });
        });
      }
    </script>
  </body>
</html>
