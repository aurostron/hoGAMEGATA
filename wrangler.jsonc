{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-23",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "hogamegata",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"vars": {},
	"kv_namespaces": [
		{
			"binding": "MAINTENANCE",
			"id": "placeholder-maintenance-kv"
		},
		{
			"binding": "RATE_LIMIT",
			"id": "placeholder-rate-limit-kv"
		}
	],
	"observability": {
		"enabled": true
	}
}