{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamegata",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2025-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
